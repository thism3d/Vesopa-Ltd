<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tap to Pay on iPhone (Dojo SDK). Apple grants it to the developer
	     account on request; until it is granted, signing fails with this key:
	     see docs/PLAN.md, phase 0. -->
	<key>com.apple.developer.proximity-reader.payment.acceptance</key>
	<true/>
	<!-- Staff cards and fobs (ISO 14443 tags, read by id only). -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
