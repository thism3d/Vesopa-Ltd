<%#
  Latest from the blog.
  Fed by the /  route in src/routes/pages.js. The whole block is skipped when
  nothing is published, so the home page never carries an empty "News" heading
  with three blank cards under it — which is what a section like this looks
  like on the day a site launches.
%>
<% if (typeof latestPosts !== 'undefined' && latestPosts.length) { %>
<div class="home_blog">
    <div class="home_blog_inside">
        <div class="home_blog_head">
            <div>
                <h2 class="home_blog_heading">Latest from Vesopa<span>.</span></h2>
                <p class="home_blog_sub">Product updates, release notes and guides for running a busy till.</p>
            </div>
            <a class="home_blog_all" href="/blog">All posts &rarr;</a>
        </div>

        <div class="bl-grid home_blog_grid">
<% latestPosts.forEach(function (p) { %>
            <article class="bl-card">
                <a class="bl-card-link" href="/blog/<%= p.slug %>">
<% if (p.cover_url) { %>
                    <div class="bl-card-media">
                        <img src="<%= p.cover_url %>" alt="" loading="lazy">
                    </div>
<% } %>
                    <div class="bl-card-body">
                        <p class="bl-card-meta">
                            <span class="bl-chip <%= p.kind === 'update' ? 'is-update' : '' %>">
                                <%= p.kind === 'update' ? 'Update' : 'Article' %>
                            </span>
                            <time datetime="<%= isoDateTime(p.published_at) %>"><%= formatDate(p.published_at) %></time>
                        </p>
                        <h3 class="bl-card-title"><%= p.title %></h3>
                        <p class="bl-card-excerpt"><%= p.excerpt %></p>
                    </div>
                </a>
            </article>
<% }); %>
        </div>
    </div>
</div>
<% } %>


