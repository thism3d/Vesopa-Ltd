<script>
    // Tab switching. Plain buttons with aria-selected rather than a widget
    // library: the panels are all in the DOM already, so this is a visibility
    // toggle and screen readers get the state for free.
    (function () {
        const tabs = Array.from(document.querySelectorAll('.vf-tab'));

        function select(tab) {
            tabs.forEach(function (t) {
                const on = t === tab;
                t.setAttribute('aria-selected', String(on));
                document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
            });
        }

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () { select(tab); });

            // Left/right arrows move between tabs, which is what a keyboard user
            // expects from a tablist and what the role promises them.
            tab.addEventListener('keydown', function (e) {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                e.preventDefault();
                const step = e.key === 'ArrowRight' ? 1 : -1;
                const next = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
                select(next);
                next.focus();
            });
        });
    })();
</script>
