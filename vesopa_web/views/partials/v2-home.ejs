<%#
  October 2026 additions to the home page: card payments and cashback, online
  ordering (live at menu.pontardawerfc.com), rewards and white-label member
  apps, and the hardware teaser. Placed after "From the counter to the pass";
  nothing above or below was changed.
%>
<section class="v2-sec" id="payments" aria-labelledby="v2-pay-title">
    <div class="v2-wrap v2-row">
        <div>
            <p class="vh-eyebrow">Card payments</p>
            <h2 id="v2-pay-title" class="v2-title">The till sends the amount. <span>The bill closes itself.</span></h2>
            <p class="v2-lede">No typing the total into the card machine twice. Vesopa EPOS drives Dojo, Teya and Barclaycard machines from the pay screen, takes tips, splits bills and refunds to the card.</p>
            <ul class="v2-ticks">
                <li>Dojo, Teya or Barclaycard, chosen per till in the back office</li>
                <li>Cashback on the card machine, with the drawer opening for the cash</li>
                <li>Split bills by item or by share; the drawer opens after each cash share</li>
                <li>Refunds back to the card from the receipt, tips kept per member of staff</li>
            </ul>
        </div>
        <div class="v2-panel" data-v2-cashback>
            <h3>Cashback at the till</h3>
            <p class="v2-note" style="margin:8px 0 0">A £8.60 bill. How much cashback?</p>
            <div class="v2-chips" role="group" aria-label="Cashback amount">
                <button type="button" class="v2-chip" data-amount="1000" aria-pressed="false">£10</button>
                <button type="button" class="v2-chip" data-amount="2000" aria-pressed="true">£20</button>
                <button type="button" class="v2-chip" data-amount="3000" aria-pressed="false">£30</button>
                <button type="button" class="v2-chip" data-amount="5000" aria-pressed="false">£50</button>
            </div>
            <div class="v2-sum" aria-live="polite">
                <div><span>Sale</span><span>£8.60</span></div>
                <div><span>Cashback</span><span data-v2-cash>£20.00</span></div>
                <div class="tot"><span>Customer approves on the card machine</span><b data-v2-total>£28.60</b></div>
            </div>
            <div class="v2-hand"><strong>Hand over <span data-v2-cash>£20.00</span></strong>The drawer opens by itself and the Z report counts it.</div>
        </div>
    </div>
</section>

<section class="v2-sec alt" id="online-ordering" aria-labelledby="v2-order-title">
    <div class="v2-wrap v2-row rev">
        <div class="v2-phones">
            <div class="v2-phone"><img src="/assets/v2/menu-home.jpg" width="375" height="812" loading="lazy" decoding="async" alt="menu.pontardawerfc.com: the club's own branded menu on a phone"></div>
            <div class="v2-phone"><img src="/assets/v2/menu-tables.jpg" width="375" height="812" loading="lazy" decoding="async" alt="Choosing a table from the live table plan, B1 to B15"></div>
        </div>
        <div>
            <p class="vh-eyebrow">Live at Pontardawe RFC</p>
            <h2 id="v2-order-title" class="v2-title">Order and pay from the table. <span>In your own colours.</span></h2>
            <p class="v2-lede">Customers scan the QR on the table, pick from the menu and pay on their phone. The order lands on the till and the kitchen screen before they put the phone down.</p>
            <div class="v2-cards">
                <div class="v2-mini"><b>Table QR codes</b><span>Each table has its own code; the order joins that table's bill.</span></div>
                <div class="v2-mini"><b>Live table plan</b><span>Customers see which tables are free: Bar, Lounge, Outside, Rugby Club.</span></div>
                <div class="v2-mini"><b>Apple Pay &amp; Google Pay</b><span>Paid on the phone through Dojo, Teya or Barclaycard. No card numbers stored.</span></div>
                <div class="v2-mini"><b>Straight to the kitchen</b><span>Tickets print or appear on the kitchen screen the moment it is paid.</span></div>
            </div>
            <div class="v2-actions">
                <a class="v2-btn" href="https://menu.pontardawerfc.com" target="_blank" rel="noopener">See menu.pontardawerfc.com</a>
                <span class="v2-note">Your menu on your own address, switched on from the back office</span>
            </div>
        </div>
    </div>
</section>

<section class="v2-sec" id="member-apps" aria-labelledby="v2-apps-title">
    <div class="v2-wrap v2-row">
        <div>
            <p class="vh-eyebrow">Rewards &amp; white-label apps</p>
            <h2 id="v2-apps-title" class="v2-title">Your name on the App Store. <span>Your members in their pockets.</span></h2>
            <p class="v2-lede">We build and publish your own app for iPhone, Android and Apple Watch, with a member card in Apple and Google Wallet. Points land on the bill at the till and pay off the exact price of anything on the menu.</p>
            <div class="v2-cards">
                <div class="v2-mini"><b>Points to the penny</b><span>Kept to five decimal places, so a redemption clears the exact price and leaves the rest on the card.</span></div>
                <div class="v2-mini"><b>Wallet cards</b><span>The member card in Apple and Google Wallet, scanned at the till, in the club's crest and colours.</span></div>
                <div class="v2-mini"><b>Memberships</b><span>Tiers paid online and shown on the card, renewals reminded by push.</span></div>
                <div class="v2-mini"><b>News &amp; offers</b><span>Club news and match-day offers straight to members' phones.</span></div>
            </div>
        </div>
        <div class="v2-phones">
            <div class="v2-phone"><img src="/assets/v2/app-card.jpg" width="1000" height="2173" loading="lazy" decoding="async" alt="Pontardawe RFC member card in the club's own app"></div>
            <div class="v2-phone"><img src="/assets/v2/app-news.jpg" width="1000" height="2173" loading="lazy" decoding="async" alt="Club news in the Pontardawe RFC app"></div>
        </div>
    </div>
</section>

<section class="v2-sec alt" id="hardware-teaser" aria-labelledby="v2-hw-title">
    <div class="v2-wrap">
        <div class="v2-head">
            <div>
                <p class="vh-eyebrow">Hardware</p>
                <h2 id="v2-hw-title" class="v2-title">The kit behind the counter, <span>ready to trade.</span></h2>
            </div>
            <a class="v2-btn" href="/hardware">Shop all hardware</a>
        </div>
        <div class="v2-kit">
            <% hardware.TEASER.forEach(function (sku) { const p = hardware.PRODUCTS.find(function (x) { return x.sku === sku; }); if (!p) return; %>
            <a class="v2-item" href="/hardware#<%= p.sku %>">
                <div class="ph"><img src="<%= p.img %>" loading="lazy" decoding="async" alt="<%= p.name %>"></div>
                <div class="bd">
                    <span class="v2-stock <%= p.stock === 'in' ? 'in' : 'lead' %>"><%= p.stock === 'in' ? 'In stock' : 'Ships in 7-10 days' %></span>
                    <h3><%= p.name %></h3>
                    <span class="sku"><%= p.sku %> · <%= p.short %></span>
                    <span class="pr"><%= hardware.gbp(p.price) %> <small>ex VAT</small></span>
                </div>
            </a>
            <% }); %>
        </div>
    </div>
</section>
<script src="/library/v2.js" defer></script>
