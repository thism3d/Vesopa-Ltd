<!DOCTYPE html>
<html lang="en">
	<head>

		<title><%= title %></title>


		<!-- Personal Properties -->
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, minimum-scale=1, user-scalable=no, shrink-to-fit=no" />

        <%#
          Every page used to advertise itself as the home page: one hardcoded
          description, one og:url pointing at the site root, one og:title. A
          blog post shared to LinkedIn came out as "VESOPA | Epos Wales" with
          the shop's address underneath it.

          Pages can now pass `description`, `ogImage` and `ogUrl`; anything that
          does not falls back to exactly what was there before, so the marketing
          pages are unchanged.
        %>
        <%
          const metaDescription = typeof description !== 'undefined' && description
            ? description
            : 'Your trusted EPOS partner in Pontardawe, Wales. Streamline transactions and enhance customer experiences with tailored solutions for Hospitality & Retail.';
          const metaImage = typeof ogImage !== 'undefined' && ogImage
            ? (ogImage.startsWith('http') ? ogImage : SITE_URL + ogImage)
            : SITE_URL + '/assets/app/preview.jpg';
          const metaUrl = typeof ogUrl !== 'undefined' && ogUrl ? SITE_URL + ogUrl : SITE_URL;
          const metaImageAlt = typeof ogImageAlt !== 'undefined' && ogImageAlt
            ? ogImageAlt
            : 'Vesopa EPOS running on a till';
          const metaImageType = /\.png(\?|$)/i.test(metaImage) ? 'image/png' : 'image/jpeg';
          // Shares get the short name. The <title> carries the shop address for
          // local search, which reads as noise in a WhatsApp bubble.
          const metaTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : title;
        %>
        <meta name="description" content="<%= metaDescription %>"/>
        <link rel="canonical" href="<%= metaUrl %>"/>

        <%#
          WhatsApp is the strict one and the reason several of these exist.

          It reads og:* only — it ignores twitter:* and it ignores <meta name>
          entirely, so og:image has to be `property`, absolute, and served from
          a host its own servers can reach. It also wants a real content type
          and a size it can decide to fetch before downloading, which is what
          og:image:type and the width/height pair are for; without them it often
          shows the text card with no thumbnail at all.

          og:image:secure_url is the https duplicate WhatsApp and older
          Facebook crawlers look for specifically.
        %>
        <meta property="og:title" content="<%= metaTitle %>"/>
        <meta property="og:description" content="<%= metaDescription %>"/>
        <meta property="og:url" content="<%= metaUrl %>"/>
        <meta property="og:site_name" content="Vesopa EPOS"/>
        <meta property="og:locale" content="en_GB"/>
        <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>"/>
        <meta property="og:image" content="<%= metaImage %>"/>
<% if (metaImage.startsWith('https://')) { %>
        <meta property="og:image:secure_url" content="<%= metaImage %>"/>
<% } %>
        <meta property="og:image:type" content="<%= metaImageType %>"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
        <meta property="og:image:alt" content="<%= metaImageAlt %>"/>

        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content="<%= metaTitle %>"/>
        <meta name="twitter:description" content="<%= metaDescription %>"/>
        <meta name="twitter:image" content="<%= metaImage %>"/>
        <meta name="twitter:image:alt" content="<%= metaImageAlt %>"/>

        <!-- PWA Code -->
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="<%= BRAND.theme_color %>">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <link rel="apple-touch-icon" href="/favicon.png">
        <link rel="apple-touch-startup-image" href="/assets/logo/vesopa_logo_monochrome.png">


        <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js');
            });
        }
        </script>
        <script type="module" src="/script.js"></script>

        <!-- Place favicon.ico in the root directory -->
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
		<link rel="icon" href="/assets/logo/logo.png">

		<!-- Font Awesome Link -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


		<!-- Layout, then the 2025 brand theme on top of it. brand.css must load
		     last: it overrides colour and type only, and relies on source order
		     rather than !important to win. -->
		<link rel="stylesheet" href="/library/main0.1.0.css?v=<%= APP_VERSION %>">
		<link rel="stylesheet" href="/library/brand.css?v=<%= APP_VERSION %>">



		<!-- jQuery 3.5.1 -->
		<script src="/library/jquery.min.js"></script>




        <!-- Owl Carousel Slider -->
        <link rel="stylesheet" href="/library/owlcarousel/owl.carousel.min.css">
        <link rel="stylesheet" href="/library/owlcarousel/owl.theme.default.min.css">
        <script src="/library/owlcarousel/owl.carousel.min.js"></script>

	</head>

	<body>


        <div id="mobile_menu" class="header_mobile_menu">
            <div class="header_mobile_menu_top">
                <div class="header_mobile_heading">
                    <img class="header_left_img" src="/assets/logo/vesopa_logo_on_dark.png" alt="Vesopa EPOS">
                    <a onclick="toogle_mobile_menu()" class="menu_mobile_button"><i class="fa fa-remove"></i></a>
                </div>

                <div class="header_mobile_menus">
                    <a class="menu_item_desktop" href="/pricing">Pricing</a>
                    <a class="menu_item_desktop" href="/download">Download</a>
                    <a class="menu_item_desktop" href="/blog">Blog</a>
                    <a class="menu_item_desktop" href="/help">Help</a>
                </div>
            </div>
            <div class="header_mobile_menu_bottom">
                <a class="menu_get_button mobile_login_button" href="<%= accountUrl %>"><%= accountLabel %></a>
                <a class="menu_get_button" onclick="toogle_mobile_menu()" href="/#try-vesopa">Try VesopaEPOS</a>
            </div>

        </div>


        <div class="header">
            <div class="header_inside">
                <div class="header_left">
                    <div class="header_left_img_keeper">
                        <a href="/"><img class="header_left_img desktop_menu_icon" src="/assets/logo/vesopa_logo_on_dark.png" alt="Vesopa EPOS"></a>
                        <a href="/"><img class="header_left_img mobile_menu_icon" src="/assets/logo/logo.png" alt="Vesopa EPOS"></a>
                    </div>
                    <div class="header_right_menu">
                        <a class="menu_item_desktop" href="/pricing">Pricing</a>
                        <a class="menu_item_desktop" href="/download">Download</a>
                        <a class="menu_item_desktop" href="/blog">Blog</a>
                        <a class="menu_item_desktop" href="/help">Help</a>
                    </div>
                </div>

                <div class="header_right">
                    <a class="menu_item_desktop login_button" href="<%= accountUrl %>"><%= accountLabel %></a>
                    <a class="menu_get_button" href="/#try-vesopa">Try VesopaEPOS</a>
                    <a onclick="toogle_mobile_menu()" class="menu_mobile_button"><i class="fa fa-bars"></i></a>
                </div>
            </div>
        </div>


        <script>
            const mobile_menu = document.getElementById("mobile_menu");

            function toogle_mobile_menu(){
                if(mobile_menu.className == "header_mobile_menu"){
                    mobile_menu.className = "header_mobile_menu header_mobile_menu_show";
                }else mobile_menu.className = "header_mobile_menu";
            }
        </script>
