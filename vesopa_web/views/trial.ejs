<%- include('partials/header') %>
<%#
  Try Vesopa EPOS (2026-10-24): an interactive three-step start, never an
  enquiry form. 1 pick a plan, 2 extras, 3 venue + email, then Dojo's hosted
  checkout for a £1 card check. The trial switches itself on the moment Dojo
  has the £1 (return page, Dojo's webhook, or the 5-minute sweep), and the £1
  is refunded straight away. Without JS the three steps show as one form.
  The server re-prices everything on submit; the browser total is a preview.
%>
<section class="hw-hero tr-hero">
    <div class="v2-wrap" style="text-align:center">
        <p class="vh-eyebrow">14 days free</p>
        <h1 class="v2-title" style="font-size:clamp(28px,5vw,56px)">Try Vesopa EPOS <span class="tr-swap" data-tr-swap data-words='["free for 14 days.","on your own till.","with card payments.","in three taps."]'>free for 14 days.</span></h1>
        <p class="v2-lede" style="margin-left:auto;margin-right:auto">A £1 card check that comes straight back, then nothing to pay until your trial ends. 30-day money-back guarantee.</p>
    </div>
</section>

<section class="v2-sec" style="padding-top:40px">
    <form class="v2-wrap tr-flow" method="post" action="/trial" data-trial novalidate>
        <% if (error) { %><p role="alert" class="tr-alert bad"><%= error %></p><% } %>
        <% if (!ready) { %><p class="tr-alert warn">Online sign-up opens very soon. In the meantime, <a href="/#try-vesopa">ask for a demo</a> and we will set you up.</p><% } %>

        <ol class="tr-progress" aria-label="Steps">
            <li data-tr-dot="1" class="on"><span>1</span>Plan</li>
            <li data-tr-dot="2"><span>2</span>Extras</li>
            <li data-tr-dot="3"><span>3</span>Start</li>
        </ol>
        <div class="tr-bar" aria-hidden="true"><i data-tr-bar></i></div>

        <div class="tr-grid">
            <div class="tr-steps">
                <fieldset class="tr-step on" data-tr-step="1">
                    <legend class="v2-title tr-q">Which plan suits you?</legend>
                    <div class="tr-plans">
                        <% plans.forEach(function (p) { const months = Number(p.period_months || p.period); %>
                        <label class="tr-plan">
                            <input type="radio" name="period" value="<%= p.period %>" <%= String(p.period) === String(period) ? 'checked' : '' %> data-price="<%= Math.round(p.discounted_price * 100) %>" data-months="<%= months %>" data-name="<%= String(p.name).replace(/\s*plan$/i, '') %>">
                            <span class="tr-plan-in">
                                <% if (p.is_popular) { %><em class="tr-pop">Most popular</em><% } %>
                                <b><%= String(p.name).replace(/\s*plan$/i, '') %></b>
                                <strong>£<%= p.price_per_month %><small>/mo</small></strong>
                                <span><%= gbp(Math.round(p.discounted_price * 100)) %> for <%= months === 1 ? 'the first month' : 'the first ' + months + ' months' %><% if (p.save_percentage) { %> · save <%= p.save_percentage %>%<% } %></span>
                            </span>
                        </label>
                        <% }); %>
                    </div>
                    <p class="v2-note">Every plan: one till, one customer display, the back office and support.</p>
                </fieldset>

                <fieldset class="tr-step" data-tr-step="2">
                    <legend class="v2-title tr-q">Anything extra? <small>£15/month each</small></legend>
                    <% Object.keys(addons).forEach(function (k) { const a = addons[k]; %>
                    <div class="tr-addon">
                        <div><b><%= a.name %></b><span class="v2-note"><%= k === 'display' ? 'Your first customer display is included' : k === 'kitchen' ? 'Orders on a screen in the kitchen' : 'Another till at the same venue' %></span></div>
                        <div class="hw-qty">
                            <button type="button" data-tr-q="-1" aria-label="Fewer <%= a.name %>">−</button>
                            <input type="number" min="0" max="20" name="addons[<%= k %>]" value="<%= (form.addons && form.addons[k]) || 0 %>" data-addon="<%= a.monthly_minor %>" data-label="<%= a.name %>" aria-label="<%= a.name %>" inputmode="numeric">
                            <button type="button" class="add" data-tr-q="1" aria-label="More <%= a.name %>">+</button>
                        </div>
                    </div>
                    <% }); %>
                </fieldset>

                <fieldset class="tr-step" data-tr-step="3">
                    <legend class="v2-title tr-q">Where shall we set it up?</legend>
                    <label class="tr-field">Venue name<input type="text" name="venue" value="<%= form.venue || '' %>" placeholder="The Red Lion" required autocomplete="organization"></label>
                    <label class="tr-field">Your email<input type="email" name="email" value="<%= form.email || '' %>" placeholder="you@venue.co.uk" required autocomplete="email" inputmode="email"></label>
                    <details class="tr-more"><summary>Add your name and phone (optional)</summary>
                        <label class="tr-field">Your name<input type="text" name="name" value="<%= form.name || '' %>" autocomplete="name"></label>
                        <label class="tr-field">Phone<input type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel" inputmode="tel"></label>
                    </details>
                    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="tr-hp">
                </fieldset>

                <div class="tr-nav">
                    <button type="button" class="v2-btn ghost" data-tr-back hidden>Back</button>
                    <button type="button" class="v2-btn" data-tr-next>Next</button>
                    <button type="submit" class="v2-btn tr-pay" data-tr-submit <%= ready ? '' : 'disabled' %>>Pay £1 &amp; start my trial</button>
                </div>
            </div>

            <aside class="tr-sum" aria-label="Summary" aria-live="polite">
                <h2>Your trial</h2>
                <ul class="hw-lines" data-t-lines>
                    <% if (q) q.first.lines.forEach(function (l) { %><li><span><%= l.label %></span><b><%= gbp(l.minor) %></b></li><% }); %>
                </ul>
                <div class="hw-tot">
                    <div><span>VAT (20%)</span><span data-t-vat><%= q ? gbp(q.first.vat) : '' %></span></div>
                    <div class="big"><span>Today</span><b>£1.00</b></div>
                    <div><span>Refunded straight away</span><span>−£1.00</span></div>
                    <div class="after"><span>After <%= trialDays %> days</span><span data-t-total><%= q ? gbp(q.first.total) : '' %></span></div>
                </div>
                <p class="v2-accredit-cards" style="margin-top:16px" aria-label="Cards and wallets accepted"><img src="/assets/v2/logos/visa.svg" alt="Visa" width="46" height="28"><img src="/assets/v2/logos/mastercard.svg" alt="Mastercard" width="46" height="28"><img src="/assets/v2/logos/apple-pay.svg" alt="Apple Pay" width="46" height="28"><img src="/assets/v2/logos/google-pay.svg" alt="Google Pay" width="46" height="28"></p>
                <p class="tr-safe">Paid on Dojo's secure page: card, Apple Pay or Google Pay. We never see your card number. Your trial starts the moment the £1 goes through.</p>
            </aside>
        </div>
    </form>
</section>
<script>
(function () {
  var f = document.querySelector('[data-trial]'); if (!f) return;
  var SETUP = <%= setupFee %>, step = 1, MAX = 3;
  f.classList.add('js');
  var gbp = function (m) { return '£' + (m / 100).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
  var lastKey = '';
  function update() {
    var p = f.querySelector('input[name=period]:checked'); if (!p) return;
    var months = +p.dataset.months, lines = [[p.dataset.name + ' plan, ' + months + ' month' + (months === 1 ? '' : 's'), +p.dataset.price]];
    f.querySelectorAll('[data-addon]').forEach(function (i) { var n = Math.max(0, Math.min(20, parseInt(i.value, 10) || 0)); i.value = n; if (n) lines.push([n + ' × ' + i.dataset.label + ' (' + months + ' mo)', n * +i.dataset.addon * months]); });
    if (months < 12) lines.push(['Setup and installation (once)', SETUP]);
    var net = lines.reduce(function (t, l) { return t + l[1]; }, 0), vat = Math.round(net * 0.2);
    var key = JSON.stringify(lines); if (key === lastKey) return; var first = !lastKey; lastKey = key;
    var ul = f.querySelector('[data-t-lines]'); ul.innerHTML = '';
    lines.forEach(function (l) { var li = document.createElement('li'); if (!first) li.className = 'v2-pop'; var a = document.createElement('span'); a.textContent = l[0]; var b = document.createElement('b'); b.textContent = gbp(l[1]); li.appendChild(a); li.appendChild(b); ul.appendChild(li); });
    f.querySelector('[data-t-vat]').textContent = gbp(vat);
    var t = f.querySelector('[data-t-total]'); t.textContent = gbp(net + vat); if (!first) { t.classList.remove('v2-pop'); void t.offsetWidth; t.classList.add('v2-pop'); }
  }
  function go(n) {
    step = Math.max(1, Math.min(MAX, n));
    f.querySelectorAll('[data-tr-step]').forEach(function (s) { s.classList.toggle('on', +s.dataset.trStep === step); });
    f.querySelectorAll('[data-tr-dot]').forEach(function (d) { d.classList.toggle('on', +d.dataset.trDot <= step); });
    f.querySelector('[data-tr-bar]').style.width = ((step - 1) / (MAX - 1) * 100) + '%';
    f.querySelector('[data-tr-back]').hidden = step === 1;
    f.querySelector('[data-tr-next]').hidden = step === MAX;
    f.querySelector('[data-tr-submit]').hidden = step !== MAX;
    var first = f.querySelector('[data-tr-step="' + step + '"] input:not([type=radio]):not(.tr-hp)');
    if (step === MAX && first) setTimeout(function () { first.focus(); }, 250);
  }
  f.addEventListener('click', function (e) {
    var q = e.target.closest('[data-tr-q]');
    if (q) { var i = q.parentNode.querySelector('input'); i.value = Math.max(0, Math.min(20, (parseInt(i.value, 10) || 0) + +q.dataset.trQ)); update(); return; }
    if (e.target.closest('[data-tr-next]')) return go(step + 1);
    if (e.target.closest('[data-tr-back]')) return go(step - 1);
    if (e.target.closest('[data-tr-dot]')) return go(+e.target.closest('[data-tr-dot]').dataset.trDot);
  });
  // Picking a plan moves straight on: that is the whole of step 1.
  f.querySelectorAll('input[name=period]').forEach(function (r) { r.addEventListener('change', function () { update(); setTimeout(function () { if (step === 1) go(2); }, 320); }); });
  // Only the extras' number boxes change the price; typing the venue or email does not touch the summary.
  f.querySelectorAll('[data-addon]').forEach(function (i) { i.addEventListener('input', update); });
  f.addEventListener('submit', function (e) {
    var v = f.querySelector('[name=venue]'), m = f.querySelector('[name=email]');
    if (!v.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(m.value.trim())) { e.preventDefault(); go(3); (v.value.trim() ? m : v).focus(); (v.value.trim() ? m : v).classList.add('tr-err'); return; }
    var b = f.querySelector('[data-tr-submit]'); b.disabled = true; b.textContent = 'Opening Dojo’s secure page…';
  });
  update(); go(<%= error ? 3 : 1 %>);
  var sw = document.querySelector('[data-tr-swap]');
  if (sw && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var words = JSON.parse(sw.getAttribute('data-words')), wi = 0;
    setInterval(function () { sw.classList.add('out'); setTimeout(function () { wi = (wi + 1) % words.length; sw.textContent = words[wi]; sw.classList.remove('out'); }, 350); }, 2600);
  }
})();
</script>
<%- include('partials/footer') %>
