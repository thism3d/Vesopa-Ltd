<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Sign in | Vesopa Admin</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link rel="stylesheet" href="/admin-library/panel.css">
</head>
<body>

<div class="ap-login">
  <div class="ap-login-box">
    <img src="/favicon.png" alt="Vesopa EPOS">
    <h1>Vesopa Admin</h1>
    <p class="sub">Staff console for the site and the back office</p>

<% if (error) { %>
    <%# Wording never says which admins exist; see admin/vesopa-auth.js. %>
    <div class="ap-flash err"><span class="material-icons">error</span><%= error %></div>
<% } %>

<%# Vesopa is the only way in — the owner's decision (2026-09-22). There is
    no username and password form any more. `locals.` so a render that forgot
    the flag says sign-in is unavailable rather than throwing. %>
<% if (locals.vesopaSignIn === true) { %>
    <%# A plain link, not a form: /start is a GET that only redirects to
        auth.vesopa.com. %>
    <a class="ap-btn primary ap-vesopa-btn" href="/admin/auth/vesopa/start" id="vesopa-signin">
      <%# The Vesopa mark, drawn in the button's ink so it reads on lime. %>
      <svg class="ap-vesopa-mark" viewBox="0 0 46.35 33.09" aria-hidden="true" focusable="false">
        <polygon points="9.95 0 0 0 18.01 33.09 27.96 33.09 9.95 0"/>
        <polygon points="27.4 16.54 37.35 16.54 46.35 0 36.4 0 27.4 16.54"/>
        <polygon points="27.4 16.54 18.39 33.09 28.34 33.09 37.35 16.54 27.4 16.54" opacity=".55"/>
      </svg>
      Connect with Vesopa
    </a>
<% } else { %>
    <div class="ap-flash err"><span class="material-icons">lock</span>
      Sign-in is unavailable: Vesopa sign-in is not configured on this server.</div>
<% } %>
  </div>
</div>

</body>
</html>
