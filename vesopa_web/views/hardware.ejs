<%- include('partials/header') %>
<%#
  The hardware shop (2026-10-24). Products, specs and prices come from
  src/hardware-catalogue.js; public/library/v2.js adds the filter, the
  quantities, the setup total and the details panel. Without JS the page still
  lists every product with its price, and each card links to its details.
%>
<section class="hw-hero">
    <div class="v2-wrap v2-head">
        <div style="flex:1 1 560px;min-width:0">
            <p class="vh-eyebrow">Vesopa hardware</p>
            <h1 class="v2-title" style="font-size:clamp(36px,5vw,60px)">The kit behind the counter, <span>ready to trade.</span></h1>
            <p class="v2-lede">Every device arrives with Vesopa installed, connected to your card machine and supported by us. 12-month warranty, UK plugs, and set up with you on the day.</p>
        </div>
        <a class="v2-btn ghost" href="/assets/v2/Vesopa-EPOS-Hardware-Brochure.pdf" download>Download the brochure (PDF)</a>
    </div>
</section>

<section class="v2-sec" data-hw-shop aria-label="Hardware">
    <div class="v2-wrap">
        <div class="hw-filter" role="group" aria-label="Filter by category">
            <% hardware.CATEGORIES.forEach(function (c, i) { %>
            <button type="button" data-hw-cat="<%= c[0] %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= c[1] %></button>
            <% }); %>
        </div>

        <div class="hw-layout">
            <div class="v2-kit">
                <% hardware.PRODUCTS.forEach(function (p) { %>
                <article class="v2-item" id="<%= p.sku %>" data-hw-item data-sku="<%= p.sku %>" data-cat="<%= p.cat %>">
                    <a class="ph" href="#<%= p.sku %>" data-hw-open aria-label="Details for <%= p.name %>">
                        <% if (p.img) { %><img src="<%= p.img %>" loading="lazy" decoding="async" alt="<%= p.name %>"><% } else { %><span class="none">Photo coming soon</span><% } %>
                    </a>
                    <div class="bd">
                        <span class="v2-stock <%= p.stock === 'in' ? 'in' : 'lead' %>"><%= p.stock === 'in' ? 'In stock' : 'Ships in 7-10 days' %></span>
                        <h2 style="margin:0;font:700 17px/1.3 var(--font-display);text-transform:uppercase"><%= p.name %></h2>
                        <span class="sku"><%= p.sku %> · runs <%= p.runs %></span>
                        <div style="margin-top:auto;padding-top:10px;display:flex;align-items:center;justify-content:space-between;gap:10px">
                            <span class="pr" style="margin:0;padding:0"><%= hardware.gbp(p.price) %> <small>ex VAT</small></span>
                            <span class="hw-qty">
                                <button type="button" data-hw-q="-1" aria-label="One fewer <%= p.name %>">−</button>
                                <output aria-live="polite">0</output>
                                <button type="button" class="add" data-hw-q="1" aria-label="Add <%= p.name %>">+</button>
                            </span>
                        </div>
                    </div>
                </article>
                <% }); %>
            </div>

            <aside class="hw-cart" aria-label="Your setup">
                <h2>Your setup</h2>
                <p class="v2-note" style="margin:6px 0 0">Add kit with + to see the total.</p>
                <p data-hw-empty class="v2-note" style="margin:18px 0 0;padding:16px;border:1px dashed rgba(255,255,255,.2);border-radius:14px">Nothing added yet. Most venues start with a till and a receipt printer.</p>
                <ul class="hw-lines" data-hw-lines></ul>
                <div class="hw-tot">
                    <div class="big"><span>Hardware</span><b data-hw-total>£0.00</b></div>
                    <div><span>VAT (20%)</span><span data-hw-vat>£0.00</span></div>
                    <div><span>Software</span><span>from £60/month</span></div>
                </div>
                <div class="v2-actions" style="margin-top:20px">
                    <a class="v2-btn" href="/#try-vesopa" style="width:100%;justify-content:center">Ask for a quote</a>
                    <a class="v2-btn ghost" href="/pricing" style="width:100%;justify-content:center">See software plans</a>
                </div>
                <p class="v2-note" style="margin:14px 0 0;line-height:1.5">Delivered and set up by Vesopa. Card machines come from Dojo, Teya or Barclaycard on your own merchant account.</p>
            </aside>
        </div>

        <section class="hw-detail" data-hw-detail aria-label="Product details" hidden>
            <div class="pic"><img data-d-img src="" alt=""></div>
            <div class="txt">
                <p class="vh-eyebrow" data-d-sku style="margin-bottom:12px"></p>
                <h2 class="v2-title" data-d-name style="font-size:30px"></h2>
                <p class="v2-lede" data-d-headline style="font-size:17px"></p>
                <p style="margin:16px 0 0;display:flex;align-items:baseline;gap:10px"><span data-d-price style="font:800 32px var(--font-display)"></span><span class="v2-note">ex VAT · <span data-d-stock></span></span></p>
                <table><caption class="v2-note" style="text-align:left;padding-bottom:6px">Specification</caption><tbody></tbody></table>
            </div>
        </section>
    </div>
</section>
<script type="application/json" id="hw-data"><%- JSON.stringify(Object.fromEntries(hardware.PRODUCTS.map(function (p) { return [p.sku, p]; }))).replace(/</g, '\\u003c') %></script>
<script src="/library/v2.js" defer></script>
<%- include('partials/footer') %>
