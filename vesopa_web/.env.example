# Copy to .env and fill in. .env is gitignored — never commit real credentials.
PORT=5065
NODE_ENV=development

# Same vesopa_eposdb the back office (vesopa_server) uses, so a demo request
# approved here creates the account the back office logs in with.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_eposdb
DB_USER=
DB_PASSWORD=

# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Outbound SMTP for enquiry notifications and approval emails.
SMTP_HOST=mail.vesopaepos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@vesopaepos.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Vesopa EPOS
MAIL_FROM=support@vesopaepos.com
# Where enquiry notifications land.
MAIL_TO=support@vesopa.com

# PayPal. PAYPAL_ENV is 'sandbox' or 'live'.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe — the card, Apple Pay and Google Pay tiles on the checkout page.
# They are ONE gateway: a hosted Checkout Session shows whichever the
# customer's device can actually offer. Leave the keys blank and all three
# tiles render greyed out, exactly as they did before Stripe was wired in.
# STRIPE_SECRET_KEY is SERVER SIDE ONLY.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Public origin, used for absolute URLs in emails and og: tags.
SITE_URL=https://vesopaepos.com
# The back office runs as a separate app (vesopa_server); the nav links out to it.
BACKOFFICE_URL=https://backoffice.vesopaepos.com
