ead-more\" href=\"https:\/\/pontardawe.rfc.wales\/2024\/09\/18\/job-vacancy-club-facilities-manager\/\" rel=\"noopener noreferrer\">Read more<span class=\"screen-reader-text\">: Job vacancy &#8211; Club Facilities Manager<\/span><\/a><\/div><\/li>\n<li><div class=\"wp-block-latest-posts__featured-image\"><a href=\"https:\/\/pontardawe.rfc.wales\/2024\/09\/11\/tribute-to-brian-bones-williams\/\" aria-label=\"Tribute to Brian &#8216;BONES&#8217; Williams\"><img loading=\"lazy\" decoding=\"async\" width=\"197\" height=\"300\" src=\"https:\/\/pontardawe.rfc.wales\/wp-content\/uploads\/sites\/10\/2024\/12\/image-197x300.jpg\" class=\"attachment-medium size-medium wp-post-image\" alt=\"\" style=\"\" srcset=\"https:\/\/pontardawe.rfc.wales\/wp-content\/uploads\/sites\/10\/2024\/12\/image-197x300.jpg 197w, https:\/\/pontardawe.rfc.wales\/wp-content\/uploads\/sites\/10\/2024\/12\/image-84x128.jpg 84w, https:\/\/pontardawe.rfc.wales\/wp-content\/uploads\/sites\/10\/2024\/12\/image-21x32.jpg 21w, https:\/\/pontardawe.rfc.wales\/wp-content\/uploads\/sites\/10\/2024\/12\/image.jpg 674w\" sizes=\"auto, (max-width: 197px) 100vw, 197px\" \/><\/a><\/div><a class=\"wp-block-latest-posts__post-title\" href=\"https:\/\/pontardawe.rfc.wales\/2024\/09\/11\/tribute-to-brian-bones-williams\/\">Tribute to Brian &#8216;BONES&#8217; Williams<\/a><time datetime=\"2024-09-11T14:05:00+02:00\" class=\"wp-block-latest-posts__post-date\">11 September 2024<\/time><div class=\"wp-block-latest-posts__post-excerpt\">It is with heavy hearts that we say goodbye to Brian &#8216;BONES&#8217; Williams, a true legend of Pontardawe RFC and an unforgettable character. For many years, Brian stood as a pillar of the club\u00e2\u20ac\u201dboth on and off the field. As a player and club captain, his presence inspired countless teammates, and his leadership was felt\u2026 <a class=\"wp-block-latest-posts__read-more\" href=\"https:\/\/pontardawe.rfc.wales\/2024\/09\/11\/tribute-to-brian-bones-williams\/\" rel=\"noopener noreferrer\">Read more<span class=\"screen-reader-text\">: Tribute to Brian &#8216;BONES&#8217; Williams<\/span><\/a><\/div><\/li>\n<\/ul>\n\n\n<p class=\"has-text-align-center\">League Table goes here<\/p>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-1 is-layout-flex wp-block-gallery-is-layout-flex\"><\/figure>\n\n\n\n<p><\/p>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"template-homepage.php","meta":{"footnotes":""},"class_list":["post-7","page","type-page","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/pages\/7","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/comments?post=7"}],"version-history":[{"count":7,"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/pages\/7\/revisions"}],"predecessor-version":[{"id":22,"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/pages\/7\/revisions\/22"}],"wp:attachment":[{"href":"https:\/\/pontardawe.rfc.wales\/wp-json\/wp\/v2\/media?parent=7"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":2,"date":"2024-12-17T08:36:55","date_gmt":"2024-12-17T06:36:55","guid":{"rendered":"http:\/\/pontardawe.rfc.wales\/?page_id=2"},"modified":"2024-12-17T08:36:55","modified_gmt":"2024-12-17T06:36:55","slug":"sample-page","status":"publish","type":"page","link":"https:\/\/pontardawe.rfc.wales\/sample-page\/","title":{"rendered":"Sample Page"},"content":{"rendered":"\n<p>This is an example page. It&#8217;s different f