<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Without this key iOS never hands the app an APNs
	     token, and registerForRemoteNotifications fails with "no valid
	     aps-environment entitlement string found". Xcode rewrites it to
	     development for a debug run and the archive carries production. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
