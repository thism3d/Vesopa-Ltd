<%- include('partials/head') %>

<%
  /*
   * The password step, on the Google model (`reference_design/…716`).
   *
   * WHAT THE REFERENCE ACTUALLY SHOWS, measured rather than remembered:
   *   the mark is SMALL — about 48px, top left, not a full-width wordmark
   *   "Hi <name>" at ~40px
   *   an account chip: a pill outline holding a small avatar, the address, ▾
   *   the step title, then a muted subtitle
   *   one text link low on the page — "Try another way"
   *   no card, no border, no panel. The step sits on the background.
   *
   * The account chip is the part worth keeping for a reason beyond looks: it
   * tells the person WHICH account they are about to put a password into. On a
   * shared machine, or for anybody with a work address and a personal one, that
   * is the difference between signing in and three failed attempts followed by
   * a lockout on the wrong account.
   */
%>

<main class="signin">
  <a class="signin-mark" href="/" aria-label="Vesopa">
    <img src="/brand/icon-192.png" alt="" width="44" height="44">
  </a>

  <h1 class="signin-hi"><%= greeting %></h1>

  <%
    /*
     * The chip is a LINK back to /login, not a dropdown. A dropdown implies a
     * list of accounts this browser already knows, and this server does not
     * keep one — offering the affordance and then not having the list is worse
     * than a link that plainly starts again.
     */
  %>
  <a class="account-chip" href="/login<%= returnTo ? '?return_to=' + encodeURIComponent(returnTo) : '' %>">
    <% if (avatar) { %>
    <img src="<%= avatar %>" alt="" width="22" height="22">
    <% } else { %>
    <span class="chip-initial"><%= initial %></span>
    <% } %>
    <span class="chip-id"><%= destination %></span>
    <span class="chip-caret" aria-hidden="true">
      <%- include('partials/icon', { name: 'chevron' }) %>
    </span>
  </a>

  <% if (application) { %>
  <p class="signin-sub">to continue to <b><%= application.name %></b></p>
  <% } %>

  <div class="form-error" role="alert" aria-live="polite" id="form-error"><%= error || '' %></div>

  <form method="post" action="/login/password" class="signin-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="return_to" value="<%= returnTo %>">

    <%
      /*
       * The floating-label field from `…715`: the label rides the top border
       * while focused, the border is 2px in the accent colour, and the box is
       * ~64px tall. Written as a real <label> after the input so CSS can react
       * to `:focus` and `:not(:placeholder-shown)` — which is why the input
       * carries a single-space placeholder.
       */
    %>
    <div class="float-field">
      <input type="password" id="password" name="password"
             autocomplete="current-password" placeholder=" "
             autofocus required aria-describedby="form-error">
      <label for="password">Enter your password</label>
    </div>

    <label class="tickbox">
      <input type="checkbox" name="remember" value="1" <%= remember ? 'checked' : '' %>>
      <span>Remember me on this device</span>
    </label>

    <div class="signin-actions">
      <%
        /*
         * THE WAY OUT, and it is a text link rather than a second button on
         * purpose. Somebody who knows their password should see one thing to
         * press; somebody who does not needs the escape to be findable, not
         * competing. The wording avoids "OTP" — it is jargon most people have
         * never met, and the sentence has to work for a diner as well as a
         * developer.
         */
      %>
      <button type="submit" name="via" value="password" class="btn btn-primary btn-pill">Continue</button>
    </div>
    <%- include('partials/captcha', { action: 'password' }) %>
  </form>

  <form method="post" action="/login/use-code" class="signin-alt">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="return_to" value="<%= returnTo %>">
    <button type="submit" class="linklike">Email me a code instead</button>
  </form>

  <% if (canPasskey) { %>
  <button class="linklike signin-alt" type="button" data-passkey hidden>Use a passkey</button>
  <% } %>
</main>

<%- include('partials/foot') %>
