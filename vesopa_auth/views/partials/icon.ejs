<%
  /*
   * Line icons, drawn inline so they take the surrounding text colour and work
   * in both schemes without a second file. No icon font and no sprite sheet:
   * the Content-Security-Policy on this origin forbids external resources, and
   * a login domain is the last place to make an exception.
   *
   * `aria-hidden` on every one — each is beside a heading or a label that
   * already says what it is, and a screen reader announcing both says
   * everything twice.
   *
   * ONE MARK, ONE MEANING, EVERYWHERE. The key icon is a credential on the
   * security page, in the developer portal and in the administrator's console.
   * The moment the same shape means two things the rail stops being scannable,
   * which is the entire reason for having marks at all.
   *
   * All on a 24 box, 1.6 stroke, round caps. Consistency of weight is what
   * makes a set of hand-drawn paths read as one family.
   */
  const stroke = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
%>
<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
<% if (name === 'lock') { %>
  <rect x="4" y="10.5" width="16" height="10" rx="2.5" <%- stroke %>/>
  <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" <%- stroke %>/>
  <circle cx="12" cy="15.5" r="1.4" fill="currentColor"/>
<% } else if (name === 'key') { %>
  <circle cx="8" cy="12" r="4" <%- stroke %>/>
  <path d="M12 12h9M18 12v3.5M15.5 12v2.5" <%- stroke %>/>
<% } else if (name === 'shield') { %>
  <path d="M12 3.2l7 2.6v5.4c0 4.3-2.9 7.6-7 9.6-4.1-2-7-5.3-7-9.6V5.8z" <%- stroke %>/>
  <path d="M9 12.2l2.1 2.1L15.4 10" <%- stroke %>/>
<% } else if (name === 'eye') { %>
  <path d="M2.6 12S6 6.2 12 6.2 21.4 12 21.4 12 18 17.8 12 17.8 2.6 12 2.6 12z" <%- stroke %>/>
  <circle cx="12" cy="12" r="2.6" <%- stroke %>/>
  <path d="M4.5 19.5l15-15" <%- stroke %>/>
<% } else if (name === 'till') { %>
  <rect x="3.2" y="8.5" width="17.6" height="12" rx="2" <%- stroke %>/>
  <path d="M7 8.5V5.2a1.6 1.6 0 0 1 1.6-1.6h6.8A1.6 1.6 0 0 1 17 5.2v3.3" <%- stroke %>/>
  <path d="M7.6 13h8.8M7.6 16.6h5" <%- stroke %>/>
<% } else if (name === 'menu') { %>
  <rect x="5" y="2.8" width="14" height="18.4" rx="2.4" <%- stroke %>/>
  <path d="M8.8 8h6.4M8.8 11.6h6.4M8.8 15.2h3.6" <%- stroke %>/>
<% } else if (name === 'chart') { %>
  <path d="M3.6 20.4h16.8" <%- stroke %>/>
  <rect x="5.6" y="12" width="3.2" height="6" rx="1" <%- stroke %>/>
  <rect x="10.4" y="8" width="3.2" height="10" rx="1" <%- stroke %>/>
  <rect x="15.2" y="4.4" width="3.2" height="13.6" rx="1" <%- stroke %>/>
<% } else if (name === 'cloud') { %>
  <path d="M7 18.4h10a4 4 0 0 0 .5-7.97 5.6 5.6 0 0 0-10.8-1.2A3.9 3.9 0 0 0 7 18.4z" <%- stroke %>/>

<%
  /* ------------------------------------------------------------------------
   * The console rail, and the rows inside it
   * --------------------------------------------------------------------- */
%>
<% } else if (name === 'home') { %>
  <path d="M4 10.4L12 4l8 6.4V19a1.6 1.6 0 0 1-1.6 1.6H5.6A1.6 1.6 0 0 1 4 19z" <%- stroke %>/>
  <path d="M9.6 20.6v-6h4.8v6" <%- stroke %>/>
<% } else if (name === 'person') { %>
  <circle cx="12" cy="8.2" r="3.6" <%- stroke %>/>
  <path d="M4.8 20.2a7.2 7.2 0 0 1 14.4 0" <%- stroke %>/>
<% } else if (name === 'link') { %>
  <path d="M10.2 13.8a3.6 3.6 0 0 0 5.2 0l2.8-2.9a3.7 3.7 0 0 0-5.2-5.2l-1.4 1.4" <%- stroke %>/>
  <path d="M13.8 10.2a3.6 3.6 0 0 0-5.2 0l-2.8 2.9a3.7 3.7 0 0 0 5.2 5.2l1.4-1.4" <%- stroke %>/>
<% } else if (name === 'device') { %>
  <rect x="2.8" y="4.6" width="12.6" height="9.4" rx="1.6" <%- stroke %>/>
  <path d="M6 18h6.4" <%- stroke %>/>
  <rect x="17" y="9.4" width="4.4" height="9.6" rx="1.4" <%- stroke %>/>
<%
  /*
   * A shape per kind of machine, for the devices page. `phone` already existed
   * further down — it is drawn for a mobile NUMBER and happens to be exactly
   * the right outline for a mobile DEVICE, so it is reused rather than
   * duplicated: two branches with one name in this chain would mean the first
   * silently wins and the second is dead markup nobody notices.
   *
   * The owner asked for "different device different logo", and it is worth the
   * three shapes for the same reason the country is: nine rows that all say the
   * same thing in the same shape is a list nobody reads. A phone outline among
   * six laptops is SEEN before it is read, which on a security page is the
   * whole job.
   */
%>
<% } else if (name === 'tablet') { %>
  <rect x="4.4" y="2.8" width="15.2" height="18.4" rx="2.2" <%- stroke %>/>
  <path d="M10.8 18.4h2.4" <%- stroke %>/>
<% } else if (name === 'desktop') { %>
  <rect x="2.8" y="4.4" width="18.4" height="12" rx="1.8" <%- stroke %>/>
  <path d="M8.6 20h6.8M12 16.4V20" <%- stroke %>/>
<% } else if (name === 'history') { %>
  <circle cx="12" cy="12" r="8.4" <%- stroke %>/>
  <path d="M12 7.2V12l3.4 2" <%- stroke %>/>
<% } else if (name === 'apps') { %>
  <rect x="4" y="4" width="6.4" height="6.4" rx="1.6" <%- stroke %>/>
  <rect x="13.6" y="4" width="6.4" height="6.4" rx="1.6" <%- stroke %>/>
  <rect x="4" y="13.6" width="6.4" height="6.4" rx="1.6" <%- stroke %>/>
  <rect x="13.6" y="13.6" width="6.4" height="6.4" rx="1.6" <%- stroke %>/>
<% } else if (name === 'code') { %>
  <path d="M8.8 8.4L4.6 12l4.2 3.6M15.2 8.4l4.2 3.6-4.2 3.6M13.6 5.2l-3.2 13.6" <%- stroke %>/>
<% } else if (name === 'settings') { %>
  <circle cx="12" cy="12" r="3.1" <%- stroke %>/>
  <path d="M19.2 14.6a1.5 1.5 0 0 0 .3 1.66l.05.05a1.8 1.8 0 1 1-2.55 2.55l-.05-.05a1.5 1.5 0 0 0-1.66-.3 1.5 1.5 0 0 0-.91 1.37v.14a1.8 1.8 0 1 1-3.6 0v-.07a1.5 1.5 0 0 0-.98-1.37 1.5 1.5 0 0 0-1.66.3l-.05.05A1.8 1.8 0 1 1 5.54 16.3l.05-.05a1.5 1.5 0 0 0 .3-1.66 1.5 1.5 0 0 0-1.37-.91h-.14a1.8 1.8 0 1 1 0-3.6h.07a1.5 1.5 0 0 0 1.37-.98 1.5 1.5 0 0 0-.3-1.66l-.05-.05A1.8 1.8 0 1 1 8.06 4.84l.05.05a1.5 1.5 0 0 0 1.66.3h.07A1.5 1.5 0 0 0 10.75 3.9v-.14a1.8 1.8 0 1 1 3.6 0v.07a1.5 1.5 0 0 0 .91 1.37 1.5 1.5 0 0 0 1.66-.3l.05-.05a1.8 1.8 0 1 1 2.55 2.55l-.05.05a1.5 1.5 0 0 0-.3 1.66v.07a1.5 1.5 0 0 0 1.37.91h.14a1.8 1.8 0 1 1 0 3.6h-.07a1.5 1.5 0 0 0-1.37.91z" <%- stroke %>/>
<% } else if (name === 'people') { %>
  <circle cx="9.2" cy="8.4" r="3.2" <%- stroke %>/>
  <path d="M3.4 19.6a5.8 5.8 0 0 1 11.6 0" <%- stroke %>/>
  <path d="M16.2 5.6a3.2 3.2 0 0 1 0 5.9M17.4 14.4a5.8 5.8 0 0 1 3.2 5.2" <%- stroke %>/>
<% } else if (name === 'building') { %>
  <path d="M4.4 20.4V6.2a1.4 1.4 0 0 1 1.4-1.4h7.4a1.4 1.4 0 0 1 1.4 1.4v14.2" <%- stroke %>/>
  <path d="M14.6 10.4h3.6a1.4 1.4 0 0 1 1.4 1.4v8.6M3 20.4h18" <%- stroke %>/>
  <path d="M7.6 8.6h3.4M7.6 12.4h3.4M7.6 16.2h3.4" <%- stroke %>/>
<% } else if (name === 'plus') { %>
  <path d="M12 5.2v13.6M5.2 12h13.6" <%- stroke %>/>
<% } else if (name === 'chevron') { %>
  <path d="M9.4 5.6L15.8 12l-6.4 6.4" <%- stroke %>/>
<% } else if (name === 'back') { %>
  <path d="M14.6 5.6L8.2 12l6.4 6.4" <%- stroke %>/>
<% } else if (name === 'check') { %>
  <circle cx="12" cy="12" r="8.6" <%- stroke %>/>
  <path d="M8.4 12.3l2.5 2.5 4.7-5" <%- stroke %>/>
<% } else if (name === 'alert') { %>
  <path d="M12 4.4l8.4 15.2H3.6z" <%- stroke %>/>
  <path d="M12 10v3.6" <%- stroke %>/>
  <circle cx="12" cy="16.6" r="1" fill="currentColor"/>
<% } else if (name === 'trash') { %>
  <path d="M4.8 6.8h14.4M9.6 6.8V5.2a1.2 1.2 0 0 1 1.2-1.2h2.4a1.2 1.2 0 0 1 1.2 1.2v1.6" <%- stroke %>/>
  <path d="M6.6 6.8l.9 12.2a1.4 1.4 0 0 0 1.4 1.3h6.2a1.4 1.4 0 0 0 1.4-1.3l.9-12.2" <%- stroke %>/>
<% } else if (name === 'mail') { %>
  <rect x="3" y="5.4" width="18" height="13.2" rx="2" <%- stroke %>/>
  <path d="M3.6 7l7.5 5.4a1.6 1.6 0 0 0 1.8 0L20.4 7" <%- stroke %>/>
<% } else if (name === 'phone') { %>
  <rect x="6.6" y="2.8" width="10.8" height="18.4" rx="2.4" <%- stroke %>/>
  <path d="M10.6 5.6h2.8" <%- stroke %>/>
  <circle cx="12" cy="17.8" r="1" fill="currentColor"/>
<% } else if (name === 'globe') { %>
  <circle cx="12" cy="12" r="8.6" <%- stroke %>/>
  <path d="M3.6 12h16.8" <%- stroke %>/>
  <path d="M12 3.4a13 13 0 0 1 0 17.2 13 13 0 0 1 0-17.2z" <%- stroke %>/>
<% } else if (name === 'bolt') { %>
  <path d="M13.4 2.8L5.2 13.4h5.6l-.6 7.8 8.6-10.8h-6z" <%- stroke %>/>
<% } else if (name === 'book') { %>
  <path d="M4.4 5.2a1.6 1.6 0 0 1 1.6-1.6H11a2 2 0 0 1 2 2v14a1.6 1.6 0 0 0-1.6-1.6H6a1.6 1.6 0 0 1-1.6-1.6z" <%- stroke %>/>
  <path d="M19.6 5.2A1.6 1.6 0 0 0 18 3.6h-5a2 2 0 0 0-2 2v14a1.6 1.6 0 0 1 1.6-1.6H18a1.6 1.6 0 0 0 1.6-1.6z" <%- stroke %>/>
<% } else if (name === 'clipboard') { %>
  <rect x="6" y="4.6" width="12" height="15.4" rx="1.8" <%- stroke %>/>
  <path d="M9.4 4.6V3.8a1.4 1.4 0 0 1 1.4-1.4h2.4a1.4 1.4 0 0 1 1.4 1.4v.8z" <%- stroke %>/>
  <path d="M9.4 11h5.2M9.4 14.6h3.4" <%- stroke %>/>
<% } else if (name === 'signout') { %>
  <path d="M14.6 7.6V6a1.6 1.6 0 0 0-1.6-1.6H6A1.6 1.6 0 0 0 4.4 6v12A1.6 1.6 0 0 0 6 19.6h7a1.6 1.6 0 0 0 1.6-1.6v-1.6" <%- stroke %>/>
  <path d="M9.8 12h9.8M16.6 8.8l3.2 3.2-3.2 3.2" <%- stroke %>/>
<% } else if (name === 'sparkle') { %>
  <path d="M12 3.4l1.9 4.9 4.9 1.9-4.9 1.9L12 17l-1.9-4.9-4.9-1.9 4.9-1.9z" <%- stroke %>/>
  <path d="M18.4 15.6l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z" <%- stroke %>/>
<% } %>
</svg>
