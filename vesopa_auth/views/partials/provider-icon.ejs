<%
  /*
   * The four provider marks, inline.
   *
   * INLINE AND NOT A CSS BACKGROUND, for one reason: Apple's and GitHub's marks
   * are monochrome and must be black on a light button and white on a dark one.
   * A background-image cannot inherit `currentColor`, so a CSS approach needs
   * two files per provider and a media query to swap them — and gets it wrong
   * for anyone whose system theme and chosen theme disagree. Inline, they are
   * simply the colour of the button's text.
   *
   * Google's and Microsoft's marks are multicoloured and must NOT be recoloured
   * — both brands' guidelines are explicit about it — so those keep their fixed
   * colours in both schemes, which is why they are drawn differently here.
   *
   * `aria-hidden` on all four: the button already says "Continue with Google",
   * and a screen reader announcing the logo as well just says it twice.
   */
%>
<% if (key === 'google') { %>
<svg class="provider-mark" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
  <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
  <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.02-3.7H.96v2.34A9 9 0 0 0 9 18z"/>
  <path fill="#FBBC05" d="M3.98 10.72a5.4 5.4 0 0 1 0-3.44V4.94H.96a9 9 0 0 0 0 8.12l3.02-2.34z"/>
  <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.94l3.02 2.34C4.68 5.16 6.66 3.58 9 3.58z"/>
</svg>
<% } else if (key === 'apple') { %>
<svg class="provider-mark" viewBox="0 0 18 18" aria-hidden="true" focusable="false" fill="currentColor">
  <path d="M12.32 9.53c-.02-1.87 1.53-2.77 1.6-2.82-.87-1.28-2.23-1.45-2.71-1.47-1.15-.12-2.25.68-2.84.68-.58 0-1.49-.66-2.45-.65-1.26.02-2.42.73-3.07 1.86-1.31 2.27-.34 5.63.94 7.47.62.9 1.37 1.91 2.34 1.87.94-.04 1.3-.61 2.43-.61 1.14 0 1.46.61 2.45.59 1.01-.02 1.65-.92 2.27-1.82.71-1.04 1-2.05 1.02-2.1-.02-.01-1.96-.75-1.98-2.98zM10.5 3.9c.52-.63.87-1.5.77-2.38-.75.03-1.65.5-2.19 1.12-.48.56-.9 1.45-.79 2.31.84.06 1.69-.42 2.21-1.05z"/>
</svg>
<% } else if (key === 'microsoft') { %>
<svg class="provider-mark" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
  <path fill="#F25022" d="M1 1h7.6v7.6H1z"/>
  <path fill="#7FBA00" d="M9.4 1H17v7.6H9.4z"/>
  <path fill="#00A4EF" d="M1 9.4h7.6V17H1z"/>
  <path fill="#FFB900" d="M9.4 9.4H17V17H9.4z"/>
</svg>
<% } else if (key === 'github') { %>
<svg class="provider-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
</svg>
<% } %>
