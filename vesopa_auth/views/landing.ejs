<%- include('partials/head') %>

<%
  /*
   * THE LANDING PAGE IS PART OF THE OAUTH SUBMISSION, not marketing decoration.
   *
   * Google's verification team open the homepage of the domain an application
   * is registered to. They are checking that it is a real service, that it
   * explains what it does with the data it asks for, and that the privacy
   * policy is reachable from it. A holding page fails that review as surely as
   * a broken policy link.
   *
   * So everything claimed below is true of what is actually running, and the
   * privacy policy is linked from the header, the hero and the footer.
   *
   * No external images, fonts or scripts: the Content-Security-Policy on this
   * origin allows none, and the one place that must never load a stranger's
   * JavaScript is the domain the sign-in form lives on. Every graphic here is
   * inline SVG or CSS.
   */
%>

<header class="site-head">
  <a class="brand" href="/" aria-label="Vesopa OAuth home">
    <img class="brand-mark" src="/brand/logo-light.svg" alt="Vesopa" width="130" height="17" data-logo-light>
    <img class="brand-mark" src="/brand/logo-dark.svg" alt="Vesopa" width="130" height="17" data-logo-dark>
  </a>
  <nav class="site-nav" aria-label="Main">
    <a href="/docs">Developers</a>
    <a href="/policies">Policies</a>
    <a href="/privacy">Privacy</a>
    <a class="btn-sm" href="/login">Sign in</a>
  </nav>
</header>

<main>
  <!-- ================================================================ hero -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Vesopa account · auth.vesopa.com
        </p>

        <h1>One account.<br>Every Vesopa <span class="hl">product.</span></h1>

        <p class="lede">
          The single sign-in behind the till, the kiosk, the menu, loyalty, gift
          cards, the back office and the hosting panel. Sign in with an email
          address, a phone number, a passkey, or an account you already have,
          and the same account works everywhere.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary btn-auto" href="/login">Sign in or create an account</a>
          <a class="btn btn-quiet btn-auto" href="#how-it-works">How signing in works</a>
        </div>

        <%
          /*
           * The three steps, in words, beside the moving picture of them. They
           * are also the controls for the picture: pressing one shows that step.
           * A screen reader gets the steps as a list and never the animation.
           */
        %>
        <ol class="hero-steps" data-demo-steps>
          <li><button type="button" data-go="1" aria-pressed="true"><span class="n">01</span><span><b>Enter your email</b> or phone number</span></button></li>
          <li><button type="button" data-go="2" aria-pressed="false"><span class="n">02</span><span><b>Type the code</b> we send you</span></button></li>
          <li><button type="button" data-go="3" aria-pressed="false"><span class="n">03</span><span><b>You are in</b> on every Vesopa app</span></button></li>
        </ol>

        <p class="hero-note">
          Built and run by Vesopa Software Ltd in the United Kingdom.
          <a href="/privacy">What we do with your data</a>.
        </p>
      </div>

      <%
        /*
         * THE DEMO: signing in, played through.
         *
         * Three screens of the real form, run by /js/home.js: an address being
         * typed, the code arriving in an inbox and filling the boxes, then the
         * products lighting up. Without the script it is the first screen,
         * already filled in, which is still an honest picture of the form.
         *
         * Decorative, so hidden from screen readers; the list of steps beside
         * it says the same thing in words. The example address is text in a
         * <span>, never a link, and the format-detection meta in the head stops
         * iOS turning it into one.
         */
        const demoProducts = [
          ['till', 'Till'], ['desktop', 'Kitchen'], ['tablet', 'Kiosk'], ['menu', 'Menu'],
          ['sparkle', 'Loyalty'], ['gift', 'Gift cards'], ['chart', 'Back office'], ['cloud', 'Cloud'],
        ];
      %>
      <div class="hero-visual">
        <div class="demo" data-demo data-step="1" aria-hidden="true">
          <div class="demo-glow"></div>
          <div class="demo-card">
            <div class="demo-top">
              <img class="brand-mark" src="/brand/logo-dark.svg" alt="" width="99" height="13">
              <span class="demo-lock"><%- include('partials/icon', { name: 'lock' }) %>auth.vesopa.com</span>
            </div>

            <div class="demo-panel" data-panel="1">
              <p class="demo-title">Sign in to Vesopa</p>
              <div class="demo-toggle"><span class="on">Email</span><span>Phone</span></div>
              <span class="demo-label">Email address</span>
              <div class="demo-field"><span class="demo-typed" data-text="alex@yourvenue.co.uk">alex@yourvenue.co.uk</span><span class="demo-caret"></span></div>
              <div class="demo-button" data-press>Continue</div>
              <div class="demo-divider"><span>or continue with</span></div>
              <div class="demo-providers">
                <% ['google', 'apple', 'microsoft', 'github'].forEach(function (key) { %>
                <span><%- include('partials/provider-icon', { key: key }) %></span>
                <% }) %>
              </div>
            </div>

            <div class="demo-panel" data-panel="2">
              <p class="demo-title">Check your email</p>
              <p class="demo-sub">We sent a 6-digit code to <span class="demo-addr">alex@yourvenue.co.uk</span></p>
              <div class="demo-code">
                <% '482913'.split('').forEach(function (d) { %><span class="demo-digit" data-digit="<%= d %>"><%= d %></span><% }) %>
              </div>
              <div class="demo-button" data-press>Continue</div>
              <p class="demo-small">Send another code · Use a different address</p>
            </div>

            <div class="demo-panel" data-panel="3">
              <div class="demo-done">
                <span class="demo-tick"><%- include('partials/icon', { name: 'check' }) %></span>
                <div>
                  <p class="demo-title">You are signed in</p>
                  <p class="demo-sub">One account, open on every Vesopa app.</p>
                </div>
              </div>
              <div class="demo-apps">
                <% demoProducts.forEach(function (item) { %>
                <span class="demo-app"><%- include('partials/icon', { name: item[0] }) %><%= item[1] %></span>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="demo-mail">
            <span class="demo-mail-icon"><img src="/brand/favicon.svg" alt="" width="22" height="22"></span>
            <div>
              <p class="demo-mail-from">Vesopa <span>now</span></p>
              <p class="demo-mail-subject">Your Vesopa code: 482913</p>
              <p class="demo-mail-body">Use this code to sign in to your Vesopa account.</p>
            </div>
          </div>

          <div class="demo-progress"><span></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== trust -->
  <%
    /*
     * Every one of these is a fact about the running system, phrased so that a
     * reviewer can check it. Nothing here claims a certification Vesopa does not
     * hold — no SOC 2, no ISO 27001, no HIPAA. Claiming one would be a lie on
     * the page a compliance team reads first.
     */
    const assurances = [
      ['lock', 'Argon2id password hashing',
       'The memory-hard algorithm OWASP recommends, with a server-side pepper that is not in the database.'],
      ['key', 'Passkeys and two-step verification',
       'Sign in with a fingerprint or face. Authenticator apps and one-time codes are supported too.'],
      ['shield', 'PKCE on every application',
       'Public and confidential clients alike. Authorisation codes are single-use and last sixty seconds.'],
      ['eye', 'No tracking, no advertising',
       'No third-party analytics and no advertising anywhere on this service. We do not sell personal data.'],
    ];
  %>
  <section class="assurances">
    <div class="assurance-grid">
      <% assurances.forEach(function (item) { %>
      <div class="assurance">
        <span class="assurance-icon" aria-hidden="true"><%- include('partials/icon', { name: item[0] }) %></span>
        <h3><%= item[1] %></h3>
        <p><%= item[2] %></p>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- ============================================================= guide -->
  <section class="band guide" id="how-it-works">
    <div class="band-inner">
      <p class="kicker">Getting started</p>
      <h2>Signing in, step by step</h2>
      <p class="section-lede">
        There is nothing to install and no password to invent. The first time you
        sign in, your account is made for you.
      </p>

      <ol class="guide-steps">
        <li class="rise">
          <span class="guide-n">01</span>
          <h3>Enter your email address or mobile number</h3>
          <p>Press <b>Sign in</b> on any Vesopa app, or go to auth.vesopa.com. Use the
          address your venue knows you by. UK mobile numbers can have the code by text.</p>
        </li>
        <li class="rise">
          <span class="guide-n">02</span>
          <h3>Type the six-digit code</h3>
          <p>It arrives within a few seconds, from Vesopa. It works once and lasts ten
          minutes. Not there? Look in junk mail, or press <b>Send another code</b>.</p>
        </li>
        <li class="rise">
          <span class="guide-n">03</span>
          <h3>You are in, everywhere</h3>
          <p>The till, the back office, the menu and the rest all know you now. Tick
          <b>Remember me</b> on your own device so you are not asked again.</p>
        </li>
        <li class="rise">
          <span class="guide-n">04</span>
          <h3>Make the next time faster</h3>
          <p>In your account, add a passkey to sign in with your face or fingerprint,
          or set a password. Both are optional, and codes keep working.</p>
        </li>
      </ol>

      <div class="mail-examples">
        <div class="mail-intro rise">
          <p class="kicker">What our emails look like</p>
          <h3>Know a real Vesopa email when you see one</h3>
          <p>
            Every email we send comes from <span class="addr">no-reply@vesopa.com</span>
            and looks like these. A sign-in code is only ever typed in on
            auth.vesopa.com or inside a Vesopa app.
          </p>
          <ul class="ticks">
            <li>We never ask for your code or password by email, phone or text.</li>
            <li>We never send a link that signs you in on its own.</li>
            <li>If you get a code you did not ask for, ignore it. Nobody gets in without it.</li>
          </ul>
        </div>

        <%
          /*
           * The two emails as src/mailer.js really sends them, slightly trimmed: the
           * same wording and the same light background (they are
           * light-only on purpose). Addresses are plain text, never links: an
           * example somebody can tap is an example that sends mail to a stranger.
           */
        %>
        <div class="mail-stack" aria-label="Example emails">
          <figure class="mail rise">
            <div class="mail-head">
              <p><span>From</span><span>Vesopa &lt;<span class="addr">no-reply@vesopa.com</span>&gt;</span></p>
              <p><span>Subject</span><b>Your Vesopa code: 482913</b></p>
            </div>
            <div class="mail-body">
              <img src="/brand/logo-light.svg" alt="Vesopa" width="120" height="16">
              <p>Use this code to sign in to your Vesopa account.</p>
              <p class="mail-code">482913</p>
              <p class="mail-muted">This code expires in 10 minutes and can be used once.</p>
              <p class="mail-muted">If you did not ask for this, you can ignore this email. Nobody can get in without the code.</p>
            </div>
            <figcaption>The sign-in code</figcaption>
          </figure>

          <figure class="mail rise">
            <div class="mail-head">
              <p><span>From</span><span>Vesopa &lt;<span class="addr">no-reply@vesopa.com</span>&gt;</span></p>
              <p><span>Subject</span><b>Vesopa security: Your password was changed</b></p>
            </div>
            <div class="mail-body">
              <img src="/brand/logo-light.svg" alt="Vesopa" width="120" height="16">
              <p class="mail-heading">Your password was changed</p>
              <p>Every other device has been signed out.</p>
              <dl class="mail-rows">
                <dt>When</dt><dd>3 Oct 2026, 09:41</dd>
                <dt>Device</dt><dd>Safari on iPhone</dd>
              </dl>
              <p class="mail-muted">If this was you, there is nothing to do. If it was not, change your password and remove the device in your account.</p>
            </div>
            <figcaption>A security notice, sent whenever something changes</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================== products -->
  <section class="band">
    <div class="band-inner">
      <div class="section-art"><%- include('partials/art', { name: 'products' }) %></div>
      <p class="kicker">Products</p>
      <h2>Sign in once, and you are in everywhere</h2>
      <p class="section-lede">
        Vesopa products share one identity. A manager who works the till and the
        back office has one account, not three, and the roles decide what each
        one lets them do.
      </p>

<%
        /*
         * Only products that actually sign in here. Each one is a client in
         * the oauth_clients table (schema/), so the list cannot claim an app
         * that would refuse the account.
         */
        const products = [
          ['till', 'Till', 'Vesopa EPOS', 'The till, with roles for operators, managers and owners.'],
          ['desktop', 'Kitchen + display', 'Kitchen and customer screens', 'The kitchen screen and the customer display, signed in to the same venue as the till.'],
          ['tablet', 'Kiosk', 'Vesopa Express', 'The self-service kiosk your customers order from.'],
          ['menu', 'Table ordering', 'Vesopa Menu', 'The QR menu. A code to a phone or an email address, and they are in.'],
          ['sparkle', 'Loyalty', 'Vesopa Loyalty', 'The loyalty card in the app, with points and rewards that follow the customer.'],
          ['gift', 'Gift cards', 'Vesopa Gift', 'Gift cards bought online and spent at the till.'],
          ['chart', 'Back office', 'Back office', 'Products, prices, staff and reports, with the permissions that decide who may change what.'],
          ['cloud', 'Hosting', 'Vesopa Cloud', 'The hosting control panel, for customers running their sites and mail with Vesopa.'],
        ];
      %>
      <div class="product-grid">
        <% products.forEach(function (item) { %>
        <div class="product">
          <span class="product-icon" aria-hidden="true"><%- include('partials/icon', { name: item[0] }) %></span>
          <span class="product-tag"><%= item[1] %></span>
          <h3><%= item[2] %></h3>
          <p><%= item[3] %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================================ methods -->
  <section class="band alt">
    <div class="band-inner">
      <div class="section-art"><%- include('partials/art', { name: 'security' }) %></div>
      <p class="kicker">Signing in</p>
      <h2>Eight ways in, one account behind them</h2>
      <p class="section-lede">
        However somebody chooses to sign in, they arrive at the same account.
        Add a second way whenever you like — and take one away without losing
        anything.
      </p>

      <ul class="method-grid">
        <li><strong>Email and a code</strong><span>Six digits, ten minutes, one use.</span></li>
        <li><strong>Phone and a code</strong><span>Texted to UK mobiles.</span></li>
        <li><strong>Email and a password</strong><span>Optional, and never required.</span></li>
        <li><strong>Passkey</strong><span>Face, fingerprint or device PIN.</span></li>
        <li><strong>Google</strong><span>Verified addresses only.</span></li>
        <li><strong>Apple</strong><span>Private relay addresses supported.</span></li>
        <li><strong>Microsoft</strong><span>Personal and work accounts.</span></li>
        <li><strong>GitHub</strong><span>Confirmed addresses only.</span></li>
      </ul>
    </div>
  </section>

  <!-- ========================================================= developers -->
  <section class="band">
    <div class="band-inner developer">
      <div>
        <div class="section-art"><%- include('partials/art', { name: 'developers' }) %></div>
        <p class="kicker">Developers</p>
        <h2>Standards, not a bespoke API</h2>
        <p class="section-lede">
          OpenID Connect and OAuth 2.1. Point any certified library at the
          issuer URL and it configures itself — there is nothing of ours for you
          to learn.
        </p>
        <ul class="ticks">
          <li>Authorisation code with PKCE, and refresh tokens that rotate</li>
          <li>RS256 tokens, verifiable against our published JWKS</li>
          <li>Discovery, userinfo, introspection, revocation and logout</li>
          <li>Roles in the token, scoped to your application alone</li>
        </ul>
        <a class="btn btn-quiet btn-auto" href="/docs">Read the documentation</a>
      </div>

      <div class="code-card">
        <div class="code-head"><span class="code-dot"></span>Discovery</div>
        <%
          /*
           * One line, and it scrolls if it must. Split across two with a
           * backslash it is still a valid shell command, but it reads as a
           * broken URL — and a reader who is deciding whether this service is
           * competent should not have to work out that the break is deliberate.
           */
        %>
        <pre><code>curl https://auth.vesopa.com/.well-known/openid-configuration</code></pre>
        <div class="code-head"><span class="code-dot"></span>Exchange a code for tokens</div>
        <pre><code>curl -X POST https://auth.vesopa.com/oauth/token \
  -d grant_type=authorization_code \
  -d code="$CODE" \
  -d code_verifier="$VERIFIER" \
  -d client_id="$CLIENT_ID" \
  -d redirect_uri="$REDIRECT_URI"</code></pre>
      </div>
    </div>
  </section>

  <!-- ============================================================ control -->
  <section class="band alt">
    <div class="band-inner">
      <p class="kicker">Your data</p>
      <h2>Your account is yours</h2>
      <p class="section-lede">
        Everything below is in your account settings, and none of it needs an
        email to support.
      </p>
      <div class="control-grid">
        <div><h3>See every sign-in</h3><p>Successful and failed, with the time, the address it came from and the device. Kept 13 months, then deleted.</p></div>
        <div><h3>Manage your devices</h3><p>See what is signed in, and sign anything out. Remembering a device skips the second step — never the first.</p></div>
        <div><h3>Disconnect any app</h3><p>See what each application can read, and cut it off. Access ends immediately.</p></div>
        <div><h3>Delete your account</h3><p>Yourself, at any time. Your email address and phone number are freed straight away.</p></div>
      </div>
      <a class="btn btn-primary btn-auto" href="/login">Sign in to your account</a>
    </div>
  </section>

  <!-- ============================================================= maker -->
  <section class="band maker">
    <div class="band-inner maker-inner">
      <div>
        <p class="kicker">Made by Vesopa Software</p>
        <h2>The software behind the account</h2>
        <p class="section-lede">
          Tills, kiosks, kitchen screens, loyalty and the websites that go with
          them, built and supported in Wales.
        </p>
      </div>
      <a class="btn btn-quiet btn-auto" href="https://vesopasoftware.com/">Visit vesopasoftware.com</a>
    </div>
  </section>
</main>

<script src="/js/home.js?v=<%= config.version %>"></script>

<%- include('partials/foot') %>
