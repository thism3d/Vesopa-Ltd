<%- include('partials/head') %>

<main class="account">
  <header class="account-head">
    <a class="brand" href="/" aria-label="Vesopa">
      <img class="brand-mark" src="/brand/logo-light.svg" alt="" width="130" height="17" data-logo-light>
      <img class="brand-mark" src="/brand/logo-dark.svg" alt="" width="130" height="17" data-logo-dark>
    </a>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="linklike">Sign out</button>
    </form>
  </header>

  <h1>You are signed in</h1>
  <p class="auth-sub">
    <%= session.display_name || 'Your Vesopa account' %> ·
    <span class="mono"><%= session.user_public_id %></span>
  </p>

  <section class="panel">
    <h2>How you sign in</h2>
    <ul class="rows">
      <% linked.forEach(function (row) { %>
      <li>
        <span class="row-main"><%= row.identifier %></span>
        <span class="row-meta">
          <%= row.type === 'email' ? 'Email' : row.type === 'phone' ? 'Phone' : row.type %><%
          %><%= row.verified_at ? ' · verified' : ' · not verified' %><%
          %><%= row.is_recovery ? ' · recovery only' : '' %>
        </span>
      </li>
      <% }) %>
    </ul>
  </section>

  <section class="panel">
    <h2>Devices you are signed in on</h2>
    <% if (!devices.length) { %>
    <p class="row-meta">No remembered devices.</p>
    <% } %>
    <ul class="rows">
      <% devices.forEach(function (device) { %>
      <li>
        <span class="row-main"><%= device.name || describeDevice(device.user_agent) %></span>
        <span class="row-meta">
          Last seen <%= device.last_seen_at %> · <%= device.last_ip || 'unknown address' %>
        </span>
      </li>
      <% }) %>
    </ul>
  </section>

  <section class="panel">
    <h2>Recent sign-in activity</h2>
    <%
      /*
       * Failures are shown as well as successes, and that is the point of the
       * page: the attempt somebody did not make is the only warning they will
       * get that a password is out there.
       */
    %>
    <ul class="rows">
      <% history.forEach(function (event) { %>
      <li>
        <span class="row-main">
          <%= event.outcome === 'success' ? 'Signed in' : event.outcome === 'failure' ? 'Failed attempt' : 'Code sent' %>
          — <%= event.method.replace('_', ' ') %>
        </span>
        <span class="row-meta">
          <%= event.created_at %> · <%= event.ip || 'unknown address' %><%
          %><%= event.failure_reason ? ' · ' + event.failure_reason.replace(/_/g, ' ') : '' %>
        </span>
      </li>
      <% }) %>
    </ul>
  </section>
</main>

<%- include('partials/foot') %>
