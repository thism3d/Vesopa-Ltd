<%- include('../partials/console-head') %>

<%
  const isPublic = application.client_type === 'spa' || application.client_type === 'native';
  const live = detail.secrets.filter(function (s) { return !s.revoked_at; });
  const machine = detail.grants.includes('client_credentials');
%>

<h1 class="console-title">Credentials &amp; API</h1>
<p class="console-lead">
  <%= application.name %> — what your code presents to prove it is this
  application.
</p>

<% if (shown) { %>
<%
  /*
   * THE ONE MOMENT THIS SECRET IS VISIBLE.
   *
   * It is stored only as an argon2id hash, so it cannot be shown again — and
   * saying so here, above the value rather than below it, is what stops
   * somebody closing the tab and having to mint a second one. The panel is
   * loud on purpose.
   */
%>
<div class="secret-once">
  <h2>Copy this now — it is not shown again</h2>
  <p>
    We store only a hash of it, so there is no way to look it up later. If it is
    lost, mint another and revoke this one.
  </p>
  <div class="copy">
    <code><%= shown %></code>
    <button type="button" class="copy-btn">Copy</button>
  </div>
</div>
<% } %>

<% if (saved) { %>
<div class="status status-good">
  <span class="status-mark"><%- include('../partials/icon', { name: 'check' }) %></span>
  <div><strong>Saved.</strong><p>Live immediately.</p></div>
</div>
<% } %>
<% if (error) { %>
<div class="status status-bad">
  <span class="status-mark"><%- include('../partials/icon', { name: 'alert' }) %></span>
  <div><strong>Not done</strong><p><%= error %></p></div>
</div>
<% } %>

<section class="card">
  <h2 class="card-head">Client id</h2>
  <p class="card-note">Public. It appears in the sign-in URL, and hiding it buys nothing.</p>
  <div class="card-body">
    <div class="copy">
      <code><%= application.client_id %></code>
      <button type="button" class="copy-btn">Copy</button>
    </div>
  </div>
</section>

<% if (isPublic) { %>
<%
  /*
   * The refusal, explained. A developer who came here looking for a secret and
   * found a button missing would assume something is broken; told why, they
   * have learned the thing that keeps their application safe.
   */
%>
<section class="card">
  <h2 class="card-head">This application has no secret, on purpose</h2>
  <div class="card-body">
    <p class="mt-0">
      <%= application.client_type === 'spa' ? 'A single-page app' : 'A desktop or mobile app' %>
      ships everything it contains to whoever runs it. A secret inside one can
      be read out of the bundle with a text editor — so issuing you one would
      only make it look protected.
    </p>
    <p>
      What protects it instead is <b>PKCE</b>, which every client here must use.
      Your app invents a fresh random secret for each sign-in, sends only its
      SHA-256, and proves it at the token endpoint. Nothing long-lived is stored
      in the app at all, so there is nothing to steal.
    </p>
    <p class="mb-0">
      If you need a credential for a background job with no person involved,
      create a separate <b>server-to-server</b> application for it. Splitting
      them is the point: the machine credential then lives only on your server.
    </p>
  </div>
</section>
<% } else { %>

<section class="card">
  <h2 class="card-head">Client secrets</h2>
  <p class="card-note">
    Several may be live at once, and that is how a rotation is done without an
    outage: mint the new one, deploy it, then revoke the old one.
  </p>

  <% if (!detail.secrets.length) { %>
  <div class="empty">
    <span class="empty-mark"><%- include('../partials/icon', { name: 'key' }) %></span>
    <strong>No secret yet</strong>
    <p>This application cannot exchange an authorisation code for a token until it has one.</p>
  </div>
  <% } %>

  <% detail.secrets.forEach(function (row) { %>
  <div class="row">
    <span class="row-mark"><%- include('../partials/icon', { name: 'key' }) %></span>
    <span class="row-lines">
      <span class="row-title">
        <span class="mono">…<%= row.hint %></span>
        <% if (row.label) { %> · <%= row.label %><% } %>
        <% if (row.revoked_at) { %><span class="pill pill-bad">revoked</span><% } %>
      </span>
      <span class="row-sub">
        Created <%= new Date(row.created_at).toISOString().slice(0, 10) %>
        <% if (row.last_used_at) { %>
          · last used <%= new Date(row.last_used_at).toISOString().slice(0, 10) %>
        <% } else if (!row.revoked_at) { %>
          · never used
        <% } %>
      </span>
    </span>
    <span class="row-right">
      <% if (!row.revoked_at && role !== 'viewer') { %>
      <form method="post" action="/developers/a/<%= application.client_id %>/secrets/<%= row.id %>/revoke">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-link">Revoke</button>
      </form>
      <% } %>
    </span>
  </div>
  <% }) %>

  <% if (role !== 'viewer') { %>
  <form method="post" action="/developers/a/<%= application.client_id %>/secrets">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body">
      <div class="inline-form">
        <input type="text" name="label" maxlength="80"
               placeholder="What is it for — &quot;production&quot;, &quot;staging&quot;"
               aria-label="Label for the new secret">
        <button class="btn btn-primary btn-small" type="submit">Mint a secret</button>
      </div>
      <p class="hint mt-2">
        Shown once, on the next screen. <%= live.length %> of 5 live.
      </p>
    </div>
  </form>
  <% } %>
</section>
<% } %>

<%
  /* ------------------------------------------------------------------------
   * Machine-to-machine — "generating the API"
   * ---------------------------------------------------------------------
   * This is what people mean when they ask for an API key. There is no
   * separate key here: the client id and secret ARE the credential, and they
   * are exchanged for a short-lived token. That is better than a static key in
   * one way that matters — a token that leaks expires by itself in ten
   * minutes, and a static key does not.
   * --------------------------------------------------------------------- */
%>
<section class="card">
  <h2 class="card-head">What this application may do</h2>
  <p class="card-note">
    Grant types. Everything interactive is authorisation code with PKCE; there
    is no implicit flow and no password grant, deliberately.
  </p>
  <form method="post" action="/developers/a/<%= application.client_id %>/grants">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%- include('../partials/switch', {
      name: 'grant_type',
      value: 'authorization_code',
      on: detail.grants.includes('authorization_code'),
      icon: 'person',
      title: 'Sign a person in',
      sub: 'authorization_code, with PKCE. The normal flow, and the only interactive one — there is no implicit flow and no password grant here.',
      locked: role === 'viewer',
      why: 'You have read-only access to this application.',
    }) %>

    <%- include('../partials/switch', {
      name: 'grant_type',
      value: 'refresh_token',
      on: detail.grants.includes('refresh_token'),
      icon: 'history',
      title: 'Stay signed in',
      sub: 'refresh_token, rotated on every use. Without it a person is asked again every ten minutes.',
      locked: role === 'viewer',
      why: 'You have read-only access to this application.',
    }) %>

    <%- include('../partials/switch', {
      name: 'grant_type',
      value: 'client_credentials',
      on: machine,
      icon: 'bolt',
      title: 'Act as itself, with no person',
      sub: 'client_credentials — the API-key equivalent. Your server exchanges its secret for a short-lived token.',
      locked: role === 'viewer' || isPublic,
      why: isPublic
        ? 'Not available here: this needs a client secret, and a browser or device app cannot keep one.'
        : 'You have read-only access to this application.',
    }) %>

    <% if (role !== 'viewer') { %>
    <div class="card-body">
      <button class="btn btn-quiet btn-small" type="submit">Save</button>
    </div>
    <% } %>
  </form>
</section>

<% if (machine && !isPublic) { %>
<section class="card">
  <h2 class="card-head">Calling the API as this application</h2>
  <p class="card-note">
    Ask for a token, then send it as a bearer. The token lasts ten minutes; ask
    for another when it expires rather than caching it for ever.
  </p>
  <div class="card-body">
    <pre class="code">curl -s <%= config.issuer %>/oauth/token \
  -d grant_type=client_credentials \
  -d client_id=<%= application.client_id %> \
  -d client_secret=YOUR_SECRET</pre>
    <p class="hint">
      Answers <code>{"access_token":"…","token_type":"Bearer","expires_in":600}</code>.
      Then:
    </p>
    <pre class="code">curl -s <%= config.issuer %>/oauth/introspect \
  -H "Authorization: Bearer $TOKEN"</pre>
    <p class="hint">
      Keep the secret on your server. A credential in a browser bundle, a mobile
      app or a public repository is a credential somebody else has.
    </p>
  </div>
</section>
<% } %>

<%- include('../partials/console-foot') %>
