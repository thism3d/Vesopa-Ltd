<%- include('partials/head') %>

<%
  /*
   * "Would you like a password?" — offered once somebody has signed in without
   * one, and skippable.
   *
   * WHY THIS PAGE EXISTS. Most people meet a Vesopa account through an emailed
   * code or an invitation and never set a password, so every later sign-in
   * costs a trip to an inbox. On a till at seven in the morning that is a real
   * cost, and the people paying it are the ones least able to stop and fix it.
   *
   * WHY IT IS SKIPPABLE. An identity provider that will not let you past until
   * you have chosen a password has decided its own tidiness matters more than
   * the person standing at the counter. "Skip for now" is a real button, the
   * same size as the other one, not a grey link hidden under the fold — and it
   * is remembered, so skipping means skipping rather than being asked again in
   * thirty seconds.
   *
   * THE EYE. Both boxes get one, from public/js/reveal.js, which decorates
   * every input[type="password"] on the page and is already loaded in the
   * footer. Nothing here needs to ask for it — which is exactly why the eye is
   * built there and not in a template.
   */
%>

<main class="signin">
  <a class="signin-mark" href="/" aria-label="Vesopa">
    <img src="/brand/icon-192.png" alt="" width="44" height="44">
  </a>

  <h1 class="signin-hi">Set a password</h1>

  <p class="signin-sub">
    You signed in with a code. Setting a password lets you sign in without one
    next time<% if (application) { %>, including on <b><%= application.name %></b><% } %>.
  </p>

  <div class="form-error" role="alert" aria-live="polite" id="form-error"><%= error || '' %></div>

  <form method="post" action="/login/set-password" class="signin-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="return_to" value="<%= returnTo %>">

    <div class="float-field">
      <input type="password" id="new-password" name="password"
             autocomplete="new-password" placeholder=" "
             minlength="12" autofocus required aria-describedby="form-error password-hint">
      <label for="new-password">New password</label>
    </div>

    <div class="float-field">
      <input type="password" id="confirm-password" name="confirm"
             autocomplete="new-password" placeholder=" "
             minlength="12" required aria-describedby="form-error">
      <label for="confirm-password">Confirm password</label>
    </div>

    <p class="signin-hint" id="password-hint">At least 12 characters.</p>

    <%
      /*
       * Two real buttons, side by side. "Skip for now" submits the same form
       * with a different name so it carries the CSRF token and the return
       * address with it — a plain link would drop both, and dropping the return
       * address is how somebody who skipped ends up on the account page instead
       * of the till they were signing in to.
       */
    %>
    <div class="signin-actions signin-actions-pair">
      <button type="submit" name="action" value="skip" class="btn btn-quiet btn-auto">Skip for now</button>
      <button type="submit" name="action" value="save" class="btn btn-primary btn-auto">Save password</button>
    </div>
  </form>
</main>

<%- include('partials/foot') %>
