<%- include('_shell') %>

<% if (saved) { %><p class="notice-good">Saved.</p><% } %>
<% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

<!-- ---------------------------------------------------------------- Passkeys -->
<section class="panel">
  <h2>Passkeys</h2>
  <p class="row-meta mb-2">
    A passkey signs you in with your fingerprint, face or device PIN — no
    password to remember and nothing to type. It is the most secure option here,
    and the quickest.
  </p>

  <% if (!passkeys.length) { %>
  <p class="row-meta">No passkeys yet.</p>
  <% } else { %>
  <ul class="rows">
    <% passkeys.forEach(function (key) { %>
    <li class="row-with-action">
      <div>
        <span class="row-main"><%= key.name %></span>
        <span class="row-meta">
          Added <%= String(key.created_at).slice(0, 10) %><%
          %><%= key.last_used_at ? ' · last used ' + String(key.last_used_at).slice(0, 10) : ' · never used' %><%
          %><%= key.backup_state ? ' · synced across your devices' : ' · on this device only' %>
        </span>
      </div>
      <form method="post" action="/account/passkeys/<%= key.id %>/remove" data-json>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="linklike">Remove</button>
      </form>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <button class="btn btn-quiet mt-3" type="button" data-add-passkey hidden>
    Add a passkey
  </button>
  <p class="hint" data-passkey-unsupported hidden>
    This browser cannot use passkeys. Try a recent Chrome, Safari, Edge or Firefox.
  </p>
  <p class="form-error" role="alert" data-passkey-error></p>
</section>

<!-- ------------------------------------------------------- Authenticator app -->
<section class="panel">
  <h2>Authenticator app</h2>

  <% if (totp) { %>
  <p class="row-meta">
    On since <%= String(totp.created_at).slice(0, 10) %><%
    %><%= totp.last_used_at ? ', last used ' + String(totp.last_used_at).slice(0, 10) : '' %>.
  </p>
  <form data-totp-disable class="mt-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="disable-code">Enter a current code to turn it off</label>
      <input type="text" id="disable-code" name="code" inputmode="numeric"
             autocomplete="one-time-code" maxlength="6" class="code-input">
    </div>
    <button class="btn btn-quiet" type="submit">Turn off</button>
  </form>
  <% } else { %>
  <p class="row-meta mb-2">
    Use an app like Google Authenticator, 1Password or Authy to generate a
    six-digit code when you sign in.
  </p>
  <button class="btn btn-quiet" type="button" data-totp-start>Set up an authenticator app</button>

  <div data-totp-panel hidden class="mt-3">
    <p class="row-meta">Scan this with your authenticator app:</p>
    <img data-totp-qr alt="QR code for your authenticator app" width="240" height="240"
         class="totp-qr">
    <p class="row-meta">
      Cannot scan it? Type this key instead:<br>
      <span class="mono" data-totp-key></span>
    </p>
    <form data-totp-confirm class="mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="totp-code">Enter the six-digit code it shows</label>
        <input type="text" id="totp-code" name="code" inputmode="numeric"
               autocomplete="one-time-code" maxlength="6" class="code-input">
      </div>
      <button class="btn btn-primary" type="submit">Turn on</button>
    </form>
  </div>
  <% } %>

  <p class="form-error" role="alert" data-totp-error></p>
</section>

<!-- --------------------------------------------------------- Recovery codes -->
<%
  /*
   * Recovery codes are shown ONCE, at the moment they are made. They are stored
   * hashed, so there is no later screen that could show them again — which is
   * why the panel below says how many are left rather than what they are.
   */
%>
<section class="panel" data-recovery-panel>
  <h2>Recovery codes</h2>
  <p class="row-meta">
    <%= recoveryRemaining %> unused code<%= recoveryRemaining === 1 ? '' : 's' %>.
    They are the way back in if you lose your phone. Each works once.
  </p>
  <form data-recovery-new class="mt-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-quiet" type="submit">Generate new codes</button>
  </form>
  <p class="hint">Generating new codes cancels the old ones.</p>
  <div data-recovery-output hidden>
    <p class="notice-good mt-3">
      Save these now — they will not be shown again.
    </p>
    <pre class="codes" data-recovery-list></pre>
  </div>
</section>

<!-- ---------------------------------------------------------------- Password -->
<section class="panel">
  <h2>Password</h2>
  <p class="row-meta mb-2">
    <% if (hasPassword) { %>
      Set on <%= String(passwordSince).slice(0, 10) %>. You can always sign in
      with a code instead.
    <% } else { %>
      You do not have one, and you do not need one — a code to your email or
      phone works every time. Set one if you would rather sign in faster.
    <% } %>
  </p>

  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (hasPassword) { %>
    <div class="field">
      <label for="current_password">Current password</label>
      <input type="password" id="current_password" name="current_password"
             autocomplete="current-password">
    </div>
    <% } %>
    <div class="field">
      <label for="password"><%= hasPassword ? 'New password' : 'Password' %></label>
      <input type="password" id="password" name="password" autocomplete="new-password"
             minlength="12" aria-describedby="password-hint">
      <p class="hint" id="password-hint">
        At least 12 characters. Length beats punctuation — three unrelated words
        is stronger than P@ssw0rd! and far easier to remember.
      </p>
    </div>
    <button class="btn btn-quiet" type="submit">
      <%= hasPassword ? 'Change password' : 'Set a password' %>
    </button>
  </form>
</section>

<section class="panel danger">
  <h2>Delete your account</h2>
  <p class="row-meta">
    This removes your Vesopa account and everything on it.
    <a href="/account/delete">Delete my account</a>.
  </p>
</section>

<script nonce="<%= nonce %>" src="/js/security.js?v=<%= config.version %>"></script>

<%- include('../partials/console-foot') %>
