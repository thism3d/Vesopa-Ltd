<%- include('_shell') %>

<% if (saved) { %><p class="notice-good">Saved.</p><% } %>
<% if (typeof error !== 'undefined' && error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

<%
  /*
   * THE PICTURE IS THE CONTROL — reference_design §6.3, and `…730` where the
   * avatar carries a pencil badge on its corner.
   *
   * What was here before was a raw `<input type=file>` and an Upload button in
   * a non-wrapping flex row, and it was not merely ugly: MEASURED with
   * tool/auth_overflow.py, `.avatar-row` had a min-content width of 357px,
   * which set its panel to 399 and `.console-main` to 431 on a 360px screen.
   * The profile picture control was the reason EVERY account page scrolled
   * sideways on a phone. Rebuilding it fixes both complaints at once.
   *
   * The file input is still a real file input — it is simply the label that is
   * visible, so the picture and the words under it are both the button. No
   * script is needed for it to work.
   */
%>
<section class="panel picture-panel">
  <h2>Profile picture</h2>
  <p class="hint mt-0">A picture helps people recognise your account.</p>

  <form method="post" action="/account/avatar" enctype="multipart/form-data" id="avatar-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="avatar-control" for="avatar">
      <% if (user.avatar_path) { %>
      <img class="avatar" src="<%= user.avatar_path %>" alt="Your profile picture" width="96" height="96">
      <% } else { %>
      <span class="avatar avatar-empty" aria-hidden="true"><%= (user.display_name || 'V').trim().charAt(0).toUpperCase() %></span>
      <% } %>
      <span class="avatar-badge" aria-hidden="true">
        <%- include('../partials/icon', { name: 'person' }) %>
      </span>
      <span class="avatar-cta">Change picture</span>
      <input type="file" id="avatar" name="avatar"
             accept="image/jpeg,image/png,image/webp,image/gif">
    </label>

    <%
      /*
       * THE BUTTON IS ALWAYS HERE, and /js/profile.js hides it once it has
       * bound the change handler that makes it unnecessary.
       *
       * It used to live inside `<noscript>`, with a comment saying the form
       * "submits itself when a file is chosen" — and the script that would have
       * done that was never written. So for everybody with scripting on, which
       * is everybody, choosing a picture selected a file into a hidden input
       * and nothing happened at all. That is the fault the owner reported, and
       * the reason the button is no longer conditional: a control that only
       * exists when a script fails is a control nobody ever tests.
       */
    %>
    <button class="btn btn-quiet btn-small mt-2" type="submit" data-avatar-submit>
      Upload this picture
    </button>
    <p class="form-error" role="alert" data-avatar-error hidden></p>
    <p class="hint">JPEG, PNG, WebP or GIF, up to 2&nbsp;MB.</p>
  </form>

  <% if (user.avatar_path) { %>
  <form method="post" action="/account/avatar/remove">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="linklike">Remove picture</button>
  </form>
  <% } %>
</section>

<form method="post" action="/account/profile" class="panel">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="field">
    <label for="display_name">Display name</label>
    <input type="text" id="display_name" name="display_name"
           value="<%= user.display_name %>" autocomplete="name" maxlength="120">
    <p class="hint">What applications show when they greet you.</p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="given_name">First name</label>
      <input type="text" id="given_name" name="given_name"
             value="<%= user.given_name %>" autocomplete="given-name" maxlength="80">
    </div>
    <div class="field">
      <label for="family_name">Last name</label>
      <input type="text" id="family_name" name="family_name"
             value="<%= user.family_name %>" autocomplete="family-name" maxlength="80">
    </div>
  </div>

  <div class="field">
    <label for="date_of_birth">Date of birth</label>
    <%
      /*
       * A date input, not three dropdowns. It is only shared with an
       * application that asked for the profile scope and that you allowed —
       * said here rather than buried in the privacy policy, because this is
       * the moment somebody is deciding whether to type it.
       */
    %>
    <input type="date" id="date_of_birth" name="date_of_birth"
           value="<%= user.date_of_birth ? String(user.date_of_birth).slice(0, 10) : '' %>"
           autocomplete="bday"
           min="1900-01-01"
           max="<%= new Date().toISOString().slice(0, 10) %>">
    <p class="hint">Only shared with an app that asked for your profile and that you allowed. Leave it blank if you would rather not.</p>
  </div>

  <button class="btn btn-primary" type="submit">Save</button>
</form>

<section class="panel">
  <h2>Your Vesopa id</h2>
  <p class="row-meta">
    <span class="mono"><%= session.user_public_id %></span><br>
    Quote this if you ever write to us about your account. It identifies you and
    is not a secret.
  </p>
</section>

<script src="/js/profile.js?v=<%= config.version %>"></script>
<%- include('../partials/console-foot') %>
