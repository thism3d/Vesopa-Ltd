<%- include('_shell') %>

<% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>

<section class="panel danger">
  <%
    /*
     * Said plainly, including the part people actually want to know: what
     * happens to the email address afterwards. Under the owner's rule an
     * identifier is freed the moment it is revoked, so it can be used on a new
     * account immediately — which is the opposite of what most services do and
     * is worth stating rather than surprising somebody with.
     */
  %>
  <p>Deleting your Vesopa account means:</p>
  <ul class="plain-list">
    <li>You are signed out of every Vesopa product and every connected app.</li>
    <li>Your email address and phone number are freed straight away, so they can be used to make a new account.</li>
    <li>Your profile, passkeys and authenticator app are removed.</li>
    <li>Everything is permanently erased after <%= config.retention.deletedAccountDays %> days.</li>
  </ul>

  <p class="row-meta">
    Anything an individual app holds about you — an order, a booking — belongs to
    that app and has to be asked of them. Write to
    <a href="mailto:privacy@vesopa.com">privacy@vesopa.com</a> if you would like
    help with that.
  </p>

  <form method="post" action="/account/delete" class="mt-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="confirm">Type DELETE to confirm</label>
      <input type="text" id="confirm" name="confirm" autocomplete="off" spellcheck="false">
    </div>
    <button class="btn btn-danger" type="submit">Delete my account</button>
  </form>

  <p class="small-print"><a href="/account/security">Take me back</a></p>
</section>

<%- include('../partials/console-foot') %>
