# auth.vesopa.com — environment
#
# Copy to .env on the server and fill in. The real .env is NEVER committed and
# NEVER uploaded by a deploy: `v-add-nodejs-app` has been known to overwrite one
# with a two-line stub, and a sync in the wrong direction would replace the
# live secrets with these placeholders.
#
# Generate each secret with:
#     openssl rand -hex 32
#
# The application refuses to start in production if any of the four secrets
# below is missing. That is deliberate — running without them would be less
# safe than not running.

NODE_ENV=production
PORT=20003
ISSUER=https://auth.vesopa.com

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopasoftware_authdb
DB_USER=vesopasoftware_authuser
DB_PASSWORD=
DB_POOL=10

# --- Secrets ---------------------------------------------------------------
# CODE_PEPPER      peppers the six-digit codes we email. Without it, a stolen
#                  table of code hashes is reversible by trying all million.
# PASSWORD_PEPPER  a second secret on top of argon2's own salt.
# ENCRYPTION_KEY   AES-256-GCM for TOTP seeds and signing keys. 64 hex chars.
# SUBJECT_PEPPER   salts the pairwise `sub` given to third-party applications.
CODE_PEPPER=
PASSWORD_PEPPER=
ENCRYPTION_KEY=
SUBJECT_PEPPER=

# --- WebAuthn --------------------------------------------------------------
# THE APEX DOMAIN, NOT auth.vesopa.com. A passkey is bound to the relying party
# id it was created under: enrolled against `auth.vesopa.com` it can never be
# used from menu. or cloud., and the only remedy is asking every user to enrol
# again. Changing this after launch invalidates every passkey in existence.
WEBAUTHN_RP_ID=vesopa.com
WEBAUTHN_RP_NAME=Vesopa
WEBAUTHN_ORIGINS=https://auth.vesopa.com

# --- Sessions --------------------------------------------------------------
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=30
SESSION_REMEMBERED_DAYS=30
DEVICE_TRUST_DAYS=30

# --- Mail ------------------------------------------------------------------
# no-reply@vesopa.com and not an address at auth.vesopa.com, because that one is
# already SPF-verified with Apple as a registered sender for the private email
# relay. Changing it means re-registering with Apple first, and until that is
# done Apple silently stops forwarding to relay users.
# The MAIL SERVER'S OWN HOSTNAME, not `localhost`, even though it is the same
# machine. exim offers STARTTLS on port 25 with a certificate for
# panel.vesopa.com, and connecting to `localhost` fails verification with
# "Hostname/IP does not match certificate's altnames" — which reads like a
# broken mail server and is a name mismatch. The alternative, turning
# certificate checking off, is worse for no gain.
#
# No username or password: this is the box's own mail server accepting mail from
# a process running on it.
SMTP_HOST=panel.vesopa.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Vesopa <no-reply@vesopa.com>
MAIL_REPLY_TO=info@vesopasoftware.com

# --- SMS -------------------------------------------------------------------
# Postcoder generates AND verifies the code; we never see it. UK mobiles only.
SMS_PROVIDER=postcoder
POSTCODER_API_KEY=
SMS_COUNTRIES=GB

# --- Administrator ---------------------------------------------------------
ADMIN_EMAIL=info@vesopasoftware.com
ADMIN_PASSWORD=

# --- Social sign-in --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=335a71ee-f200-4cb3-9965-dafc3ab0e01b
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

GITHUB_CLIENT_ID=Iv23liLFFlwUqny92CKX
GITHUB_CLIENT_SECRET=

# Apple signs its client secret as a JWT with the .p8 key, which expires and
# has to be re-minted — at most six months, so it is generated at boot rather
# than pasted here.
APPLE_TEAM_ID=G238FR2ZC9
APPLE_SERVICE_ID=com.vesopa.auth
APPLE_KEY_ID=UX5DVJ787G
APPLE_PRIVATE_KEY_PATH=/home/vesopasoftware/web/auth.vesopa.com/private/keys/AuthKey_UX5DVJ787G.p8
