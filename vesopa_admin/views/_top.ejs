<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= locals.title ? title + ' · ' : '' %>Vesopa Admin</title>
<meta name="description" content="One place to run every Vesopa app, venue and licence.">
<meta name="theme-color" content="#000000">
<meta property="og:site_name" content="Vesopa Admin">
<meta property="og:title" content="<%= locals.title ? title + ' · ' : '' %>Vesopa Admin">
<meta property="og:description" content="One place to run every Vesopa app, venue and licence.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://admin.vesopa.com/">
<meta property="og:image" content="https://admin.vesopa.com/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://admin.vesopa.com/og.png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="stylesheet" href="/admin.css">
<script src="/admin.js" defer></script>
</head>
<body>
<% if (locals.me) { %>
<div class="frame">
  <aside class="rail" id="rail">
    <a class="brand" href="/"><img class="mark" src="/vesopa-mark.svg" alt="" width="30" height="30"><span>vesopa <b>admin</b></span></a>
    <nav>
      <% const nav = [
        ['/', 'Overview', 'licences.view', null],
        ['/venues', 'Venues', 'licences.view', 'epos'],
        ['/catalogue', 'Catalogue', 'licences.view', 'epos'],
        ['/hosting', 'Cloud hosting', 'licences.view', 'hosting'],
        ['/subscriptions', 'Subscriptions', 'licences.view', null],
        ['/downloads', 'Downloads', 'releases.download', null],
        ['/fleet', 'Fleet', 'versions.manage', 'epos'],
        ['/server', 'Server', 'versions.manage', 'epos'],
        ['/versions', 'Versions', 'versions.manage', 'epos'],
        ['/audit', 'Audit log', 'audit.view', null],
        ['/admins', 'Admins', 'admins.manage', null],
      ]; %>
      <% for (const [href, text, perm, app] of nav) { if (!can(perm, app)) continue; const on = href === '/' ? path === '/' : path.startsWith(href); %>
        <a href="<%= href %>" class="<%= on ? 'on' : '' %>"><%= text %></a>
      <% } %>
    </nav>
    <div class="soon">
      <span>Coming next</span>
      <p>People, sign in as a venue, then billing.</p>
    </div>
    <form class="me" method="post" action="/signout">
      <div><b><%= me.name %></b><small><%= me.roleLabel %><%= me.apps === '*' ? '' : ' · ' + me.apps.map((a) => roles.APPS[a]).join(', ') %></small></div>
      <span class="me-actions">
        <button class="link" type="submit" name="switch" value="1">Switch account</button>
        <button class="link" type="submit">Sign out</button>
      </span>
    </form>
  </aside>
  <main class="main">
    <header class="top">
      <button class="menu" type="button" data-toggle="rail" aria-label="Menu">☰</button>
      <h1><%= locals.title || 'Admin' %></h1>
      <form class="search" method="get" action="/venues"><input name="q" placeholder="Find a venue…" aria-label="Find a venue" value="<%= locals.q || '' %>"></form>
    </header>
    <% if (locals.flash) { %><div class="flash <%= flash.kind %>"><%= flash.text %></div><% } %>
<% } else { %>
<div class="lone">
<% } %>
