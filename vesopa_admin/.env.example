# admin.vesopa.com — copy to .env on the server and fill in. Never commit .env.

NODE_ENV=production
# Its own port, under its own name: pm2's daemon carries PORT=20003 (Auth's)
# and dotenv never overrides it. 5085 is Metric's, 5090 vesopasoftware.com's.
ADMIN_PORT=5095
BASE_URL=https://admin.vesopa.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_admindb
DB_USER=
DB_PASSWORD=

# Connect with Vesopa. An application in Auth (Developers) for admin.vesopa.com,
# redirect URI https://admin.vesopa.com/callback, scopes openid profile email.
# Who gets in is decided HERE (the admins table), not by Auth roles.
VESOPA_AUTH_ISSUER=https://auth.vesopa.com
VESOPA_AUTH_CLIENT_ID=
VESOPA_AUTH_CLIENT_SECRET=

# The owner of everything. Always Owner, cannot be removed or demoted.
OWNER_EMAIL=info@vesopasoftware.com

# The back office (vesopa_server). The same value as ADMIN_SERVICE_KEY there.
EPOS_API=http://127.0.0.1:5060
EPOS_SERVICE_KEY=

# Vesopa Gift. The same value as ADMIN_SERVICE_KEY in vesopa_gift's .env.
GIFT_API=http://127.0.0.1:5070
GIFT_SERVICE_KEY=

# Vesopa Cloud hosting. The same value as ADMIN_SERVICE_KEY in vesopa_hosting.
HOSTING_API=http://127.0.0.1:5075
HOSTING_SERVICE_KEY=

# Mail, through the box's relay (SMTP2GO). The From domain must be verified there.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Vesopa <no-reply@vesopa.com>
