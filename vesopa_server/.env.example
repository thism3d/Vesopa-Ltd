# Copy to .env and fill in. .env is gitignored — never commit real credentials.
PORT=4000
NODE_ENV=develpment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_eposdb
DB_USER=
DB_PASSWORD=
# Signs back-office sessions. Generate with: openssl rand -hex 32
JWT_SECRET=
# Dojo sandbox key
DOJO_API_KEY=

# Dojo webhook signing secrets, one per environment.
#
# Dojo issues a "secret value" alongside each webhook subscription in the
# developer portal, and signs every delivery with an HMAC over the raw body.
# Sandbox and live are separate subscriptions with separate secrets, which is
# why the endpoint carries the environment in its path:
#
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/sandbox
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/live
#
# Leave one blank and that environment's endpoint fails closed — it answers 401
# and records nothing, rather than accepting unverified events. The boot log
# says which environments are configured.
DOJO_WEBHOOK_SECRET_SANDBOX=
DOJO_WEBHOOK_SECRET_LIVE=

# Outbound mail — used by "Forgot password" only. Leave SMTP_HOST or
# SMTP_PASSWORD blank and the server still boots and sells; it logs the reset
# link to the console instead of emailing it, which is what you want locally.
# These are the same values vesopa_web uses.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Vesopa EPOS
MAIL_FROM=support@vesopaepos.com

# Base URL the emailed reset link points at. Without it the link is built from
# the request's own host, which is wrong behind a proxy.
BACKOFFICE_URL=

# ---------------------------------------------------------------------------
# Google Wallet passes (loyalty, customer, staff and promotional cards).
#
# Leave these blank and the server still boots and sells; the wallet routes
# answer 503 with a list of what is missing, and /api/wallet/status renders the
# setup screen in the back office rather than failing.
#
# The issuer number from the Google Pay & Wallet Console. Vesopa's is
# 3388000000023197382. This is Vesopa's, not the merchant's — every venue's
# passes are issued under it, separated by class.
GOOGLE_WALLET_ISSUER_ID=

# The service account that signs passes. Create it in the Google Cloud project
# that has the Google Wallet API enabled, download its JSON key, then — and
# this is the step everyone misses — add the service-account address under
# Users in the Wallet Console for the issuer above, with at least Developer
# access. Without that, every call answers 403 and nothing says why.
#
# Either point at the JSON key file:
GOOGLE_WALLET_SA_FILE=
# ...or paste the two fields out of it. The file wins if both are set.
GOOGLE_WALLET_SA_EMAIL=
# The PEM, with literal \n between lines if your process manager cannot carry
# real newlines in a variable.
GOOGLE_WALLET_SA_KEY=

# The sites an "Add to Google Wallet" button may appear on. Google checks this
# against the page that opened the save link, so a missing origin presents as
# the link working when pasted into a browser and failing from the page.
GOOGLE_WALLET_ORIGINS=https://backoffice.vesopaepos.com

# DRAFT | UNDER_REVIEW | APPROVED. New classes start as DRAFT and are visible
# only to accounts on the issuer's test list. Move to UNDER_REVIEW to submit
# them for publishing access; Google sets APPROVED itself and it should not be
# claimed here.
GOOGLE_WALLET_REVIEW_STATUS=UNDER_REVIEW


# ---------------------------------------------------------------------------
# Apple Wallet
# ---------------------------------------------------------------------------
# Signing a .pkpass needs three things: the pass type certificate, its private
# key, and Apple's WWDR intermediate. Only the first is in this repository --
# passes_and_oauth/ holds the five public .cer files, which identify a pass type
# and cannot sign anything.
#
# A .pkpass that fails to install gives no diagnostic at all. iOS says "Safari
# cannot download this file" whatever is wrong with it, so the back office's
# Wallet page checks each of these and names the one that is missing.

# A directory holding the signing key, exported from Keychain Access on the Mac
# that generated the CSR.
#
# ONE FILE IS ENOUGH. All five certificates were issued from a single CSR, so
# they share one private key -- export any one certificate together with its key
# and save it as:
#
#     vesopa_wallet.p12
#
# The certificate for each pass type is taken from passes_and_oauth/, which is
# committed, and the key is paired with it. The two are checked against each
# other before anything is signed, because a mismatch produces a pass that
# installs on nothing and reports nothing.
#
# Per-type bundles are still honoured and take precedence, should the keys ever
# diverge:
#
#     loyalty_pass.p12   membership_pass.p12   giftcard_pass.p12
#     staffcard_pass.p12 promotion_pass.p12
#
# Neither the .cer files nor a CSR can sign: a .cer is the public half, and a
# CSR is spent the moment Apple issues from it.
#
# A directory rather than five variables of base64: a private key in an
# environment variable ends up in `ps`, in a crash report and in a process dump,
# and rotating one means a redeploy. This can be mode 0600, owned by the service
# user, and swapped without touching the app.
APPLE_WALLET_DIR=/etc/vesopa/apple-wallet

# The passphrase those .p12 files were exported with. One passphrase for all
# five, because they are exported together in one operation.
APPLE_WALLET_P12_PASSWORD=

# Apple's WWDR intermediate certificate, in PEM. Fetched from Apple at build
# time -- https://www.apple.com/certificateauthority/ -- and not committed,
# because it expires and a stale copy in git outlives the day somebody notices.
APPLE_WWDR_CERT=/etc/vesopa/apple-wallet/wwdr.pem

# Where a pass checks for its own updates. Optional, and the two halves of it
# are all-or-nothing: Apple ignores webServiceURL without authenticationToken,
# so leaving this blank writes neither and a pass is a snapshot that refreshes
# when the customer scans the code again.
#
# The update endpoints and the APNs client are not built yet. Setting this
# before they are produces passes that ask a URL which answers 404, so leave it
# empty until they exist.
APPLE_WALLET_WEB_SERVICE_URL=

# The team the certificates were issued to. Defaults to G238FR2ZC9, which is
# what passes_and_oauth/README.md records; set it only if that ever changes.
APPLE_TEAM_ID=
