# Copy to .env and fill in. .env is gitignored — never commit real credentials.
PORT=4000
NODE_ENV=develpment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_eposdb
DB_USER=
DB_PASSWORD=
# Signs back-office sessions. Generate with: openssl rand -hex 32
JWT_SECRET=
# Dojo sandbox key
DOJO_API_KEY=

# Dojo webhook signing secrets, one per environment.
#
# Dojo issues a "secret value" alongside each webhook subscription in the
# developer portal, and signs every delivery with an HMAC over the raw body.
# Sandbox and live are separate subscriptions with separate secrets, which is
# why the endpoint carries the environment in its path:
#
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/sandbox
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/live
#
# Leave one blank and that environment's endpoint fails closed — it answers 401
# and records nothing, rather than accepting unverified events. The boot log
# says which environments are configured.
DOJO_WEBHOOK_SECRET_SANDBOX=
DOJO_WEBHOOK_SECRET_LIVE=

# Outbound mail — used by "Forgot password" only. Leave SMTP_HOST or
# SMTP_PASSWORD blank and the server still boots and sells; it logs the reset
# link to the console instead of emailing it, which is what you want locally.
# These are the same values vesopa_web uses.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Vesopa EPOS
MAIL_FROM=support@vesopaepos.com

# Base URL the emailed reset link points at. Without it the link is built from
# the request's own host, which is wrong behind a proxy.
BACKOFFICE_URL=
