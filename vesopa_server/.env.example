# Copy to .env and fill in. .env is gitignored — never commit real credentials.
PORT=4000
NODE_ENV=develpment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_eposdb
DB_USER=
DB_PASSWORD=
# Signs back-office sessions. Generate with: openssl rand -hex 32
JWT_SECRET=
# Dojo sandbox key
DOJO_API_KEY=

# Dojo webhook signing secrets, one per environment.
#
# Dojo issues a "secret value" alongside each webhook subscription in the
# developer portal, and signs every delivery with an HMAC over the raw body.
# Sandbox and live are separate subscriptions with separate secrets, which is
# why the endpoint carries the environment in its path:
#
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/sandbox
#   https://backoffice.vesopaepos.com/api/webhooks/dojo/live
#
# Leave one blank and that environment's endpoint fails closed — it answers 401
# and records nothing, rather than accepting unverified events. The boot log
# says which environments are configured.
DOJO_WEBHOOK_SECRET_SANDBOX=
DOJO_WEBHOOK_SECRET_LIVE=

# Outbound mail — used by "Forgot password" only. Leave SMTP_HOST or
# SMTP_PASSWORD blank and the server still boots and sells; it logs the reset
# link to the console instead of emailing it, which is what you want locally.
# These are the same values vesopa_web uses.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Vesopa EPOS
MAIL_FROM=support@vesopaepos.com

# Base URL the emailed reset link points at. Without it the link is built from
# the request's own host, which is wrong behind a proxy.
BACKOFFICE_URL=

# ---------------------------------------------------------------------------
# Google Wallet passes (loyalty, customer, staff and promotional cards).
#
# Leave these blank and the server still boots and sells; the wallet routes
# answer 503 with a list of what is missing, and /api/wallet/status renders the
# setup screen in the back office rather than failing.
#
# The issuer number from the Google Pay & Wallet Console. Vesopa's is
# 3388000000023197382. This is Vesopa's, not the merchant's — every venue's
# passes are issued under it, separated by class.
GOOGLE_WALLET_ISSUER_ID=

# The service account that signs passes. Create it in the Google Cloud project
# that has the Google Wallet API enabled, download its JSON key, then — and
# this is the step everyone misses — add the service-account address under
# Users in the Wallet Console for the issuer above, with at least Developer
# access. Without that, every call answers 403 and nothing says why.
#
# Either point at the JSON key file:
GOOGLE_WALLET_SA_FILE=
# ...or paste the two fields out of it. The file wins if both are set.
GOOGLE_WALLET_SA_EMAIL=
# The PEM, with literal \n between lines if your process manager cannot carry
# real newlines in a variable.
GOOGLE_WALLET_SA_KEY=

# The sites an "Add to Google Wallet" button may appear on. Google checks this
# against the page that opened the save link, so a missing origin presents as
# the link working when pasted into a browser and failing from the page.
GOOGLE_WALLET_ORIGINS=https://backoffice.vesopaepos.com

# DRAFT | UNDER_REVIEW | APPROVED. New classes start as DRAFT and are visible
# only to accounts on the issuer's test list. Move to UNDER_REVIEW to submit
# them for publishing access; Google sets APPROVED itself and it should not be
# claimed here.
GOOGLE_WALLET_REVIEW_STATUS=UNDER_REVIEW
