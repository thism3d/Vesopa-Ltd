# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it contains a secret credential.

# From Partner Center > Account settings > Organization profile > Tenant details
MS_STORE_TENANT_ID=

# From Partner Center > Account settings > Users > Azure AD applications
# (the Azure AD app must be granted the "Manager" role in Partner Center)
MS_STORE_CLIENT_ID=
MS_STORE_CLIENT_SECRET=

# Public Store IDs for each app (Partner Center > App identity). All three were
# confirmed against GET /v1.0/my/applications, so they need no editing.
VESOPA_EPOS_STORE_ID=9PDMNJXNFZCW
VESOPA_KITCHEN_STORE_ID=9P29NN3R5PGS
VESOPA_DISPLAY_STORE_ID=9P8JCLQ5M3SQ
