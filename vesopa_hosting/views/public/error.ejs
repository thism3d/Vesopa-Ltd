<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
<section class="section" style="padding:96px 0 110px">
  <div class="wrap center" style="max-width:560px">
    <div style="font-size:clamp(4.5rem,14vw,8rem);font-weight:900;letter-spacing:-.06em;line-height:1;color:var(--lime)" data-reveal="0">
      <%= code %>
    </div>
    <h1 class="h1 mt-2 mb-2" data-reveal="60"><%= heading %></h1>
    <p class="lede mb-3" data-reveal="100"><%= message %></p>
    <div class="row" style="justify-content:center" data-reveal="140">
      <a class="btn" href="/">Back to the homepage</a>
      <a class="btn btn-ghost" href="/support">Get help</a>
    </div>
  </div>
</section>
</main>
<%- include('../partials/footer') %>
