<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">

<section class="hero" style="padding:64px 0 74px">
  <div class="hero-aura hero-aura-1"></div>
  <div class="hero-grid"></div>
  <div class="wrap hero-inner">
    <p class="kicker" data-reveal="0" style="justify-content:center"><%= t('Shared hosting') %></p>
    <h1 class="display" style="font-size:clamp(2.1rem,5vw,3.4rem)" data-reveal="60">
      <%- th('Fast UK hosting,<br><span class="hl">priced honestly</span>') %>
    </h1>
    <p class="lede hero-lede" data-reveal="120">
      <%= t('NVMe storage, free SSL, email and backups on every plan. The renewal price is the signup price — always.') %>
    </p>
  </div>
</section>

<section class="section" id="plans">
  <div class="wrap">
    <div class="center" data-reveal="0">
      <div class="term-toggle" data-term-toggle role="group" aria-label="<%= t('Billing term') %>">
        <span class="term-pill" aria-hidden="true"></span>
        <% terms.forEach(function (term) { %>
          <button type="button" class="term-btn <%= term.months === 12 ? 'is-active' : '' %>"
                  data-term="<%= term.months %>" aria-pressed="<%= term.months === 12 %>">
            <%= termLabel(term) %>
            <% if (term.maxSaving > 0) { %><span class="term-save">−<%= term.maxSaving %>%</span><% } %>
          </button>
        <% }); %>
      </div>
    </div>

    <div class="plans">
      <% plans.forEach(function (plan, i) { %>
        <div class="plan <%= plan.badge ? 'plan-featured' : '' %>" data-reveal="<%= i * 90 %>">
          <%# dbT(): a plan's own words are typed by an admin, so they have a
              Bangla twin column rather than a catalogue entry. %>
          <% if (plan.badge) { %><span class="plan-badge"><%= dbT(plan, 'badge') %></span><% } %>
          <h2 class="plan-name"><%= dbT(plan, 'name') %></h2>
          <p class="plan-tagline"><%= dbT(plan, 'tagline') %></p>

          <% terms.forEach(function (term) { %>
            <div data-price-for="<%= term.months %>" <%= term.months === 12 ? '' : 'hidden' %>>
              <div class="plan-was">
                <% if (plan.saving[term.months] > 0) { %><s><%= money(plan.monthly_pence) %></s> save <%= plan.saving[term.months] %>%<% } else { %>&nbsp;<% } %>
              </div>
              <div class="plan-price">
                <span class="cur"><%= moneyParts(plan.perMonthPence[term.months]).symbol %></span>
                <span class="amt"><%= moneyParts(plan.perMonthPence[term.months]).whole %></span>
                <span class="frac">.<%= moneyParts(plan.perMonthPence[term.months]).frac %></span>
                <span class="per"><%= t('/month') %></span>
              </div>
              <p class="plan-term-note">
                <% if (term.months === 1) { %><%= t('Billed monthly. Cancel any time.') %>
                <% } else { %><%= t('{price} for {term}, renews at the same price.', { price: money(plan.price[term.months]), term: termLabel(term) }) %><% } %>
              </p>
            </div>
          <% }); %>

          <div class="plan-cta">
            <a class="btn btn-block <%= plan.badge ? '' : 'btn-dark' %>" data-buy-link
               href="/order/<%= plan.slug %>?term=12"><%= t('Choose {plan}', { plan: dbT(plan, 'name') }) %></a>
          </div>

          <div class="plan-spec">
            <div><b><%= num(plan.websites) %></b><span><%= tn('Website', 'Websites', plan.websites) %></span></div>
            <div><b><%= t('{v} GB', { v: num(plan.storage_gb) }) %></b><span><%= t('NVMe storage') %></span></div>
            <div><b><%= plan.databases %></b><span>Databases</span></div>
            <div><b><%= num(plan.mailboxes) %></b><span><%= t('Mailboxes') %></span></div>
          </div>

          <ul class="plan-features">
            <% dbList(plan, 'features').forEach(function (f) { %>
              <li><%- icon('check', 16) %><span><%= f %></span></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    </div>

    <p class="center small muted mt-3">
      <%= t('Prices exclude VAT at {v}%. A free domain is included on 12-month terms and above for .co.uk, .uk and .com.', { v: num(vatPercent) }) %>
    </p>
  </div>
</section>

<!-- Comparison table -->
<section class="section section-tint" id="compare">
  <div class="wrap">
    <div class="center mb-4">
      <p class="kicker" data-reveal="0" style="justify-content:center"><%= t('Side by side') %></p>
      <h2 class="h1 mt-2" data-reveal="60"><%= t('What is different between the plans') %></h2>
    </div>

    <div class="card card-flush" data-reveal="100">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th style="min-width:190px"><%= t('Feature') %></th>
              <% plans.forEach(function (p) { %>
                <th class="center"><%= dbT(p, 'name') %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <%
            const rows = [
              [t('Websites'),       (p) => num(p.websites)],
              [t('NVMe storage'),   (p) => t('{v} GB', { v: num(p.storage_gb) })],
              [t('Bandwidth'),      (p) => (p.bandwidth_gb === 0 ? t('Unmetered') : t('{v} GB', { v: num(p.bandwidth_gb) }))],
              [t('Databases'),      (p) => num(p.databases)],
              [t('Mailboxes'),      (p) => num(p.mailboxes)],
              [t('Free SSL'),       (p) => p.free_ssl ? true : false],
              [t('Free domain (12m+)'), (p) => p.free_domain ? true : false],
              [t('Daily backups'),  (p) => (p.daily_backups ? true : t('Weekly'))],
              [t('Priority support'), (p) => p.priority_support ? true : false],
            ];
            rows.forEach(function (r) { %>
              <tr>
                <td class="strong"><%= r[0] %></td>
                <% plans.forEach(function (p) {
                     const v = r[1](p); %>
                  <td class="center">
                    <% if (v === true) { %>
                      <span style="color:var(--lime-ink)"><%- icon('check', 19) %></span>
                    <% } else if (v === false) { %>
                      <span style="color:#c3c6b8"><%- icon('x', 17) %></span>
                    <% } else { %>
                      <span class="strong"><%= v %></span>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
            <tr>
              <td></td>
              <% plans.forEach(function (p) { %>
                <td class="center">
                  <a class="btn btn-sm <%= p.badge ? '' : 'btn-ghost' %>" href="/order/<%= p.slug %>?term=12"><%= t('Choose') %></a>
                </td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Stack -->
<section class="section">
  <div class="wrap">
    <div class="center mb-4">
      <p class="kicker" data-reveal="0" style="justify-content:center"><%= t('Under the bonnet') %></p>
      <h2 class="h1 mt-2" data-reveal="60"><%= t('What you are actually running on') %></h2>
    </div>
    <div class="grid grid-4">
      <%
      const stack = [
        ['server', 'Ubuntu 24.04 LTS', t('Long-term support to 2029, patched on a schedule rather than when something breaks.')],
        ['bolt',   'NVMe SSD',         t('Not SATA marketed as "SSD". Database-heavy sites feel this the most.')],
        ['shield', 'Isolated accounts',t('Every account is a separate system user. A neighbour being compromised is not your problem.')],
        ['globe',  'HTTP/2 + Brotli',  t('Modern transport and compression on by default, no configuration needed.')],
      ];
      stack.forEach(function (s, i) { %>
        <article class="card card-hover" data-reveal="<%= i * 70 %>">
          <div class="f-icon"><%- icon(s[0], 22) %></div>
          <h3 class="h3 mb-1"><%= s[1] %></h3>
          <p class="small muted mb-0"><%= s[2] %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="wrap center">
    <h2 class="h1 mb-2" data-reveal="0"><%= t('Not sure which plan?') %></h2>
    <p class="lede mb-3" data-reveal="60" style="max-width:52ch;margin-inline:auto">
      <%= t('Start on Business. It is the one that fits almost everybody, and moving up or down later takes one click and costs only the difference.') %>
    </p>
    <div class="row" style="justify-content:center" data-reveal="100">
      <a class="btn btn-lg" href="/order/business?term=12"><%= t('Start with Business') %></a>
      <a class="btn btn-ghost btn-lg" style="border-color:#3a3a35;color:#fff" href="/contact"><%= t('Ask us') %></a>
    </div>
  </div>
</section>

</main>
<%- include('../partials/footer') %>
