<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/admin-shell', { pageTitle: 'Domains', pageSub: total + ' under management' }) %>

<div class="p-card p-card-flush">
  <div class="table-wrap"><table class="table mini">
    <thead><tr><th>Domain</th><th>Customer</th><th>Status</th><th>Points here</th><th>Expires</th><th>Auto-renew</th><th>Registrar ref</th></tr></thead>
    <tbody>
      <% if (!domains.length) { %><tr><td colspan="7"><p class="muted mb-0" style="padding:20px 0">Nothing yet.</p></td></tr><% } %>
      <% domains.forEach(function (d) {
           const days = d.expires_at ? Math.round((new Date(d.expires_at) - Date.now()) / 864e5) : null;
           const grace = d.ns_grace_until ? Math.ceil((new Date(d.ns_grace_until) - Date.now()) / 864e5) : null; %>
        <tr>
          <td class="strong">
            <%= d.domain %>
            <% if (d.source === 'external') { %><br><span class="tiny muted">registered elsewhere</span><% } %>
          </td>
          <td><a href="/admin/customers/<%= d.customer_id %>"><%= d.email %></a></td>
          <td>
            <% if (d.status === 'active') { %><span class="badge badge-green">Active</span>
            <% } else if (d.status === 'expired') { %><span class="badge badge-red">Expired</span>
            <% } else if (d.status === 'awaiting_ns') { %><span class="badge badge-amber">Awaiting NS</span>
            <% } else if (d.status === 'removed') { %><span class="badge badge-grey">Removed</span>
            <% } else { %><span class="badge badge-grey"><%= d.status %></span><% } %>
          </td>
          <%#
            The nameserver check, which is the first thing to look at when a
            customer says their site or their certificate is not working.
          %>
          <td>
            <% if (d.ns_verified_at) { %>
              <span class="badge badge-green">Yes</span>
            <% } else { %>
              <span class="badge badge-amber">No</span>
              <% if (grace !== null && d.status === 'awaiting_ns') { %>
                <br><span class="tiny muted"><%= grace > 0 ? grace + 'd grace' : 'due to drop' %></span>
              <% } %>
              <% if (d.ns_observed) { %><br><span class="tiny mono muted"><%= d.ns_observed %></span><% } %>
            <% } %>
          </td>
          <td>
            <%= d.expires_at || '—' %>
            <% if (days !== null && days <= 45 && days > 0) { %><br><span class="badge badge-amber"><%= days %> days</span><% } %>
          </td>
          <td><%- d.auto_renew ? '<span class="badge badge-soft">On</span>' : '<span class="badge badge-red">Off</span>' %></td>
          <td class="tiny mono muted"><%= d.registrar_ref || '—' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<%- include('../partials/pager', { base: '/admin/domains' }) %>
<%- include('../partials/panel-shell-end') %>
