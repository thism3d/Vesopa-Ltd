<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/admin-shell', { pageTitle: 'Domain pricing', pageSub: 'What we charge in ' + currency.code + ', and what it costs us.' }) %>

<div class="alert alert-info">
  <%- icon('info', 19) %>
  <div>
    <b>Cost</b> is what DomainNameAPI charges us, converted from their dollar
    rate card at the USD rate in Admin → Currencies. It is never shown to a
    customer — it is here so the margin is visible while you are setting the
    price, rather than worked out on a calculator afterwards.
    Re-import the rate card with <code>node scripts/import-tlds.js</code>.
  </div>
</div>

<% if (tally.loss) { %>
  <%# The single most important thing this screen can tell an admin. Eleven
      extensions were selling below cost after the rate card landed, and
      without this banner they would stay that way indefinitely. %>
  <div class="alert alert-error">
    <%- icon('warning', 19) %>
    <div>
      <b><%= tally.loss %> extension<%= tally.loss === 1 ? ' is' : 's are' %> priced below cost.</b>
      Every sale of one loses money.
      <a href="/admin/tlds?show=loss"><b>Show them</b></a> — you can reprice the
      whole list from the markup ladder in one click.
    </div>
  </div>
<% } %>

<%# --- Filters ----------------------------------------------------------- %>
<form method="get" action="/admin/tlds" class="p-card mb-3">
  <div class="row" style="gap:10px;flex-wrap:wrap;align-items:flex-end">
    <div class="field mb-0" style="flex:1 1 190px">
      <label class="label" for="fq">Find an extension</label>
      <input class="input" id="fq" name="q" value="<%= filters.q %>" placeholder="shop, co.uk, io">
    </div>
    <div class="field mb-0" style="flex:0 1 200px">
      <label class="label" for="fcat">Category</label>
      <select class="input select" id="fcat" name="category">
        <option value="">All categories</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c.slug %>" <%= filters.category === c.slug ? 'selected' : '' %>><%= c.label %></option>
        <% }); %>
      </select>
    </div>
    <div class="field mb-0" style="flex:0 1 190px">
      <label class="label" for="fshow">Show</label>
      <select class="input select" id="fshow" name="show">
        <option value="">Everything (<%= tally.all %>)</option>
        <option value="loss" <%= filters.show === 'loss' ? 'selected' : '' %>>Below cost (<%= tally.loss %>)</option>
        <option value="featured" <%= filters.show === 'featured' ? 'selected' : '' %>>Popular (<%= tally.featured %>)</option>
        <option value="inactive" <%= filters.show === 'inactive' ? 'selected' : '' %>>Switched off (<%= tally.inactive %>)</option>
        <option value="nocost" <%= filters.show === 'nocost' ? 'selected' : '' %>>No cost recorded (<%= tally.nocost %>)</option>
      </select>
    </div>
    <button class="btn btn-sm" type="submit">Filter</button>
    <% if (filters.q || filters.category || filters.show) { %>
      <a class="btn btn-sm btn-ghost" href="/admin/tlds">Clear</a>
    <% } %>
  </div>
</form>

<p class="small muted mb-2">
  <b><%= matchedCount %></b> extension<%= matchedCount === 1 ? '' : 's' %> match.
  Showing <%= tlds.length %> — page <%= page %> of <%= pages %>.
  <span class="muted">Saving affects only the rows on this page.</span>
</p>

<form method="post" action="/admin/tlds" data-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%# The filter state rides along so the redirect after saving comes back
      here rather than to page 1 of everything. %>
  <input type="hidden" name="f_q" value="<%= filters.q %>">
  <input type="hidden" name="f_category" value="<%= filters.category %>">
  <input type="hidden" name="f_show" value="<%= filters.show %>">
  <input type="hidden" name="f_page" value="<%= page %>">

  <div class="p-card p-card-flush">
    <div class="table-wrap"><table class="table mini">
      <thead>
        <tr>
          <th>Extension</th>
          <th>Category</th>
          <th class="num">Register <%= currency.symbol %></th>
          <th class="num">Renew <%= currency.symbol %></th>
          <th class="num">Transfer <%= currency.symbol %></th>
          <th class="num">Cost <%= currency.symbol %></th>
          <th class="num">Margin</th>
          <th class="center">Popular</th>
          <th class="center">Active</th>
        </tr>
      </thead>
      <tbody>
        <% tlds.forEach(function (t) {
             const margin = t.register_pence - t.cost_pence;
             const pct = t.cost_pence ? Math.round(margin / t.cost_pence * 100) : null;
             const loss = t.register_pence > 0 && t.register_pence < t.cost_pence;
             const suggested = suggest(t.cost_pence); %>
          <tr<%= loss ? ' style="background:#fdf0ee"' : '' %>>
            <td class="strong">
              .<%= t.tld %>
              <input type="hidden" name="id" value="<%= t.id %>">
              <br><a class="tiny muted" href="/domains/tld/<%= encodeURIComponent(t.tld) %>" target="_blank" rel="noopener">view page</a>
            </td>
            <td>
              <select class="input select" style="width:126px;padding:6px 8px;font-size:.8rem" name="category">
                <% categories.forEach(function (c) { %>
                  <option value="<%= c.slug %>" <%= (t.category || 'other') === c.slug ? 'selected' : '' %>><%= c.label %></option>
                <% }); %>
              </select>
            </td>
            <td>
              <input class="input" style="width:92px;padding:7px 9px" name="register" value="<%= (t.register_pence/100).toFixed(2) %>">
              <% if (suggested && suggested !== t.register_pence) { %>
                <br><span class="tiny muted" title="What the markup ladder would charge">→ <%= (suggested/100).toFixed(2) %></span>
              <% } %>
            </td>
            <td><input class="input" style="width:92px;padding:7px 9px" name="renew" value="<%= (t.renew_pence/100).toFixed(2) %>"></td>
            <td><input class="input" style="width:92px;padding:7px 9px" name="transfer" value="<%= (t.transfer_pence/100).toFixed(2) %>"></td>
            <td><input class="input" style="width:92px;padding:7px 9px" name="cost" value="<%= (t.cost_pence/100).toFixed(2) %>"></td>
            <td class="num">
              <% if (pct === null) { %><span class="muted tiny">—</span>
              <% } else { %>
                <span class="strong" style="color:<%= margin > 0 ? 'var(--lime-ink)' : 'var(--red)' %>"><%= money(margin) %></span>
                <br><span class="tiny muted"><%= pct %>%</span>
              <% } %>
            </td>
            <td class="center"><input type="checkbox" name="featured" value="<%= t.id %>" <%= t.featured ? 'checked' : '' %>></td>
            <td class="center"><input type="checkbox" name="active" value="<%= t.id %>" <%= t.active ? 'checked' : '' %>></td>
          </tr>
        <% }); %>
        <% if (!tlds.length) { %>
          <tr><td colspan="9" class="center muted" style="padding:26px">Nothing matches that filter.</td></tr>
        <% } %>
      </tbody>
    </table></div>
  </div>

  <div class="row mt-2" style="gap:10px;flex-wrap:wrap;align-items:center">
    <button class="btn" type="submit" data-busy="Saving…">Save this page</button>

    <%# The bulk action shares the form, so it posts the same ids and the same
        filter state. `formaction` is what lets one form have two destinations
        without a second copy of every hidden field. %>
    <button class="btn btn-ghost" type="submit" formaction="/admin/tlds/reprice"
            data-confirm="Reprice all <%= tlds.length %> extensions on this page from the markup ladder? Prices you have set by hand will be overwritten.">
      <%- icon('bolt', 16) %> Reprice this page from cost
    </button>
  </div>
</form>

<% if (pages > 1) { %>
  <%
  // Build a page link that keeps the filters. Written once here rather than
  // three times inline.
  const pageHref = function (n) {
    const p = new URLSearchParams();
    if (filters.q) p.set('q', filters.q);
    if (filters.category) p.set('category', filters.category);
    if (filters.show) p.set('show', filters.show);
    p.set('page', n);
    return '/admin/tlds?' + p.toString();
  };
  %>
  <div class="row mt-3" style="gap:8px;flex-wrap:wrap;align-items:center">
    <% if (page > 1) { %><a class="btn btn-sm btn-ghost" href="<%= pageHref(page - 1) %>">← Previous</a><% } %>
    <span class="small muted">Page <%= page %> of <%= pages %></span>
    <% if (page < pages) { %><a class="btn btn-sm btn-ghost" href="<%= pageHref(page + 1) %>">Next →</a><% } %>
  </div>
<% } %>

<%# Per-currency domain prices.

    One tab per currency rather than the side-by-side matrix used on a plan:
    there are forty-odd extensions and four money columns, and twelve columns
    across a table that already scrolls sideways is not a page anyone can edit
    without losing their place. %>
<% if (currencies.length) { %>
  <div class="p-card mt-3">
    <h2 class="h3 mb-1">Prices in other currencies</h2>
    <p class="small muted mb-3">
      Blank is <b>converted</b> from the <%= currency.code %> column above and
      moves with the rate. Type a figure to fix it. Worth doing on the
      extensions whose wholesale cost is quoted to us in dollars — those do not
      move with the pound, and a converted price on one of them drifts away from
      its margin every time the rate changes.
    </p>

    <div class="row mb-3" style="gap:8px;flex-wrap:wrap">
      <% currencies.forEach(function (c) { %>
        <a class="btn btn-sm <%= overrideCurrency && overrideCurrency.code === c.code ? '' : 'btn-ghost' %>"
           href="/admin/tlds?currency=<%= c.code %>"><%= c.symbol %> <%= c.code %></a>
      <% }); %>
      <% if (overrideCurrency) { %>
        <a class="btn btn-sm btn-ghost" href="/admin/tlds">Close</a>
      <% } %>
    </div>

    <% if (overrideCurrency) { %>
      <form method="post" action="/admin/prices/tld-bulk" data-guard>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="currency" value="<%= overrideCurrency.code %>">
        <div class="table-wrap"><table class="table mini">
          <thead>
            <tr>
              <th>Extension</th>
              <th class="num">Register <%= overrideCurrency.symbol %></th>
              <th class="num">Renew <%= overrideCurrency.symbol %></th>
              <th class="num">Transfer <%= overrideCurrency.symbol %></th>
            </tr>
          </thead>
          <tbody>
            <% overrideRows.forEach(function (r) { %>
              <tr>
                <td class="strong">
                  .<%= r.tld %>
                  <input type="hidden" name="id" value="<%= r.id %>">
                </td>
                <% ['register', 'renew', 'transfer'].forEach(function (f) { %>
                  <td class="num">
                    <input class="input input-sm num" name="o_<%= f %>"
                           style="width:96px"
                           value="<%= r[f].override_minor === null ? '' : (r[f].override_minor / 100).toFixed(2) %>"
                           placeholder="<%= (r[f].converted_minor / 100).toFixed(2) %>"
                           aria-label=".<%= r.tld %> <%= f %> in <%= overrideCurrency.code %>">
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
        <button class="btn mt-2" type="submit" data-busy="Saving…">
          Save <%= overrideCurrency.code %> prices
        </button>
      </form>
    <% } else { %>
      <p class="small muted mb-0">Pick a currency above to set fixed prices in it.</p>
    <% } %>
  </div>
<% } %>

<div class="p-card mt-3" style="max-width:640px">
  <h2 class="h3 mb-3">Add an extension</h2>
  <form method="post" action="/admin/tlds/new" data-guard>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="p-grid p-grid-tld">
      <div class="field mb-0"><label class="label" for="tld">Extension</label><input class="input" id="tld" name="tld" placeholder="wales" required></div>
      <div class="field mb-0"><label class="label" for="nreg">Register</label><input class="input" id="nreg" name="register" value="0.00"></div>
      <div class="field mb-0"><label class="label" for="nren">Renew</label><input class="input" id="nren" name="renew" value="0.00"></div>
      <div class="field mb-0"><label class="label" for="ntra">Transfer</label><input class="input" id="ntra" name="transfer" value="0.00"></div>
      <div class="field mb-0"><label class="label" for="ncost">Cost</label><input class="input" id="ncost" name="cost" value="0.00"></div>
    </div>
    <button class="btn btn-sm mt-3" type="submit">Add</button>
  </form>
</div>

<%- include('../partials/panel-shell-end') %>
