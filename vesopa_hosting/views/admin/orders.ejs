<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/admin-shell', { pageTitle: 'Orders', pageSub: total + ' in total' }) %>

<div class="row mb-3" style="gap:8px">
  <a class="btn btn-sm <%= !status ? '' : 'btn-ghost' %>" href="/admin/orders">All</a>
  <% ['pending','paid','provisioning','active','cancelled'].forEach(function (s) { %>
    <a class="btn btn-sm <%= status === s ? '' : 'btn-ghost' %>" href="/admin/orders?status=<%= s %>"><%= s %></a>
  <% }); %>
</div>

<div class="p-card p-card-flush">
  <div class="table-wrap"><table class="table mini">
    <thead><tr><th>Ref</th><th>Customer</th><th>Date</th><th>Status</th><th class="num">Total</th></tr></thead>
    <tbody>
      <% if (!orders.length) { %><tr><td colspan="5"><p class="muted mb-0" style="padding:20px 0">No orders.</p></td></tr><% } %>
      <% orders.forEach(function (o) { %>
        <tr>
          <td><a class="mono strong" href="/admin/orders/<%= o.id %>"><%= o.reference %></a></td>
          <td><a href="/admin/customers/<%= o.customer_id %>"><%= o.first_name %> <%= o.last_name %></a><br><span class="tiny muted"><%= o.email %></span></td>
          <td class="tiny muted"><%= new Date(o.created_at).toLocaleDateString('en-GB') %></td>
          <td>
            <% if (o.status === 'pending') { %><span class="badge badge-amber">Awaiting payment</span>
            <% } else if (o.status === 'active') { %><span class="badge badge-green">Complete</span>
            <% } else if (o.status === 'provisioning') { %><span class="badge badge-red">Needs attention</span>
            <% } else { %><span class="badge badge-grey"><%= o.status %></span><% } %>
          </td>
          <td class="num strong"><%= money(o.total_pence, o.currency) %><% if (o.currency !== currency.code) { %> <span class="tiny muted"><%= o.currency %></span><% } %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<%- include('../partials/pager', { base: '/admin/orders' + (status ? '?status=' + status : '') }) %>
<%- include('../partials/panel-shell-end') %>
<%- include('../partials/footer') %>
