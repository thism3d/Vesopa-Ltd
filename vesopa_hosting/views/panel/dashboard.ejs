<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/panel-shell', {
  pageTitle: 'Hello, ' + (customer.first_name || 'there'),
  pageSub: 'Everything you have with us, at a glance.',
}) %>

<% if (unpaid.length) { %>
  <div class="alert alert-warn">
    <%- icon('warning', 19) %>
    <div>
      <b>You have <%= unpaid.length %> order<%= unpaid.length > 1 ? 's' : '' %> awaiting payment.</b>
      Services go live as soon as payment clears.
      <a href="/panel/billing">View billing</a>
    </div>
  </div>
<% } %>

<% if (expiringSoon.length) { %>
  <div class="alert alert-error">
    <%- icon('clock', 19) %>
    <div>
      <b><%= expiringSoon.length %> domain<%= expiringSoon.length > 1 ? 's expire' : ' expires' %> soon.</b>
      <% expiringSoon.slice(0, 3).forEach(function (d) { %>
        <a href="/panel/domains/<%= d.id %>"><%= d.domain %></a> (<%= d.expires_at %>)<%= ' ' %>
      <% }); %>
    </div>
  </div>
<% } %>

<div class="p-grid p-grid-3 mb-3">
  <a class="tile" href="/panel/services">
    <div class="tile-label">Websites</div>
    <div class="tile-value"><%= services.filter(function (s) { return s.status === 'active'; }).length %></div>
    <div class="tile-note"><%= services.length %> hosting <%= services.length === 1 ? 'account' : 'accounts' %></div>
  </a>
  <a class="tile" href="/panel/domains">
    <div class="tile-label">Domains</div>
    <div class="tile-value"><%= domains.length %></div>
    <div class="tile-note"><%= domains.filter(function (d) { return d.status === 'active'; }).length %> active</div>
  </a>
  <a class="tile" href="/panel/tickets">
    <div class="tile-label">Open tickets</div>
    <div class="tile-value"><%= openTickets.length %></div>
    <div class="tile-note"><%= openTickets.length ? 'Awaiting a reply' : 'Nothing outstanding' %></div>
  </a>
</div>

<div class="p-grid p-grid-side">
  <div>
    <div class="p-card p-card-flush">
      <div class="p-card-head">
        <h2>Your websites</h2>
        <a class="btn btn-ghost btn-sm" href="/hosting"><%- icon('plus', 15) %> Add hosting</a>
      </div>
      <% if (!services.length) { %>
        <div class="empty">
          <%- icon('server', 46) %>
          <h3>No hosting yet</h3>
          <p>Pick a plan and you can be online this afternoon.</p>
          <a class="btn mt-2" href="/hosting">See plans</a>
        </div>
      <% } else { %>
        <% services.forEach(function (s) { %>
          <a class="item" href="/panel/services/<%= s.id %>">
            <span class="item-icon"><%- icon('globe', 19) %></span>
            <span class="item-main">
              <span class="item-title"><%= s.primary_domain || 'No domain set' %></span>
              <span class="item-sub"><%= s.plan_name %><% if (s.next_due_at) { %> · renews <%= s.next_due_at %><% } %></span>
            </span>
            <span class="item-end">
              <% if (s.status === 'active') { %><span class="badge badge-green"><span class="dot dot-live"></span> Live</span>
              <% } else if (s.status === 'pending') { %><span class="badge badge-amber">Setting up</span>
              <% } else if (s.status === 'suspended') { %><span class="badge badge-red">Suspended</span>
              <% } else { %><span class="badge badge-grey"><%= s.status %></span><% } %>
            </span>
          </a>
        <% }); %>
      <% } %>
    </div>

    <div class="p-card p-card-flush">
      <div class="p-card-head">
        <h2>Your domains</h2>
        <a class="btn btn-ghost btn-sm" href="/domains"><%- icon('search', 15) %> Find a domain</a>
      </div>
      <% if (!domains.length) { %>
        <div class="empty">
          <%- icon('globe', 46) %>
          <h3>No domains yet</h3>
          <p>Register one here, or point one you already own at your hosting.</p>
          <a class="btn mt-2" href="/domains">Search a domain</a>
        </div>
      <% } else { %>
        <% domains.slice(0, 8).forEach(function (d) { %>
          <a class="item" href="/panel/domains/<%= d.id %>">
            <span class="item-icon"><%- icon('globe', 19) %></span>
            <span class="item-main">
              <span class="item-title"><%= d.domain %></span>
              <span class="item-sub">
                <% if (d.expires_at) { %>Expires <%= d.expires_at %><% } else { %>Registering…<% } %>
                <% if (d.auto_renew) { %> · auto-renew on<% } %>
              </span>
            </span>
            <span class="item-end">
              <% if (d.status === 'active') { %><span class="badge badge-green">Active</span>
              <% } else if (d.status === 'pending') { %><span class="badge badge-amber">Pending</span>
              <% } else { %><span class="badge badge-grey"><%= d.status %></span><% } %>
            </span>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>

  <aside>
    <div class="p-card">
      <div class="f-icon"><%- icon('rocket', 22) %></div>
      <h2 class="h3 mb-2">Moving a site to us?</h2>
      <p class="small muted mb-2">
        Send us your current hosting login and we will copy everything across,
        free. You check it on a preview address before anything switches.
      </p>
      <a class="btn btn-sm btn-block" href="/panel/tickets/new?subject=Migration">Request a migration</a>
    </div>

    <div class="p-card">
      <h2 class="h3 mb-2">Your nameservers</h2>
      <p class="small muted mb-2">Point a domain here to host it with us.</p>
      <% nameservers.forEach(function (ns) { %>
        <div class="copyable">
          <span><%= ns %></span>
          <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= ns %>">Copy</button>
        </div>
      <% }); %>
    </div>

    <div class="p-card">
      <h2 class="h3 mb-2">Need a hand?</h2>
      <p class="small muted mb-2">A ticket from here arrives with your account attached, which is faster than email.</p>
      <a class="btn btn-ghost btn-sm btn-block" href="/panel/tickets/new">Open a ticket</a>
    </div>
  </aside>
</div>

<%- include('../partials/panel-shell-end') %>
<%- include('../partials/footer') %>
