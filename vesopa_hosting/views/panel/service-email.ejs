<% const pageIcon = 'mail'; %>
<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/panel-shell', {
  pageTitle: service.primary_domain || service.plan_name,
  pageSub: 'Email',
}) %>

<%- include('../partials/service-tabs', { tab: 'email' }) %>

<% if (error) { %>
  <div class="alert alert-warn">
    <%- icon('warning', 19) %>
    <div><b>We could not reach the hosting node.</b> Your site is unaffected — only this list is unavailable. <span class="muted">(<%= error %>)</span></div>
  </div>
<% } %>
<% if (!hestiaLive) { %>
  <div class="alert alert-info">
    <%- icon('info', 19) %>
    <div><b>Demonstration mode.</b> This terminal is not connected to a live hosting node yet, so nothing is listed here.</div>
  </div>
<% } %>

<div class="p-grid p-grid-side">
  <div>
    <div class="p-card p-card-flush">
      <div class="p-card-head">
        <h2>Mailboxes</h2>
        <% if (quota && quota.used !== null) { %>
          <span class="small muted"><%= quota.used %> of <%= quota.total %> used</span>
        <% } %>
      </div>
      <div class="p-card-body">
        <p class="small muted mb-0">Mailboxes at your own domain. Use them in webmail, or set them up in Outlook or Apple Mail with the settings below.</p>
      </div>

      <% if (!items.length) { %>
        <div class="empty">
          <%- icon(pageIcon, 46) %>
          <h3>Nothing here yet</h3>
          <p>
            <% if (service.status !== 'active') { %>
              This account is not live yet.
            <% } else { %>
              Create your first mailbox on the right — <span class="mono">you@<%= service.primary_domain || 'yourdomain' %></span> takes about ten seconds.
            <% } %>
          </p>
        </div>
      <% } else { %>
        <% items.forEach(function (it) { %>
          <div class="item">
            <span class="item-icon"><%- icon(pageIcon, 19) %></span>
            <span class="item-main">
              <span class="item-title"><%= it.address || it.account %></span>
              <span class="item-sub">
                <% if (it.used_mb !== undefined) { %><%= it.used_mb %> MB used<% } %>
                <% if (it.quota_mb) { %> of <%= it.quota_mb %> MB<% } %>
              </span>
            </span>
            <span class="item-end">
              <form method="post" action="/panel/services/<%= service.id %>/email/delete"
                    data-confirm="Delete <%= it.address || it.account %>? Every message in it is deleted with it, and we cannot get them back.">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="account" value="<%= it.account %>">
                <input type="hidden" name="domain" value="<%= (it.address || '').split('@')[1] || service.primary_domain %>">
                <button class="btn-link" type="submit">Delete</button>
              </form>
            </span>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <aside>
    <div class="p-card">
      <h2 class="h3 mb-2">Create a mailbox</h2>

      <% if (!quota || !quota.total) { %>
        <p class="small muted mb-2">
          Mailboxes come with a hosting plan, or with a business email plan. Neither is
          active on this account yet.
        </p>
        <a class="btn btn-sm btn-block" href="/email">See email plans</a>
      <% } else if (service.status !== 'active') { %>
        <p class="small muted mb-0">This hosting account goes live as soon as its setup finishes. Mailboxes can be created then.</p>
      <% } else if (!mailDomains.length) { %>
        <p class="small muted mb-2">
          A mailbox lives at a domain, and none of yours is pointing at us yet. Once a
          domain's nameservers point here we can accept mail for it.
        </p>
        <a class="btn btn-sm btn-block" href="/panel/domains">Your domains</a>
      <% } else if (quota.full) { %>
        <p class="small muted mb-2">
          You are using all <%= quota.total %> mailbox<%= quota.total === 1 ? '' : 'es' %> on this account.
          Add a business email plan for more, or free one up by deleting a mailbox you no longer need.
        </p>
        <a class="btn btn-sm btn-block" href="/email">Add mailboxes</a>
      <% } else { %>
        <form method="post" action="/panel/services/<%= service.id %>/email" data-guard>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label class="label" for="account">Address</label>
            <div class="row" style="gap:6px;flex-wrap:nowrap;align-items:center">
              <input class="input mono" id="account" name="account" required placeholder="hello"
                     autocomplete="off" spellcheck="false">
              <span class="muted">@</span>
              <select class="select" name="domain" aria-label="Domain">
                <% mailDomains.forEach(function (d) { %>
                  <option value="<%= d.domain %>" <%= d.domain === service.primary_domain ? 'selected' : '' %>><%= d.domain %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="field">
            <label class="label" for="password">Password</label>
            <input class="input" id="password" name="password" type="password" required
                   autocomplete="new-password">
            <p class="hint">This is the password for the mailbox itself — what you will type into Outlook or webmail. It is not your Vesopa password.</p>
          </div>
          <button class="btn btn-block" type="submit" data-busy="Creating…">Create mailbox</button>
        </form>
      <% } %>
    </div>

    <% if (quota && quota.total) { %>
      <div class="p-card">
        <h2 class="h3 mb-2">Your allowance</h2>
        <div class="table-wrap"><table class="table" style="font-size:.86rem">
          <tbody>
            <% quota.sources.forEach(function (s) { %>
              <tr><td class="muted"><%= s.label %></td><td class="strong"><%= s.count %></td></tr>
            <% }); %>
            <tr><td class="muted">Total</td><td class="strong"><%= quota.total %></td></tr>
            <% if (quota.used !== null) { %>
              <tr><td class="muted">In use</td><td class="strong"><%= quota.used %></td></tr>
              <tr><td class="muted">Left</td><td class="strong"><%= quota.remaining %></td></tr>
            <% } %>
          </tbody>
        </table></div>
        <p class="small muted mt-2 mb-0">
          Mailboxes included with a hosting plan are free for as long as the plan runs.
          Need more than your plan includes? A business email plan adds them by the mailbox.
        </p>
      </div>
    <% } %>

    <div class="p-card">
      <h2 class="h3 mb-2">Connect a mail app</h2>
      <div class="table-wrap"><table class="table" style="font-size:.82rem">
        <tbody>
          <tr><td class="muted">IMAP</td><td class="strong mono">mail.<%= service.primary_domain || 'yourdomain' %> · 993 · SSL</td></tr>
          <tr><td class="muted">SMTP</td><td class="strong mono">mail.<%= service.primary_domain || 'yourdomain' %> · 465 · SSL</td></tr>
          <tr><td class="muted">Username</td><td class="strong">Your full email address</td></tr>
        </tbody>
      </table></div>
    </div>
  </aside>
</div>

<%- include('../partials/panel-shell-end') %>
