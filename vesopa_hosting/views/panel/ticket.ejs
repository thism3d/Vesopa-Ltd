<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/panel-shell', {
  pageTitle: ticket.subject,
  pageSub: ticket.reference + ' · ' + ticket.department + ' · ' + ticket.priority + ' priority',
}) %>

<div class="p-card">
  <% messages.forEach(function (m) { %>
    <div class="msg <%= m.author === 'staff' ? 'msg-staff' : '' %>">
      <span class="msg-avatar"><%= (m.author_name || (m.author === 'staff' ? 'Vesopa' : '?')).charAt(0).toUpperCase() %></span>
      <div class="msg-body">
        <div class="msg-meta">
          <b><%= m.author === 'staff' ? (m.author_name || 'Vesopa Cloud') : m.author_name %></b>
          · <%= new Date(m.created_at).toLocaleString('en-GB') %>
        </div>
        <div class="msg-text"><%= m.body %></div>
      </div>
    </div>
  <% }); %>
</div>

<div class="p-card">
  <h2 class="h3 mb-2"><%= ticket.status === 'closed' ? 'Reply and reopen' : 'Reply' %></h2>
  <form method="post" action="/panel/tickets/<%= ticket.id %>/reply" data-guard>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <textarea class="textarea" name="body" required placeholder="Type your reply…"></textarea>
    </div>
    <button class="btn" type="submit" data-busy="Sending…">Send reply</button>
  </form>
</div>

<a class="btn btn-ghost btn-sm" href="/panel/tickets">← All tickets</a>

<%- include('../partials/panel-shell-end') %>
