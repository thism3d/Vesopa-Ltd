<%- include('../partials/head', { nativeNav: true, sections: false, extraCss: '/assets/css/setup.css' }) %>

<%#
  Onboarding is deliberately full-bleed: no rail, no nav, no footer links.
  The customer has one job on this screen and every other door is a way to
  abandon it half-finished. The only way out is the logo.
%>
<main id="main" class="setup">
  <div class="setup-aura"></div>

  <header class="setup-top">
    <a class="brand" href="/panel" aria-label="<%= t('Vesopa Cloud') %>">
      <%- include('../partials/brand', { on: 'dark', size: 22 }) %>
      <span class="brand-sub" style="color:#7d8570;border-color:#2a2e22">Setup</span>
    </a>
    <span class="tiny" style="color:#7d8570">Order <b class="mono" style="color:#cfd4c4"><%= order.reference %></b></span>
  </header>

  <div class="setup-wrap">

    <%# ------------------------------------------------------------------
        The three-stage rail. Always visible, so the customer can see how
        much is left rather than guessing.
        ------------------------------------------------------------------ %>
    <ol class="setup-rail" aria-label="<%= t('Setup progress') %>">
      <%
      // "Your domain" is the free-domain question a HOSTING plan asks. An order
      // with no hosting never reaches it, so it is not drawn as a step still to
      // come — a domain on its own is Payment, then Registering, then done.
      const k = buys.kind;
      const buildLabel = k === 'domain' ? t('Registering') : k === 'email' ? t('Setting up') : t('Building');
      const buildIcon = k === 'domain' ? 'globe' : k === 'email' ? 'mail' : 'rocket';
      const stages = buys.hosting
        ? [['pay', t('Payment'), 'card'], ['domain', t('Your domain'), 'globe'], ['provisioning', buildLabel, buildIcon]]
        : [['pay', t('Payment'), 'card'], ['provisioning', buildLabel, buildIcon]];
      const order_ = stages.map(function (s) { return s[0]; });
      const at = order_.indexOf(state);
      stages.forEach(function (s, i) {
        const cls = i < at ? 'is-done' : i === at ? 'is-now' : '';
      %>
        <li class="setup-rail-item <%= cls %>">
          <span class="setup-rail-mark"><%- i < at ? icon('check', 15) : icon(s[2], 15) %></span>
          <span class="setup-rail-label"><%= s[1] %></span>
        </li>
      <% }); %>
    </ol>

    <% if (state === 'pay') { %>
      <%# ---------------------------------------------------------------
          Awaiting payment. No gateway is wired yet, so this is honest
          about what happens next rather than showing a fake card form.
          --------------------------------------------------------------- %>
      <section class="setup-card">
        <div class="setup-icon setup-icon-amber"><%- icon('card', 26) %></div>
        <h1 class="h1 mb-2"><%= t('One step left — payment') %></h1>
        <p class="lede mb-3">
          <%= t('Your order is reserved. Nothing is set up and nothing is registered until it is paid, and the moment it clears this page carries straight on to the rest of your setup.') %>
        </p>

        <div class="setup-summary">
          <% items.forEach(function (it) { %>
            <div class="row-between">
              <span class="small"><%= it.description %></span>
              <span class="small strong"><%= it.total_pence === 0 ? 'Free' : money(it.total_pence, order.currency) %></span>
            </div>
          <% }); %>
          <hr class="divider" style="margin:14px 0">
          <div class="row-between">
            <span class="strong">Total</span>
            <span class="strong" style="font-size:1.2rem"><%= money(order.total_pence, order.currency) %></span>
          </div>
        </div>

        <% if (isFree) { %>
          <%# Zero total. Nothing to send to a gateway; one button finishes it. %>
          <form method="post" action="/pay/<%= order.id %>/start" class="mt-3">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-lg" type="submit" data-busy="Confirming…">
              <%= t('Confirm — nothing to pay') %>
            </button>
          </form>

        <% } else if (canPayOnline) { %>
          <%#
            The retry path. A customer who cancelled at the gateway, or whose
            card was declined, lands back here — and the one thing that screen
            must have is a way to try again without rebuilding the basket.
          %>
          <form method="post" action="/pay/<%= order.id %>/start" class="setup-pay mt-3">
            <input type="hidden" name="_csrf" value="<%= csrf %>">

            <% if (gateways.filter(function (g) { return g.available; }).length > 1) { %>
              <div class="paypick mb-3">
                <% gateways.forEach(function (g) { %>
                  <label class="paypick-opt <%= g.available ? '' : 'is-off' %>">
                    <input type="radio" name="gateway" value="<%= g.id %>"
                           <%= g.id === selectedGateway ? 'checked' : '' %>
                           <%= g.available ? '' : 'disabled' %>>
                    <span class="paypick-body">
                      <img class="paypick-logo" src="<%= g.logo %>" alt="<%= g.name %>" width="200" height="48">
                      <span class="paypick-note"><%= g.blurb %><% if (g.note) { %> <b class="paypick-tag"><%= g.note %></b><% } %></span>
                      <%#
                        The settlement-currency warning belongs to the ONE
                        gateway it is true of.

                        It used to sit under the whole form, so a customer who
                        picked Stripe, PayPal or crypto — all of which take the
                        invoice currency directly — was told they would be
                        charged in taka. Attached to the option instead, it is
                        read by exactly the people it applies to, and it needs
                        no script to follow the radio button.
                      %>
                      <% if (g.id === 'sslcommerz' && chargeQuote) { %>
                        <span class="paypick-note tiny muted">
                          Charged as <b><%= chargeQuote.display %></b>, which is what this
                          gateway settles in. Your invoice stays in <%= order.currency %>.
                        </span>
                      <% } %>
                    </span>
                    <span class="paypick-tick"><%- icon('check', 15) %></span>
                  </label>
                <% }); %>
              </div>
            <% } else { %>
              <input type="hidden" name="gateway" value="<%= selectedGateway %>">
            <% } %>

            <button class="btn btn-lg" type="submit" data-busy="Taking you to payment…">
              Pay <%= money(order.total_pence, order.currency) %> <%- icon('arrow', 17) %>
            </button>

            <%#
              When the picker is not shown there is only one gateway on offer,
              and the customer never chose it — so if that one happens to be
              the one that settles elsewhere, the warning still has to appear.
            %>
            <% if (chargeQuote && selectedGateway === 'sslcommerz'
                   && gateways.filter(function (g) { return g.available; }).length <= 1) { %>
              <p class="tiny muted mt-2 mb-0">
                Charged as <b><%= chargeQuote.display %></b>, which is what this gateway
                settles in. Your invoice stays in <%= order.currency %>.
              </p>
            <% } %>
          </form>

          <p class="small muted mt-3 mb-0">
            <%- icon('lock', 14) %>
            <%= t("Paid on the gateway's own secure page. Nothing is set up and nothing is registered until the payment clears.") %>
          </p>

        <% } else { %>
          <div class="alert alert-warn mt-3" style="text-align:left">
            <%- icon('clock', 19) %>
            <div>
              <p class="mb-0">
                <%- th('<b>Card payment is not switched on yet.</b> We have emailed you and will send payment details shortly — usually within the hour during working days. This page will move on by itself once the payment is recorded.') %>
              </p>
            </div>
          </div>
          <div class="row mt-3" style="justify-content:center">
            <a class="btn btn-lg" href="/contact"><%= t('Arrange payment') %></a>
          </div>
        <% } %>

        <div class="row mt-3" style="justify-content:center">
          <a class="btn btn-ghost" href="/panel"><%= t('Go to my account') %></a>
        </div>
      </section>

    <% } else if (state === 'domain') { %>
      <%# ---------------------------------------------------------------
          The free domain. Offered only when the entitlement is genuinely
          unspent — the server decides, this template only renders it.
          --------------------------------------------------------------- %>
      <section class="setup-card setup-card-wide" data-setup-domain>
        <% if (service && service.free_domain_eligible && !service.free_domain_claimed) { %>
          <div class="setup-icon"><%- icon('star', 26) %></div>
          <h1 class="h1 mb-2"><%= t('Your free domain is waiting') %></h1>
          <p class="lede mb-3">
            Your <b><%= service.plan_name %></b> plan includes one domain free
            for the first year — any extension up to <b><%= freeMax %></b>.
            Find the one you want and it is registered as part of your setup.
          </p>

          <form class="dsearch dsearch-light" data-free-search
                style="max-width:100%;margin-bottom:8px">
            <div class="dsearch-form">
              <input class="dsearch-input" type="text" name="q" autocomplete="off"
                     spellcheck="false" placeholder="<%= t('Try your business name…') %>"
                     aria-label="<%= t('Search for your free domain') %>">
              <button class="btn" type="submit"><%- icon('search', 18) %><span class="hide-sm"><%= t('Search') %></span></button>
            </div>
          </form>

          <p class="tiny muted mb-3">
            Included:
            <% freeTlds.slice(0, 8).forEach(function (row, i) { %><%= i ? ' · ' : '' %>.<%= row.tld %><% }); %>
          </p>

          <div data-free-results hidden></div>

          <form method="post" action="/panel/setup/<%= order.id %>/domain" data-guard hidden data-free-claim>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="choice" value="free">
            <input type="hidden" name="domain" value="">
          </form>

          <hr class="divider">
        <% } else { %>
          <div class="setup-icon"><%- icon('globe', 26) %></div>
          <h1 class="h1 mb-2"><%= t('Which domain is this for?') %></h1>
          <p class="lede mb-3">
            <%= t('Tell us the address your site will live at. You can change it later, and you can skip this entirely — your account works either way.') %>
          </p>
        <% } %>

        <div class="setup-alt">
          <form method="post" action="/panel/setup/<%= order.id %>/domain" data-guard>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="choice" value="existing">
            <label class="label" for="existing_domain"><%= t('I already own a domain') %></label>
            <div class="row" style="gap:8px;flex-wrap:nowrap">
              <input class="input" id="existing_domain" name="existing_domain"
                     placeholder="<%= t('yourbusiness.co.uk') %>" autocomplete="off" spellcheck="false">
              <button class="btn btn-ghost" type="submit" style="flex:none"><%= t('Use this') %></button>
            </div>
            <p class="hint">
              <%= t('We will show you the two nameservers to paste at your current registrar. Your site, mailboxes and certificate are built the moment the domain points at us.') %>
            </p>
          </form>

          <form method="post" action="/panel/setup/<%= order.id %>/domain" data-guard style="margin-top:14px">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="choice" value="later">
            <button class="btn-link" type="submit"><%= t('Skip for now — I will decide later') %></button>
          </form>
        </div>
      </section>

    <% } else { %>
      <%# ---------------------------------------------------------------
          Building. The page starts the work, then watches it.

          The words follow what was BOUGHT (buys, from routes/setup.js). A
          domain on its own is registered, not "set up as hosting": its title,
          icon, finish message and buttons all say domain, and done is done.
          The finish messages live here rather than in setup.js so they are
          translated like everything else on the page.
          --------------------------------------------------------------- %>
      <%
        const k = buys.kind;
        const oneDomain = buys.domains.length === 1 ? buys.domains[0] : '';
        const copy = k === 'domain' ? {
          icon: 'globe',
          title: oneDomain ? t('Registering {domain}', { domain: oneDomain }) : t('Registering your domains'),
          doneTitle: oneDomain ? t('{domain} is yours', { domain: oneDomain }) : t('Your domains are registered'),
          doneSub: t('It is registered and on your account, with our nameservers already set. Manage its DNS and email from your panel.'),
          primary: ['/panel/domains', t('See my domains')],
        } : k === 'email' ? {
          icon: 'mail',
          title: t('Setting up your mailboxes'),
          doneTitle: t('Your mailboxes are ready'),
          doneSub: t('Everything is set up and your welcome email is on its way. Open your panel to see how to sign in.'),
          primary: ['/panel/mail', t('See my email')],
        } : {
          icon: 'rocket',
          title: t('Setting up your hosting'),
          doneTitle: t('Your hosting is ready'),
          doneSub: t('Everything is set up and your welcome email is on its way. Open your account to add a site.'),
          primary: ['/panel/services', t('See my hosting')],
        };
      %>
      <section class="setup-card setup-card-wide"
               data-setup-run
               data-order="<%= order.id %>"
               data-csrf="<%= csrf %>"
               data-started="<%= order.status === 'paid' ? '0' : '1' %>"
               data-done-title="<%= copy.doneTitle %>"
               data-done-sub="<%= copy.doneSub %>"
               data-fail-title="<%= t('Almost there') %>"
               data-fail-sub="<%= k === 'domain' ? t('The registration did not finish on our side. Our team has been told and will complete it or refund you — nothing is lost.') : t('Most of your setup is done. A couple of steps need us to look at them — we have been told, and we will email you shortly. Nothing is lost.') %>"
               data-all-done="<%= t('All done') %>"
               data-something="<%= t('Finished with something to look at') %>">
        <div class="setup-icon" data-run-icon><%- icon(copy.icon, 26) %></div>
        <h1 class="h1 mb-2" data-run-title><%= copy.title %></h1>
        <p class="lede mb-3" data-run-sub>
          <%= k === 'domain'
            ? t('This takes a few seconds. You can leave this page — it carries on without you.')
            : t('This takes under a minute. You can leave this page — it carries on without you and we will email you when it is done.') %>
        </p>

        <div class="setup-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-run-bar>
          <i></i>
        </div>
        <p class="tiny muted" data-run-percent><%= t('Starting…') %></p>

        <ul class="setup-steps" data-run-steps>
          <li class="setup-step is-running">
            <%- th('<span class="setup-step-mark"><span class="spinner spinner-dark"></span></span> <span class="setup-step-text"><b>Getting started</b></span>') %>
          </li>
        </ul>

        <div class="row mt-4" style="justify-content:center" data-run-done hidden>
          <a class="btn btn-lg" href="<%= copy.primary[0] %>"><%= copy.primary[1] %></a>
          <a class="btn btn-ghost btn-lg" href="/panel"><%= t('Open my account') %></a>
        </div>
      </section>
    <% } %>

    <p class="center tiny mt-4" style="color:#6f7862">
      <%- th('Need a hand? <a href="/contact" style="color:var(--lime)">Talk to someone</a> — we answer.') %>
    </p>
  </div>
</main>

<%- include('../partials/footer', { bare: true, extraJs: '/assets/js/setup.js' }) %>
