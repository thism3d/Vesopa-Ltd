<%#
  Add a domain or a subdomain. ONE FORM.

  There used to be two, and the customer had to know which of the two things
  they had before they could begin. They do not — "add heat6.com" and "add
  shop.heat6.com" are the same intention. Which one it is, is a fact about the
  name, and the server works it out (linking.findParent). The script below does
  the same test in the browser purely so the form can explain itself as you
  type; the server never trusts it.
%>
<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/panel-shell', {
  pageTitle: 'Add a domain',
  pageSub: 'A domain you own, or a subdomain of one you already have here.',
}) %>

<div class="p-grid p-grid-side">
  <div>
    <div class="p-card">
      <form method="post" action="/panel/domains/add" data-guard
            id="add-form"
            data-parents="<%= parents.map(function (p) { return p.domain; }).join(',') %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <div class="field <%= errors.domain ? 'field-error' : '' %>">
          <label class="label" for="domain">Domain or subdomain</label>
          <input class="input mono" id="domain" name="domain" required autofocus
                 placeholder="yourbusiness.co.uk" autocomplete="off" spellcheck="false"
                 value="<%= values.domain || '' %>">
          <% if (errors.domain) { %><p class="error-text"><%= errors.domain %></p><% } %>
          <p class="hint" id="add-hint">
            Type the whole name. We work out whether it is a domain or a subdomain —
            you do not have to tell us.
          </p>
        </div>

        <%#
          What we worked out, said back to them. Filled in by the script; the
          server does the real decision either way, so a customer with
          JavaScript off simply sees the form without this line and everything
          still works.
        %>
        <div class="detect" id="detect" hidden>
          <span class="detect-icon" id="detect-icon"></span>
          <span id="detect-text"></span>
        </div>

        <% if (services.length) { %>
          <div class="field">
            <label class="label" for="service_id">Host it on</label>
            <select class="select" id="service_id" name="service_id">
              <option value="">Decide later</option>
              <% services.forEach(function (s) { %>
                <option value="<%= s.id %>" <%= String(values.service_id) === String(s.id) ? 'selected' : '' %>>
                  <%= s.primary_domain || s.plan_name %>
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>

        <%#
          Only meaningful for a real domain. Hidden by the script the moment the
          name is recognised as a subdomain, and IGNORED BY THE SERVER in that
          case regardless of what is posted — a subdomain never gets its own DNS
          zone or a mail domain, and hiding a checkbox is not a rule.
        %>
        <fieldset class="field" id="domain-only" style="border:0;padding:0;margin:0 0 18px">
          <legend class="label" style="padding:0">What should we set up for it?</legend>

          <label class="check">
            <input type="checkbox" name="want_dns" value="1"
                   <%= values.want_dns === undefined || values.want_dns ? 'checked' : '' %>>
            <span>
              <span class="strong">DNS</span>
              <span class="tiny muted" style="display:block">Host the domain's DNS here. Leave this on unless you are keeping DNS at your current provider.</span>
            </span>
          </label>

          <label class="check">
            <input type="checkbox" name="want_mail" value="1" <%= values.want_mail ? 'checked' : '' %>>
            <span>
              <span class="strong">Email</span>
              <span class="tiny muted" style="display:block">Accept mail for this domain so you can create mailboxes. Leave off if your email is with Google, Microsoft or anyone else.</span>
            </span>
          </label>

          <p class="hint">The website is always set up. You can change your mind later.</p>
        </fieldset>

        <button class="btn btn-lg" type="submit" data-busy="Adding…" id="add-submit">Add it</button>
      </form>
    </div>

    <div class="p-card">
      <h2 class="h3 mb-2">How it works</h2>
      <div class="how">
        <div class="how-row">
          <span class="how-tag">Domain</span>
          <p class="small muted mb-0">
            Point it at us one of two ways — use our nameservers, or aim an
            <span class="mono">A</span> record here and keep DNS where it is. Either is enough.
            We check every few minutes and set up the site and its certificate the moment it lands.
            You have <%= graceDays %> days.
          </p>
        </div>
        <div class="how-row">
          <span class="how-tag how-tag-sub">Subdomain</span>
          <p class="small muted mb-0">
            Built immediately — there is nothing to wait for and no nameserver change to make.
            It gets its own folder and its own certificate. It has
            <b>no DNS zone and no mailboxes</b> of its own: its records live in the main
            domain's zone, and email belongs on the main domain.
          </p>
        </div>
      </div>
    </div>
  </div>

  <aside>
    <div class="p-card" id="aside-domain">
      <h2 class="h3 mb-2">Point a domain at us</h2>
      <p class="small muted mb-2">Either one works. You do not need both.</p>

      <p class="label mb-1">1 &nbsp;Our nameservers <span class="badge badge-green" style="font-size:.62rem">recommended</span></p>
      <% defaultNameservers.forEach(function (ns) { %>
        <div class="copyable">
          <span class="mono"><%= ns %></span>
          <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= ns %>">Copy</button>
        </div>
      <% }); %>

      <p class="label mb-1 mt-3">2 &nbsp;An A record, DNS stays with you</p>
      <% if (addresses.length) { %>
        <div class="copyable">
          <span class="mono"><%= addresses[0] %></span>
          <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= addresses[0] %>">Copy</button>
        </div>
      <% } %>
      <div class="copyable">
        <span class="mono"><%= pointHostname %></span>
        <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= pointHostname %>">Copy</button>
      </div>
      <p class="tiny muted mt-2 mb-0">
        Prefer <span class="mono"><%= pointHostname %></span> if your DNS panel accepts a name —
        it follows this server wherever it goes.
      </p>
    </div>

    <% if (parents.length) { %>
      <div class="p-card">
        <h2 class="h3 mb-2">Your domains</h2>
        <p class="small muted mb-2">
          Anything typed under one of these is treated as a subdomain and set up straight away:
        </p>
        <ul class="plain-list">
          <% parents.forEach(function (p) { %>
            <li><span class="mono"><%= p.domain %></span></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <div class="p-card">
      <h2 class="h3 mb-2">Would rather we held it?</h2>
      <p class="small muted mb-2">Transfer the domain to us and renewals, DNS and hosting all sit in one place.</p>
      <a class="btn btn-ghost btn-sm btn-block" href="/domains/transfer">Transfer a domain</a>
    </div>
  </aside>
</div>

<script src="<%= asset('/assets/js/domain-add.js') %>" defer></script>

<%- include('../partials/panel-shell-end') %>
<%- include('../partials/footer') %>
