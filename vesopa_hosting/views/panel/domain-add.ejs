<%- include('../partials/head', { extraCss: '/assets/css/panel.css' }) %>
<%- include('../partials/panel-shell', {
  pageTitle: 'Add a domain you already own',
  pageSub: 'Registered somewhere else? Point it here and we will host it.',
}) %>

<div class="p-grid p-grid-side">
  <div>
    <div class="p-card">
      <form method="post" action="/panel/domains/add" data-guard>
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <div class="field <%= errors.domain ? 'field-error' : '' %>">
          <label class="label" for="domain">Your domain</label>
          <input class="input mono" id="domain" name="domain" required autofocus
                 placeholder="yourbusiness.co.uk" autocomplete="off" spellcheck="false"
                 value="<%= values.domain || '' %>">
          <% if (errors.domain) { %><p class="error-text"><%= errors.domain %></p><% } %>
          <p class="hint">Just the domain — no https:// and no www.</p>
        </div>

        <% if (services.length) { %>
          <div class="field">
            <label class="label" for="service_id">Host it on</label>
            <select class="select" id="service_id" name="service_id">
              <option value="">Decide later</option>
              <% services.forEach(function (s) { %>
                <option value="<%= s.id %>" <%= String(values.service_id) === String(s.id) ? 'selected' : '' %>>
                  <%= s.primary_domain || s.plan_name %>
                </option>
              <% }); %>
            </select>
          </div>
        <% } %>

        <%#
          What to build for it. DNS arrives ticked because a domain delegated
          to our nameservers with no zone here resolves to nothing; mail arrives
          unticked because creating one starts accepting mail for the name, and
          most people moving a site keep their mail where it is.
        %>
        <fieldset class="field" style="border:0;padding:0;margin:0 0 18px">
          <legend class="label" style="padding:0">What should we set up for it?</legend>

          <label class="check">
            <input type="checkbox" name="want_dns" value="1"
                   <%= values.want_dns === undefined || values.want_dns ? 'checked' : '' %>>
            <span>
              <span class="strong">DNS</span>
              <span class="tiny muted" style="display:block">Host the domain's DNS here. Leave this on unless you are keeping DNS at your current provider.</span>
            </span>
          </label>

          <label class="check">
            <input type="checkbox" name="want_mail" value="1" <%= values.want_mail ? 'checked' : '' %>>
            <span>
              <span class="strong">Email</span>
              <span class="tiny muted" style="display:block">Accept mail for this domain and let you create mailboxes. Leave off if your email is with Google, Microsoft or anyone else.</span>
            </span>
          </label>

          <p class="hint">The website is always set up. You can change your mind later.</p>
        </fieldset>

        <button class="btn btn-lg" type="submit" data-busy="Adding…">Add this domain</button>
      </form>
    </div>

    <%#
      Subdomains. Deliberately a separate form: there is no registrar step, no
      nameserver change and no waiting — it is built on the node as the form is
      submitted. Only shown when the account has a domain to put one under,
      because the parent is the authorisation.
    %>
    <% if (parents && parents.length) { %>
      <div class="p-card">
        <h2 class="h3 mb-2">Or add a subdomain</h2>
        <p class="small muted mb-2">
          Something like <span class="mono">shop.<%= parents[0].domain %></span> — set up straight away,
          with no nameserver change to make and nothing to wait for.
        </p>

        <form method="post" action="/panel/domains/add-subdomain" data-guard>
          <input type="hidden" name="_csrf" value="<%= csrf %>">

          <div class="field">
            <label class="label" for="subdomain">Subdomain</label>
            <input class="input mono" id="subdomain" name="subdomain" required
                   placeholder="shop.<%= parents[0].domain %>" autocomplete="off" spellcheck="false">
            <p class="hint">
              The whole name, including your domain. It has to sit under one of:
              <%= parents.map(function (p) { return p.domain; }).join(', ') %>.
            </p>
          </div>

          <fieldset class="field" style="border:0;padding:0;margin:0 0 18px">
            <legend class="label" style="padding:0">Anything else with it?</legend>

            <label class="check">
              <input type="checkbox" name="want_dns" value="1">
              <span>
                <span class="strong">Its own DNS zone</span>
                <span class="tiny muted" style="display:block">Rarely needed. If your main domain's DNS is already here, the subdomain works without this.</span>
              </span>
            </label>

            <label class="check">
              <input type="checkbox" name="want_mail" value="1">
              <span>
                <span class="strong">Email at this subdomain</span>
                <span class="tiny muted" style="display:block">Lets you create mailboxes like you@shop.<%= parents[0].domain %>.</span>
              </span>
            </label>

            <p class="hint">The website is always set up — that is the point of a subdomain.</p>
          </fieldset>

          <button class="btn btn-lg" type="submit" data-busy="Setting up…">Add subdomain</button>
        </form>
      </div>
    <% } %>

    <div class="p-card">
      <h2 class="h3 mb-2">What happens next</h2>
      <ol class="small muted" style="margin:0;padding-left:18px;line-height:1.75">
        <li>Sign in wherever the domain is registered and set its nameservers to the two on the right.</li>
        <li>We check every few minutes. The moment the change is visible, we build the site, the mailboxes and the certificate for you.</li>
        <li>Nothing to do here in the meantime — you can close this page and we will email you.</li>
      </ol>
    </div>
  </div>

  <aside>
    <div class="p-card">
      <h2 class="h3 mb-2">Set these nameservers</h2>
      <p class="small muted mb-2">At your current registrar, replace whatever is there with these two.</p>
      <% nameservers.forEach(function (ns) { %>
        <div class="copyable">
          <span><%= ns %></span>
          <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= ns %>">Copy</button>
        </div>
      <% }); %>
    </div>

    <div class="p-card">
      <div class="f-icon"><%- icon('clock', 22) %></div>
      <h2 class="h3 mb-2">You have <%= graceDays %> days</h2>
      <p class="small muted mb-0">
        A domain that has not been pointed at us within <%= graceDays %> days is taken off your
        account again — we would not be hosting it, so listing it would be telling you
        something untrue. Nothing is charged either way, the domain itself is
        untouched, and you can add it again whenever you are ready.
      </p>
    </div>

    <div class="p-card">
      <h2 class="h3 mb-2">Would rather we held it?</h2>
      <p class="small muted mb-2">Transfer the domain to us and renewals, DNS and hosting all sit in one place.</p>
      <a class="btn btn-ghost btn-sm btn-block" href="/domains/transfer">Transfer a domain</a>
    </div>
  </aside>
</div>

<%- include('../partials/panel-shell-end') %>
<%- include('../partials/footer') %>
