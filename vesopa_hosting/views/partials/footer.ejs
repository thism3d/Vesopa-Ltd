<%# `bare: true` renders only the scripts and the flash hook — no footer
    furniture. The onboarding wizard uses it: a screen whose whole job is to
    hold the customer's attention should not end in twenty links out of it. %>
<% if (typeof bare === 'undefined' || !bare) { %>
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <%- include('./brand', { on: 'dark', size: 26 }) %>
        <p class="small" style="max-width:30ch">
          <%= t('UK web hosting, domain names and business email. One panel, no jargon, and a person on the other end of the ticket.') %>
        </p>
        <p class="small" style="margin-bottom:0">
          <span class="row" style="gap:7px"><%- th('<span class="dot dot-live"></span> <span>All systems operational</span>') %></span>
        </p>
      </div>

      <div>
        <h4><%= t('Hosting') %></h4>
        <ul>
          <li><a href="/hosting"><%= t('Shared hosting') %></a></li>
          <li><a href="/hosting#compare"><%= t('Compare plans') %></a></li>
          <li><a href="/email"><%= t('Business email') %></a></li>
          <li><a href="/email#pricing"><%= t('Marketing email') %></a></li>
          <li><a href="/#wordpress"><%= t('WordPress hosting') %></a></li>
          <li><a href="/#vibe"><%= t('Deploy an AI-built app') %></a></li>
          <li><a href="/ssl"><%= t('SSL certificates') %></a></li>
          <li><a href="/transfer"><%= t('Move your site to us') %></a></li>
        </ul>
      </div>

      <div>
        <h4><%= t('Domains') %></h4>
        <ul>
          <li><a href="/domains"><%= t('Search a domain') %></a></li>
          <li><a href="/domains/pricing"><%= t('Domain pricing') %></a></li>
          <li><a href="/domains/transfer"><%= t('Transfer a domain') %></a></li>
          <li><a href="/domains#faq"><%= t('Domain help') %></a></li>
        </ul>
      </div>

      <div>
        <h4><%= t('Company') %></h4>
        <ul>
          <li><a href="/about"><%= t('About Vesopa') %></a></li>
          <li><a href="/support"><%= t('Support') %></a></li>
          <li><a href="/contact"><%= t('Contact us') %></a></li>
          <li><a href="<%= mainSiteUrl %>" target="_blank" rel="noopener"><%= t('Vesopa Software') %></a></li>
        </ul>

        <%# The language choice, written out.

            The bar's toggle is two or three letters for people who already
            know what they are looking for; this is where somebody who does not
            goes looking, and it says each language IN that language — nobody
            scanning for their own tongue is helped by the word "Bengali" in
            English. See the header for why `data-no-router` is here. %>
        <% if (locales && locales.length > 1) { %>
          <h4 class="footer-lang-head"><%= t('Language') %></h4>
          <ul class="footer-langs">
            <% locales.forEach(function (l) { %>
              <li>
                <a href="<%= langHref(l.code) %>" rel="nofollow" data-no-router
                   lang="<%= l.html %>" hreflang="<%= l.hreflang %>"
                   class="<%= l.code === locale ? 'is-active' : '' %>"
                   <%= l.code === locale ? 'aria-current="true"' : '' %>><%= l.native %></a>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        &copy; <%= new Date().getFullYear() %> <%= contact.company %>.
        <span class="hide-sm">&nbsp;·&nbsp; <%= contact.address_line1 %>, <%= contact.address_line2 %></span>
      </div>
      <div class="row" style="gap:18px">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/aup">Acceptable use</a>
        <a href="/refunds">Refunds</a>
      </div>
    </div>
  </div>
</footer>
<% } %>

<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
  <span data-flash="<%= flash.message %>" data-flash-kind="<%= flash.kind || 'ok' %>" hidden></span>
<% } %>

<%# The bar first and the router second: the router uses the bar if it is
    there, and each works without the other. Neither is deferred — they must
    be running before the page's own scripts, which are. %>
<script src="<%= asset('/assets/js/loadbar.js') %>"></script>
<script src="<%= asset('/assets/js/nav.js') %>"></script>
<script src="<%= asset('/assets/js/app.js') %>" defer></script>
<% if (typeof aiEnabled !== 'undefined' && aiEnabled) { %><script src="<%= asset('/assets/js/assistant.js') %>" defer></script><% } %>
<% if (typeof extraJs !== 'undefined') { %><script src="<%= asset(extraJs) %>" defer></script><% } %>
</body>
</html>
