<%- include('../partials/head') %>
<div class="auth-page">
  <div class="auth-card">
    <a class="auth-brand" href="/">
      <%- include('../partials/brand', { on: 'light', size: 24 }) %>
      <span class="brand-sub">Hosting</span>
    </a>

    <h1>Welcome back</h1>
    <p class="lede">Sign in to manage your sites, domains and billing.</p>

    <% if (error) { %>
      <div class="alert alert-error"><%- icon('warning', 19) %><div><%= error %></div></div>
    <% } %>

    <form method="post" action="/login" data-guard>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label class="label" for="email">Email address</label>
        <input class="input" id="email" name="email" type="email" autocomplete="username"
               value="<%= values.email || '' %>" required autofocus>
      </div>

      <div class="field">
        <div class="row-between" style="margin-bottom:6px">
          <label class="label" for="password" style="margin:0">Password</label>
          <a class="tiny" href="/forgot">Forgotten?</a>
        </div>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
      </div>

      <button class="btn btn-block btn-lg" type="submit" data-busy="Signing in…">Sign in</button>

      <%
        /*
         * Signing in with a Vesopa account, offered BELOW the password form.
         *
         * Hidden until the server says the feature is on: the flag lives in the
         * environment, and a button that leads to a 404 is worse than none —
         * somebody picks the option that looks most official and is told it
         * went wrong.
         *
         * Nobody is being moved. The password form above stays exactly as it
         * was for the whole soak; this is an addition beside it.
         */
      %>
      <% if (typeof vesopaSso !== 'undefined' && vesopaSso) { %>
      <div id="vesopa-sso" style="margin-top:14px">
        <div class="or-divider"><span>or</span></div>
        <a class="btn btn-block btn-lg btn-secondary"
           href="/auth/vesopa/start?next=<%= encodeURIComponent(typeof next !== 'undefined' && next ? next : '/panel') %>">
          Sign in with your Vesopa account
        </a>
      </div>
      <% } %>
    </form>

    <p class="auth-alt mb-0">
      New here? <a href="/register">Create an account</a>
    </p>
  </div>
  <p class="auth-foot"><a href="/">← Back to the website</a> &nbsp;·&nbsp; <a href="/support">Need help?</a></p>
</div>
<%- include('../partials/footer') %>
