<%- include('../partials/head') %>
<div class="auth-page">
  <div class="auth-card">
    <a class="auth-brand" href="/">
      <%- include('../partials/brand', { on: 'light', size: 24 }) %>
      <span class="brand-sub">Hosting</span>
    </a>

    <% if (error) { %>
      <div class="alert alert-error"><%- icon('warning', 19) %><div><%= error %></div></div>
    <% } %>

    <%
      /*
       * ONE WAY IN.
       *
       * The owner's direction for every Vesopa product: Continue with Vesopa,
       * and no other login or registration. So with VESOPA_ONLY on there is
       * no email field, no password, no "Forgotten?" and no "Create an
       * account" — the first Vesopa sign-in from an address we have never
       * seen IS the registration (routes/vesopa-sso.js). What is left is a
       * page with one button, which is the point: nothing to fill in, nothing
       * to get wrong, and nothing to resubmit on a reload.
       *
       * The password form below is kept for the flag being turned off, and
       * for a server where the Vesopa client is not configured at all — a
       * sign-in page with no way in is worse than the old one.
       */
      const nextTo = typeof next !== 'undefined' && next ? next : '/panel';
      const onlyVesopa = vesopaOnly && typeof vesopaSso !== 'undefined' && vesopaSso;
    %>

    <% if (onlyVesopa) { %>
      <h1>Sign in</h1>
      <p class="lede">Your Vesopa account opens your sites, domains and billing.</p>

      <%- include('../partials/vesopa-button', { href: '/auth/vesopa/start?next=' + encodeURIComponent(nextTo) }) %>
      <p class="auth-switch">
        <a href="/auth/vesopa/start?switch=1&next=<%= encodeURIComponent(nextTo) %>" rel="external">Use a different Vesopa account</a>
      </p>

      <p class="auth-alt mb-0">
        New to Vesopa Cloud? The same button sets your account up — one account for every Vesopa product.
      </p>
    <% } else { %>
      <h1>Welcome back</h1>
      <p class="lede">Sign in to manage your sites, domains and billing.</p>

      <form method="post" action="/login" data-guard>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="next" value="<%= nextTo %>">

        <div class="field">
          <label class="label" for="email">Email address</label>
          <input class="input" id="email" name="email" type="email" autocomplete="username"
                 value="<%= values.email || '' %>" required autofocus>
        </div>

        <div class="field">
          <div class="row-between" style="margin-bottom:6px">
            <label class="label" for="password" style="margin:0">Password</label>
            <a class="tiny" href="/forgot">Forgotten?</a>
          </div>
          <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>

        <button class="btn btn-block btn-lg" type="submit" data-busy="Signing in…">Sign in</button>

        <% if (typeof vesopaSso !== 'undefined' && vesopaSso) { %>
        <div id="vesopa-sso" style="margin-top:14px">
          <div class="or-divider"><span>or</span></div>
          <%- include('../partials/vesopa-button', { cls: 'btn btn-block btn-lg btn-secondary', href: '/auth/vesopa/start?next=' + encodeURIComponent(nextTo) }) %>
          <p class="auth-switch">
            <a href="/auth/vesopa/start?switch=1&next=<%= encodeURIComponent(nextTo) %>" rel="external">Use a different Vesopa account</a>
          </p>
        </div>
        <% } %>
      </form>

      <p class="auth-alt mb-0">
        New here? <a href="/register">Create an account</a>
      </p>
    <% } %>
  </div>
  <p class="auth-foot"><a href="/">← Back to the website</a> &nbsp;·&nbsp; <a href="/support">Need help?</a></p>
</div>
<%- include('../partials/footer') %>
