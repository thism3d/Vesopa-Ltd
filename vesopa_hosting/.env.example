# Copy to .env and fill in. .env is gitignored — never commit real credentials.

PORT=5075
NODE_ENV=development
SITE_URL=https://hosting.vesopaepos.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Deliberately NOT vesopa_eposdb. The hosting business shares a MySQL server
# with the EPOS apps but not a schema: a `customers` table means something
# different on each side, and a migration on one must never be able to lock a
# table the other is selling against.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_hostingdb
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Two separate secrets, so a leaked customer secret cannot mint an admin cookie.
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Outbound mail — every account action goes through here
# ---------------------------------------------------------------------------
SMTP_HOST=mail.vesopaepos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hosting@vesopaepos.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Vesopa Hosting
MAIL_FROM=hosting@vesopaepos.com
# Where contact-form and new-order notifications land.
MAIL_TO=hosting@vesopaepos.com

# ---------------------------------------------------------------------------
# Bootstrap admin
# ---------------------------------------------------------------------------
# Read once by `npm run seed:admin`, which hashes the password and writes the
# row. The plaintext never reaches the database and this file never reaches git.
# Change the password after first login and blank these two out.
ADMIN_EMAIL=meirion@vesopaepos.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# DomainNameAPI — registrar
# ---------------------------------------------------------------------------
# dm.domainnameapi.com › Settings › Integration. Leave DNA_MODE=mock to run the
# whole site against a deterministic fake registrar: availability, pricing and
# registration all work, nothing is bought, no credentials required.
# mock = deterministic fake, test = OTE sandbox, live = real money.
DNA_MODE=mock
DNA_RESELLER_ID=
DNA_API_KEY=
DNA_API_KEY_TEST=
DNA_API_URL=

# ---------------------------------------------------------------------------
# HestiaCP — the hosting node the panel drives
# ---------------------------------------------------------------------------
# The Azure box. HESTIA_MODE=mock records what *would* have been provisioned
# without calling the server, which is what you want until DNS points here.
HESTIA_MODE=mock
HESTIA_HOST=
HESTIA_PORT=8083
HESTIA_ADMIN_USER=admin
HESTIA_ADMIN_PASSWORD=
# Hestia self-signs its API certificate on a fresh install. Set to false only
# while the node is still on its self-signed cert, and fix it properly after.
HESTIA_VERIFY_TLS=true
# The package name Hestia applies to new users. Must exist on the node.
HESTIA_DEFAULT_PACKAGE=default
# Nameservers handed to customers and set on registered domains.
NS1=ns1.vesopaepos.com
NS2=ns2.vesopaepos.com

# ---------------------------------------------------------------------------
# Payments — the fallback when no gateway is switched on
# ---------------------------------------------------------------------------
# PAYMENTS_MODE=manual puts an order into "awaiting payment" and emails an
# invoice with bank details instead of taking a card. It is only reached when
# NO gateway below is available — with SSLCommerz configured, checkout hands
# off to it and this is never used.
PAYMENTS_MODE=manual

# ---------------------------------------------------------------------------
# SSLCommerz, via BosheBoshe (the merchant of record)
# ---------------------------------------------------------------------------
# Four gateways are offered at the checkout — SSLCommerz, Stripe, PayPal and
# crypto — and crypto is deliberately shown disabled until its adapter exists.
# Whether one is offered is computed from whether it is configured, never typed.
#
# SSLCZ_MODE:
#   mock  the whole journey runs against a fake gateway page at /pay/mock/*,
#         a payment row is written and settled, and no money moves. This is how
#         checkout is tested without a live card. The signature check is skipped
#         in this mode ONLY, and the fake page 404s in any other.
#   live  real payments.
SSLCZ_MODE=mock
SSLCZ_BASE_URL=https://bosheboshe.com
# Public — sent in the initiate form.
SSLCZ_API_KEY=
# Signature verification and refunds. SERVER SIDE ONLY: it is what separates a
# real callback from someone typing the success URL with status=VALID on the
# end. Never expose it to a template or a browser.
SSLCZ_API_SECRET=
# The gateway settles in taka, and we sell in pounds, dollars and Canadian
# dollars — so an order is RECORDED in one currency and CHARGED in another, and
# both figures go on the payment row. The conversion uses the BDT row in the
# `currencies` table (inactive on purpose: it is FX plumbing, not a currency
# anyone is offered), so the rate is maintained in Admin -> Currencies.
SSLCZ_CURRENCY=BDT
# Any currency the account is enabled to take DIRECTLY, comma separated.
# Anything outside this list is converted to SSLCZ_CURRENCY first. Widen it only
# once you have confirmed the account accepts that currency — sending GBP to an
# account that cannot take it fails at the gateway with a message the customer
# cannot act on.
SSLCZ_PASSTHROUGH=BDT
# How long to wait on the gateway before giving up, in ms.
SSLCZ_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Stripe — Checkout Sessions, hosted like SSLCommerz
# ---------------------------------------------------------------------------
# STRIPE_MODE:
#   mock  same idea as SSLCZ_MODE — /pay/mock/* stands in, no money moves.
#   live  real payments. Card, Apple Pay and Google Pay all come from the ONE
#         hosted Checkout page; which wallets show is decided by Stripe from
#         what is enabled in the Dashboard and what the browser supports, not
#         by anything configured here. Apple Pay additionally needs a domain
#         verified in the Stripe Dashboard — Checkout needs no file for that
#         because the page itself is served from a domain Stripe already owns.
STRIPE_MODE=mock
# SERVER SIDE ONLY: creates and reads back Checkout Sessions.
STRIPE_SECRET_KEY=
# Not currently used server-side; kept so nothing has to guess it later if an
# embedded flow (Payment Element) is ever added alongside the hosted one.
STRIPE_PUBLISHABLE_KEY=
STRIPE_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# PayPal — Orders v2, one order's own approve link followed directly
# ---------------------------------------------------------------------------
# PAYPAL_MODE:
#   mock     same idea as SSLCZ_MODE — /pay/mock/* stands in, no money moves.
#   sandbox  a real PayPal environment with fake money — sandbox.paypal.com.
#   live     real payments.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
# SERVER SIDE ONLY: mints the OAuth token that creates and captures orders.
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Domain rate card
# ---------------------------------------------------------------------------
# Turkish lira per pound, used only by scripts/import-tlds.js to read the .tr
# costs off the DomainNameAPI rate card. Those extensions are imported INACTIVE
# (they need a Turkish presence we do not buy), so this figure cannot mis-price
# anything a customer can reach — it is a cost estimate for the admin.
TRY_PER_GBP=44

# ---------------------------------------------------------------------------
# Currency
# ---------------------------------------------------------------------------
# The currency the CATALOGUE IS PRICED IN. Every `*_pence` column in the
# database is this one; USD, CAD and anything else are derived from it at
# request time.
#
# The rates, the rounding rules, the per-currency VAT and the country mapping
# are NOT here — they live in the `currencies` table and are edited under
# Admin -> Currencies, because they are commercial decisions that should not
# need a deploy. This is only the denomination everything else is measured in,
# and changing it after there are orders in the database would reinterpret
# every price already stored.
BASE_CURRENCY=GBP

# VAT_PERCENT is GONE. It is per currency now — 20% inside a GBP price, zero
# inside a USD one — and lives on the `currencies` row. See Admin -> Currencies.

# The most a free domain may be worth, in BASE_CURRENCY minor units. Checked
# against the base price, never the converted one, so the answer is the same
# for every visitor no matter what the pound is doing.
FREE_DOMAIN_MAX_PENCE=2000

# ---------------------------------------------------------------------------
# Visitor location — for picking a currency on a first visit
# ---------------------------------------------------------------------------
# Called FROM THE SERVER, never from the browser. A geo request fired from the
# page would put a third-party host in the CSP, show up in every visitor's
# network tab, be blocked outright by most ad-blockers, and hand a company we
# have no agreement with a log of everyone who opens the site.
#
# One lookup per new address: the answer is cached in memory, in `geo_cache`,
# and in the visitor's own cookie for a year. Their manual choice from the
# switcher always wins over the guess.
GEO_ENABLED=true
GEO_ENDPOINT=https://ipwho.is
GEO_TIMEOUT_MS=1500
# Salt for hashing addresses in geo_cache. We need to recognise an address we
# have looked up before; we do not need to be able to read back the list of
# everyone who has ever visited. Falls back to SESSION_SECRET if unset.
GEO_SALT=change-me
