# =============================================================================
# vesopa_hosting — PRODUCTION
# =============================================================================
# Copy this to `.env` ON THE SERVER and fill in the blanks. It is committed as
# `.env.production.example` because `.gitignore` blocks every real `.env` — the
# template is the thing that ships, the filled-in copy never leaves the box.
#
#     scp .env.production.example root@3.72.113.21:/var/www/vesopa_hosting/.env
#     ssh root@3.72.113.21 'chmod 600 /var/www/vesopa_hosting/.env'
#
# DO NOT copy the development .env up. It points at a sandbox registrar, a mock
# hosting node, and a database on localhost with a development password, and
# three of those four would be wrong in a way nobody notices until a customer
# pays for a domain that never gets registered.
#
# EVERY SECRET BELOW MUST BE DIFFERENT FROM THE DEVELOPMENT ONE. A shared secret
# means a laptop backup, a screen share or a stray commit hands somebody the
# live system.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5075

# Public origin, with https and NO trailing slash. It is used to build the URLs
# in every email and the canonical tags on every page. Getting it wrong sends
# customers to a link that does not resolve, from an email they cannot re-send.
SITE_URL=https://hosting.vesopaepos.com
MAIN_SITE_URL=https://vesopaepos.com


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_hostingdb

# NOT root. A dedicated user with rights to this one schema, so a mistake here
# cannot reach vesopa_eposdb or any of the other applications on this box:
#
#   CREATE USER 'vesopa_hosting'@'localhost' IDENTIFIED BY '<long random>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON vesopa_hostingdb.* TO 'vesopa_hosting'@'localhost';
#   FLUSH PRIVILEGES;
#
# Note there is no DROP or ALTER: schema changes are applied deliberately by
# running schema.sql as an administrator, not by the application at runtime.
DB_USER=vesopa_hosting
DB_PASSWORD=


# -----------------------------------------------------------------------------
# Session secrets
# -----------------------------------------------------------------------------
# Two separate secrets, so a leak of the customer one cannot mint an admin
# session. Generate each with:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing either signs everybody out of that side. That is the correct response
# to a suspected leak, and the reason they are separate.
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# Salt for hashing visitor IP addresses in geo_cache. Not a session secret, but
# generated the same way — it is what stops the table being readable back into a
# list of everyone who has visited the site.
GEO_SALT=


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Shares vesopa_web's mailbox. If SMTP is not configured the site still runs and
# every account email is silently dropped — which on a hosting site means order
# confirmations and password resets never arrive, and nothing appears broken.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_NAME=Vesopa Hosting
MAIL_FROM=hosting@vesopaepos.com
MAIL_TO=hosting@vesopaepos.com


# -----------------------------------------------------------------------------
# First admin
# -----------------------------------------------------------------------------
# Used ONCE by `npm run seed:admin`, which bcrypts it into the database.
#
# BLANK ADMIN_PASSWORD IMMEDIATELY AFTERWARDS. Left in place it is a plaintext
# password to the whole business sitting in a file, and it is not read again
# after that one command.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Registrar — DomainNameAPI
# -----------------------------------------------------------------------------
# THIS IS THE LINE THAT SPENDS REAL MONEY.
#
#   test  — registrations go to the sandbox. Nothing is bought, nothing is
#           charged, and no customer actually owns the name they paid for.
#   live  — every successful order debits the reseller balance for real.
#
# Go live only once payments are wired and the balance is funded. The account
# was last seen at zero, and a zero balance fails at exactly the worst moment:
# availability searches keep working perfectly, and registration fails after the
# customer has already paid.
DNA_MODE=live
DNA_RESELLER_ID=
DNA_API_KEY=
# DNA_API_URL — LEAVE THIS UNSET.
#
# The code already knows the base: https://api.domainresellerapi.com/api/v1
# Setting it to the bare host drops the `/api/v1` path and every single call
# 404s with an empty body — which the app reports as "could not check right
# now", so the site looks healthy while no domain search works at all.
# It exists only to point at a staging gateway, and then it must carry the
# full path including /api/v1.
# DNA_API_URL=

# The sandbox key is not needed in production and is better absent than present.
# DNA_API_KEY_TEST=

# These are not only what customers are told to set — they are what every domain
# is CHECKED against before we serve it, issue its certificate or keep it on an
# account. They must be the live nameservers, answering from the internet.
NS1=ns1.vesopaepos.com
NS2=ns2.vesopaepos.com

# -----------------------------------------------------------------------------
# Background jobs — src/jobs.js
# -----------------------------------------------------------------------------
# Pending payments are re-checked against their gateway, orders that were paid
# but never built are finished, and domain nameservers are swept. Leave the
# timers on for exactly one process: if this app is ever scaled past a single
# pm2 instance, every other one needs JOB_INTERVAL_MINUTES=0.
JOB_INTERVAL_MINUTES=5
PAYMENT_SESSION_MINUTES=90
# How long a domain registered elsewhere has to point at us before it comes off
# the account. Domains bought through us are never dropped by this.
DOMAIN_NS_GRACE_DAYS=3
# Public resolvers on purpose — never the node's own, which answers
# authoritatively for zones it holds and would pass domains that are not
# delegated to us at all.
DNS_RESOLVERS=1.1.1.1,8.8.8.8


# -----------------------------------------------------------------------------
# Hosting node — HestiaCP
# -----------------------------------------------------------------------------
# `mock` provisions nothing: the wizard runs, the progress bar completes, and no
# account exists. Set to `live` only when the node answers on its API port.
HESTIA_MODE=live
HESTIA_HOST=
HESTIA_PORT=8083
HESTIA_ADMIN_USER=admin
HESTIA_ADMIN_PASSWORD=

# Leave true in production. It is set false in development only because the node
# uses a self-signed certificate there; false in production means anybody on the
# path can read the admin password this app sends.
HESTIA_VERIFY_TLS=true
HESTIA_DEFAULT_PACKAGE=default


# -----------------------------------------------------------------------------
# Commerce
# -----------------------------------------------------------------------------
# `manual` marks orders "awaiting payment" and emails an invoice. Every other
# part of the order path is built; only the card charge is stubbed.
PAYMENTS_MODE=manual

# The currency the CATALOGUE is priced in. Rates, rounding, per-currency VAT and
# the country mapping live in the `currencies` table — Admin → Currencies —
# because they are commercial decisions that should not need a deploy.
#
# Do not change this after there are orders: every stored price is denominated
# in it, and changing it reinterprets the lot.
BASE_CURRENCY=GBP

# The most a free domain may be worth, in BASE_CURRENCY minor units.
FREE_DOMAIN_MAX_PENCE=2000


# -----------------------------------------------------------------------------
# Visitor location
# -----------------------------------------------------------------------------
# Called from this server, never from the browser. One lookup per new address,
# then cached in memory, in `geo_cache` and in the visitor's own cookie.
GEO_ENABLED=true
GEO_ENDPOINT=https://ipwho.is
GEO_TIMEOUT_MS=1500

# ---------------------------------------------------------------------------
# Cryptocurrency — our own BTCPay Server, via the Greenfield API
# ---------------------------------------------------------------------------
# The node at pay.vesopaepos.com is ours: no processor takes a cut, no account
# can be frozen, and the store settles to wallets we hold. The trade is that
# "paid" is a slower question than it is on a card — see src/integrations/btcpay.js.
#
#   mock  the whole journey runs against /pay/mock/*, no invoice, no money
#   live  real invoices against the real store
BTCPAY_MODE=mock
BTCPAY_URL=https://pay.vesopaepos.com
# Greenfield API key. Needs only btcpay.store.cancreateinvoice and
# btcpay.store.canviewinvoices on the ONE store below — a server-wide key here
# would let a hole in the web tier reach every store and the server settings.
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# Set when the webhook is created in BTCPay (Store -> Settings -> Webhooks),
# pointing at https://<site>/pay/crypto/webhook. Without it the gateway still
# works, but a payment settles on the reconciler's next poll instead of the
# moment it confirms — so an order can sit "awaiting payment" for minutes after
# the customer has paid, which is exactly when they open a ticket.
BTCPAY_WEBHOOK_SECRET=
# How long a crypto attempt stays worth asking BTCPay about. Longer than the
# card gateways get: a payment broadcast in the last minute of the invoice
# window can take another hour to confirm at a low fee.
BTCPAY_SESSION_MINUTES=180
