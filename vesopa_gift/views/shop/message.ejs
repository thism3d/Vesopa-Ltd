<%- include('_head') %>
<main class="narrow">
  <div class="done-head">
    <h1 class="serif"><%= heading %></h1>
    <p class="muted pretty"><%= body %></p>
    <div class="actions">
      <% if (locals.venue) { %><a class="btn primary" href="/<%= venue.slug %>">Back to <%= locals.brand ? brand.name : 'the shop' %></a><% } %>
      <a class="btn <%= locals.venue ? 'ghost' : 'primary' %>" href="<%= locals.home || '/' %>">Back to the home page</a>
    </div>
  </div>
</main>
<%- include('_foot') %>
