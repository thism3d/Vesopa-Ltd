<footer class="foot">
  <div class="wrap">
    <% if (locals.brand) { %>
    <div class="stack gap-6">
      <span class="serif"><%= brand.name %></span>
      <% if (brand.address) { %><span class="small muted"><%= brand.address %></span><% } %>
    </div>
    <div class="links">
      <a href="/<%= venue.slug %>/terms">Voucher terms</a>
      <a href="/<%= venue.slug %>/balance">Check a balance</a>
      <% if (brand.links && brand.links.website) { %><a href="<%= brand.links.website %>" rel="noopener">The venue’s website</a><% } %>
    </div>
    <% } %>
    <div class="theme-pick" role="group" aria-label="Appearance">
      <button type="button" data-theme-pick="system" aria-pressed="false"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/></svg>Auto</button>
      <button type="button" data-theme-pick="light" aria-pressed="false"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Light</button>
      <button type="button" data-theme-pick="dark" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>Dark</button>
    </div>
    <div class="powered">
      <svg width="18" height="13" viewBox="0 0 100 70" aria-hidden="true"><path fill="#a5c715" d="M0,0 L22.7,0 L50.7,49 L77.3,0 L100,0 L62,70 L40,70 Z"/><path fill="#111111" d="M58.3,35 L81,35 L62,70 L40,70 L50.7,49 Z"/></svg>
      <span>Powered by Vesopa</span>
    </div>
  </div>
</footer>
<% (locals.scripts || []).forEach(function (s) { %><script src="<%= asset(s) %>" defer></script>
<% }) %>
</body>
</html>
