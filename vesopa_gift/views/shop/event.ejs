<%- include('_head') %>

<% if (event.imageUrl) { %>
<header class="event-hero"><img src="<%= event.imageUrl %>" alt=""></header>
<% } else { %>
<%# No picture: the venue's slim bar, not 250px of its colour with nothing on it. %>
<div class="bar"><div class="narrow">
  <a class="back" href="/<%= venue.slug %>" aria-label="Back to <%= brand.name %>"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#14161A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></a>
  <%- include('_logo', { size: 's30', brand: brand, initials: initials }) %>
  <a class="name" href="/<%= venue.slug %>"><%= brand.name %></a>
</div></div>
<% } %>

<main class="narrow">
  <div class="group">
    <a class="eyebrow" href="/<%= venue.slug %>"><%= brand.name %></a>
    <h1 class="serif"><%= event.title %></h1>
    <div class="facts">
      <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#63696F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg><%= when(event.starts_at, { withTime: false }) %></div>
      <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#63696F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><%= when(event.starts_at).split(', ').pop() %><%= event.ends_at ? ' to ' + when(event.ends_at).split(', ').pop() : '' %><%= event.doors_at ? ' · doors at ' + when(event.doors_at).split(', ').pop() : '' %></div>
      <% if (event.location) { %><div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#63696F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><%= event.location %></div><% } %>
    </div>
    <% if (event.description) { %><p class="pretty"><%= event.description %></p><% } %>
  </div>

  <% if (closed) { %>
  <div class="group"><div class="error-box"><%= closed %></div></div>
  <% } else { %>
  <form class="form" method="post" action="/<%= venue.slug %>/events/<%= event.public_id %>" novalidate data-tickets>
    <div class="group">
      <div class="stack gap-6">
        <h2 class="serif">Tickets</h2>
        <% if (left.overall <= 20) { %><span class="left"><%= left.overall %> left</span><% } %>
      </div>
      <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
      <% types.forEach(function (t) { var soldOut = t.capacity != null && left.byType[t.id] <= 0; %>
      <div class="ticket-type">
        <div class="txt">
          <span class="t1"><strong><%= t.name %></strong></span>
          <span class="small muted"><%= money(t.price_minor) %><%= t.description ? ' · ' + t.description : '' %><%= soldOut ? ' · sold out' : '' %></span>
        </div>
        <div class="stepper" data-price="<%= t.price_minor %>">
          <button type="button" data-step="-1" aria-label="One fewer <%= t.name %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 12h12"/></svg></button>
          <input type="number" name="qty_<%= t.id %>" min="0" max="<%= soldOut ? 0 : Math.min(maxPerOrder, left.overall, t.capacity != null ? left.byType[t.id] : 99) %>" value="<%= values['qty_' + t.id] || 0 %>" inputmode="numeric" aria-label="How many <%= t.name %>" <%= soldOut ? 'disabled' : '' %>>
          <button type="button" class="plus" data-step="1" aria-label="One more <%= t.name %>" <%= soldOut ? 'disabled' : '' %>><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 12h12M12 6v12"/></svg></button>
        </div>
      </div>
      <% }) %>
    </div>

    <div role="group" class="group">
      <span class="label">Whose name are the tickets under?</span>
      <label class="field-label <%= field === 'buyer_name' ? 'field-error' : '' %>">Your name<input class="input" name="buyer_name" autocomplete="name" maxlength="120" value="<%= values.buyer_name || '' %>"></label>
      <label class="field-label <%= field === 'buyer_email' ? 'field-error' : '' %>">Your email address<input class="input" type="email" name="buyer_email" autocomplete="email" maxlength="190" value="<%= values.buyer_email || '' %>"></label>
      <span class="hint">The tickets are emailed here, each with its own code for the door.</span>
    </div>

    <div class="summary"><div class="row total"><span>Total</span><span data-ticket-total>£0.00</span></div></div>
    <div class="pay">
      <button class="btn primary block big" type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span data-ticket-pay>Pay</span></button>
      <p class="hint center">Paid straight to <%= brand.name %>. Refunds are the venue’s to give — <a href="/<%= venue.slug %>/terms">terms</a>.</p>
    </div>
  </form>
  <% } %>
</main>

<%- include('_foot') %>
