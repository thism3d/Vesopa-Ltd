<%- include('_top', { nav: 'experiences' }) %>
<% var base = '/admin/v/' + venue.office_id; %>

<div class="page-head">
  <div>
    <h2>Experiences</h2>
    <p class="muted">A voucher for one named thing at a fixed price — Sunday lunch for two, afternoon tea. At the till it shows its name beside the balance, so the right thing gets rung up.</p>
  </div>
</div>

<div class="grid-2e">
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Experience</th><th class="right">Price</th><th class="right">On sale</th></tr></thead>
        <tbody>
          <% if (!products.length) { %><tr><td colspan="3" class="empty">None yet. Add the first on the right.</td></tr><% } %>
          <% products.forEach(function (p) { %>
          <tr class="<%= editing && editing.id === p.id ? 'selected' : '' %>">
            <td><a class="rowlink" href="<%= base %>/experiences?edit=<%= p.id %>"><%= p.name %></a><% if (p.description) { %><br><span class="small muted"><%= p.description %></span><% } %></td>
            <td class="right num"><%= money(p.price_minor, { always: true }) %></td>
            <td class="right">
              <form method="post" action="<%= base %>/experiences/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= session.csrf %>"><button class="switch <%= p.on_sale ? 'on' : '' %>" type="submit" aria-label="<%= p.on_sale ? 'Take off sale' : 'Put on sale' %>" aria-pressed="<%= p.on_sale ? 'true' : 'false' %>"></button></form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <form class="card pad" method="post" action="<%= base %>/experiences<%= editing ? '/' + editing.id : '' %>">
    <input type="hidden" name="_csrf" value="<%= session.csrf %>">
    <h3><%= editing ? 'Change ' + editing.name : 'Add an experience' %></h3>
    <label class="lbl">Name<input class="in" name="name" maxlength="120" required value="<%= editing ? editing.name : '' %>" placeholder="Sunday lunch for two"></label>
    <label class="lbl">What it includes<textarea class="in" name="description" maxlength="500" placeholder="Two courses and a glass of wine each."><%= editing ? editing.description || '' : '' %></textarea></label>
    <div class="row2">
      <label class="lbl">Price<input class="in" name="price" inputmode="decimal" required value="<%= editing ? (editing.price_minor / 100).toFixed(2) : '' %>" placeholder="48.00"></label>
      <label class="lbl">Picture
        <select class="in" name="design_id">
          <% designs.forEach(function (d) { %><option value="<%= d.id %>" <%= editing && editing.design_id === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %>
        </select>
      </label>
    </div>
    <p class="help">Spent in one go at the till. Anything it does not cover is paid the usual way.</p>
    <div class="actions">
      <button class="btn primary" type="submit"><%= editing ? 'Save' : 'Add it' %></button>
      <% if (editing) { %><a class="btn ghost" href="<%= base %>/experiences">Cancel</a><% } %>
    </div>
  </form>
</div>

<%- include('_bottom') %>
