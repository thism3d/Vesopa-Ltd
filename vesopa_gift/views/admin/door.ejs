<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0d1014">
<title>Door · <%= event.title %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="<%= asset('/img/icon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
</head>
<body class="door">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 8h3l1.5-2.5h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/></symbol>
  <symbol id="i-stop" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></symbol>
  <symbol id="i-switch" viewBox="0 0 24 24"><path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6"/><path d="M17.7 3v3.4h-3.4M6.3 21v-3.4h3.4"/></symbol>
  <symbol id="i-torch" viewBox="0 0 24 24"><path d="M9 3h6l1 4H8zM8 7h8v3l-2 2v9H10v-9L8 10z"/><path d="M12 14v3"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></symbol>
  <symbol id="i-undo" viewBox="0 0 24 24"><path d="M4 10h11a5 5 0 0 1 0 10H9"/><path d="M8 6l-4 4 4 4"/></symbol>
  <symbol id="i-sound" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/></symbol>
  <symbol id="i-mute" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16 9l5 6M21 9l-5 6"/></symbol>
  <symbol id="i-keys" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M9 14h6"/></symbol>
  <symbol id="i-tick" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></symbol>
  <symbol id="i-cross" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="i-qr" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 14h3v3h-3zM19 14h2M14 19h2M19 19h2v2"/></symbol>
</svg>

<div class="door-wrap" data-door="/admin/v/<%= venue.office_id %>/door/<%= event.id %>" data-csrf="<%= session.csrf %>">
  <div class="door-head">
    <div class="t"><small>Door · <%= venueName %></small><strong><%= event.title %></strong></div>
    <div class="door-count"><b data-in><%= used %></b><span>of <b data-total><%= total %></b> in</span></div>
  </div>

  <div class="camera" data-cam>
    <video data-video playsinline muted autoplay></video>
    <div class="idle" data-idle>
      <svg class="ico"><use href="#i-qr"/></svg>
    </div>
    <div class="frame" aria-hidden="true"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i><i class="scan"></i></div>
    <span class="hint" data-hint>Tap Start the camera, plug in a scanner, or type the code</span>
  </div>

  <div class="verdict" data-verdict aria-live="assertive">
    <div class="mark" data-mark><span class="dot"></span></div>
    <div class="say"><b data-say>Ready</b><span data-detail>Scan a ticket, or type its code.</span></div>
  </div>
  <div class="door-last" data-last hidden></div>

  <form class="door-type" data-type>
    <label class="field"><svg class="ico"><use href="#i-keys"/></svg>
      <input name="code" maxlength="12" placeholder="Type a code" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Ticket code">
    </label>
    <button type="submit">Check</button>
  </form>

  <div class="door-actions">
    <button type="button" data-camera><svg class="ico"><use href="#i-camera"/></svg><span>Start the camera</span></button>
    <button type="button" data-stop hidden><svg class="ico"><use href="#i-stop"/></svg><span>Stop the camera</span></button>
    <button type="button" data-switch hidden><svg class="ico"><use href="#i-switch"/></svg><span>Switch camera</span></button>
    <button type="button" data-torch hidden aria-pressed="false"><svg class="ico"><use href="#i-torch"/></svg><span>Torch</span></button>
    <button type="button" data-undo hidden><svg class="ico"><use href="#i-undo"/></svg><span>Undo last</span></button>
    <button type="button" data-sound aria-pressed="true"><svg class="ico"><use href="#i-sound"/></svg><span>Sound on</span></button>
    <a href="/admin/v/<%= venue.office_id %>/events/<%= event.id %>/guests"><svg class="ico"><use href="#i-list"/></svg><span>Guest list</span></a>
  </div>
</div>
<script src="<%= asset('/vendor/jsQR.js') %>" defer></script>
<script src="<%= asset('/js/door.js') %>" defer></script>
</body>
</html>
