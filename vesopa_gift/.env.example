# Vesopa Gift — copy to .env on the server and fill in. Never commit the real one.

NODE_ENV=production
PORT=5070
BASE_URL=https://gift.vesopa.com

# The EPOS this shop sells for. Loopback on the live box.
EPOS_API=http://127.0.0.1:5060
# The same value as GIFT_SERVICE_KEY in the back office's .env. 48+ random bytes.
GIFT_SERVICE_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopa_giftdb
DB_USER=
DB_PASSWORD=

# Continue with Vesopa for the staff console: the "Vesopa Gift" client in
# Vesopa Auth. The secret is minted with vesopa_auth/scripts/mint-client-secret.js.
VESOPA_AUTH_ISSUER=https://auth.vesopa.com
VESOPA_AUTH_CLIENT_ID=
VESOPA_AUTH_CLIENT_SECRET=
# Continue with Vesopa for BUYERS on the shop: the "Vesopa Gift Shop" client
# (vesopa_auth/schema/schema_019_gift_shop_client.sql), open to anyone.
VESOPA_AUTH_SHOP_CLIENT_ID=
VESOPA_AUTH_SHOP_CLIENT_SECRET=

# Random, 32+ bytes.
SESSION_SECRET=

# The customer-facing mailbox the menu and loyalty app already send from.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Office ids labelled "Test venue" in the owner's list.
GIFT_TEST_OFFICES=9

# admin.vesopa.com (2026-10-05): the key it calls /api/admin with, 32+ characters,
# the same value as GIFT_SERVICE_KEY in vesopa_admin. Unset refuses it.
ADMIN_SERVICE_KEY=

# admin.vesopa.com, once it is live (https://admin.vesopa.com). Set, the shop
# switches on Venues link there instead. Unset changes nothing.
ADMIN_CONSOLE_URL=
