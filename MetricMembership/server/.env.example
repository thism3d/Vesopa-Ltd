# Metric Membership server (metric.vesopa.com). Copy to .env; never commit .env.
NODE_ENV=production
PORT=5085
BASE_URL=https://metric.vesopa.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vesopasoftware_metricdb
DB_USER=vesopasoftware_metricdb
DB_PASSWORD=

# Continue with Vesopa: SELECT client_id FROM applications WHERE slug = 'vesopa-metric'
# (vesopa_auth/schema/schema_025_metric_client.sql). Public client, no secret.
VESOPA_AUTH_ISSUER=https://auth.vesopa.com
VESOPA_METRIC_CLIENT_ID=

# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# Who may open /admin (comma list of Vesopa account emails).
METRIC_ADMIN_EMAILS=

# Barriers open for new members straight away (true), or only once staff approve (false).
METRIC_AUTO_APPROVE=false
METRIC_MAX_VEHICLES=3

# Allow-list push to cameras: how often the full list is reconciled.
METRIC_SYNC_EVERY_MS=300000

# Activity log files (logs/metric-activity-YYYY-MM-DD.jsonl) and how long to keep them.
LOG_DIR=
LOG_KEEP_DAYS=90
