# Vesopa Express -- the kiosk's build settings.
#
# The kiosk is configured at BUILD time with --dart-define, not from a file at
# run time, and it holds NO secrets: it is a public client on a screen in a
# room full of strangers. The Dojo key, the sealing key and everything else
# that moves money live only on the server, in vesopa_server/.env
# (EXPRESS_DOJO_API_KEY, EXPRESS_SECRET_KEY, DOJO_SOFTWARE_HOUSE_ID,
# DOJO_RESELLER_ID). Nothing in this file may ever be one of those.
#
# Pass these as: flutter run --dart-define=EXPRESS_API=... (or build windows).

# The back office the kiosk talks to.
EXPRESS_API=https://backoffice.vesopaepos.com

# Development and screenshots only: an ordinary window instead of the
# full-screen kiosk lock, at this size.
EXPRESS_WINDOWED=false
EXPRESS_W=608
EXPRESS_H=1080

# Integration tests only: a kiosk token minted on the server for the TEST
# venue (vesopa_server/tool/verify-express-live.js prints one). Blank in every
# real build.
EXPRESS_TOKEN=
