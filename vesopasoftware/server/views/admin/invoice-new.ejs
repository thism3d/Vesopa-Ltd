<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<div class="wrap">
  <div class="page-head">
    <div class="grow"><span class="eyebrow">Bill somebody</span><h1>New invoice</h1></div>
    <a class="btn ghost" href="/portal/admin/invoices">All invoices</a>
  </div>
  <form method="post" action="/portal/admin/invoices/new">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="split">
      <div class="panel">
        <h2>Lines</h2>
        <div id="lines">
          <div class="line fields" style="align-items:end;margin-bottom:.6rem">
            <div class="field" style="flex:2"><label>Description</label><input name="description" placeholder="Stage two — build"></div>
            <div class="field" style="max-width:6rem"><label>Qty</label><input name="qty" type="number" step="0.01" value="1"></div>
            <div class="field" style="max-width:9rem"><label>Unit price</label><input name="unit_price" type="number" step="0.01" placeholder="0.00"></div>
            <div class="field" style="max-width:8rem"><label>Amount</label>
              <div class="strong-num" style="padding:.58rem 0"><span class="line-amount">0.00</span></div></div>
            <div class="field" style="max-width:3rem"><label>&nbsp;</label>
              <button class="btn danger small drop-line" type="button">×</button></div>
          </div>
        </div>
        <button class="btn ghost small" id="add-line" type="button">Add another line</button>
        <hr>
        <div style="display:grid;gap:.3rem;max-width:16rem;margin-left:auto;font-size:.9rem">
          <div style="display:flex"><span style="flex:1" class="muted">Subtotal</span><span class="strong-num" id="sub">0.00</span></div>
          <div style="display:flex"><span style="flex:1" class="muted">VAT</span><span class="strong-num" id="tax">0.00</span></div>
          <div style="display:flex;font-weight:700"><span style="flex:1">Total</span><span class="strong-num" id="tot">0.00</span></div>
        </div>
      </div>
      <div>
        <div class="panel">
          <h3>Who and what for</h3>
          <div class="field">
            <label for="user_id">Customer</label>
            <select id="user_id" name="user_id" required>
              <option value="">Choose…</option>
              <% for (const c of customers) { %>
                <option value="<%= c.id %>" <%= String(preset.user_id) === String(c.id) ? "selected" : "" %>>
                  <%= c.name %><%= c.company ? " — " + c.company : "" %></option>
              <% } %>
            </select>
          </div>
          <div class="field">
            <label for="project_id">Project <span class="muted">(optional)</span></label>
            <select id="project_id" name="project_id">
              <option value="">None</option>
              <% for (const p of projects) { %>
                <option value="<%= p.id %>" <%= String(preset.project_id) === String(p.id) ? "selected" : "" %>>
                  <%= p.ref %> — <%= p.title %></option>
              <% } %>
            </select>
          </div>
          <div class="fields">
            <div class="field"><label for="due_days">Due in days</label><input id="due_days" name="due_days" type="number" value="14"></div>
            <div class="field"><label for="tax_rate">VAT %</label><input id="tax_rate" name="tax_rate" type="number" step="0.01" value="0"></div>
          </div>
          <div class="field"><label for="notes">Notes on the invoice</label><textarea id="notes" name="notes" rows="3"></textarea></div>
          <button class="btn ghost" type="submit" style="width:100%;justify-content:center;margin-bottom:.5rem">Save as draft</button>
          <button class="btn" type="submit" name="send" value="1" style="width:100%;justify-content:center">Save and email it</button>
        </div>
      </div>
    </div>
  </form>
</div>
<%- include("../partials/foot") %>
