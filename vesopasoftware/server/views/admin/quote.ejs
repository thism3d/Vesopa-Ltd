<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<% const feats = featureIds(quote.features); const st = QUOTE_STATUS[quote.status] || { label: quote.status, pill: "" }; %>
<div class="wrap">
  <div class="page-head">
    <div class="grow">
      <span class="eyebrow">Quote <%= quote.ref %> · received <span class="mono"><%= date(quote.created_at) %></span></span>
      <h1><%= quote.name %></h1>
      <p><%= quote.email %><% if (quote.phone) { %> · <%= quote.phone %><% } %><% if (quote.company) { %> · <%= quote.company %><% } %></p>
    </div>
    <span class="pill <%= st.pill %>"><%= st.label %></span>
    <a class="btn ghost" href="/portal/admin/quotes">All quotes</a>
  </div>

  <div class="split">
    <div>
      <div class="panel">
        <h2>What they asked for</h2>
        <div class="grid g3" style="margin-bottom:1rem">
          <div class="stat plain" style="padding:.7rem .9rem"><b style="font-size:1rem"><%= serviceLabel(quote.service_type) %></b><span>Kind of work</span></div>
          <div class="stat plain" style="padding:.7rem .9rem"><b style="font-size:1rem"><%= tierLabel(quote.scope_tier) %></b><span>Scope</span></div>
          <div class="stat plain" style="padding:.7rem .9rem"><b style="font-size:1rem"><%= timelineLabel(quote.timeline) %></b><span>Timeline</span></div>
        </div>
        <div class="stat">
          <b><%= moneyRound(quote.estimate_min, quote.currency) %> – <%= moneyRound(quote.estimate_max, quote.currency) %></b>
          <span>What the calculator told them</span>
        </div>
        <% if (feats.length) { %>
          <hr><div class="mono muted" style="font-size:.62rem;margin-bottom:.4rem">THEY TICKED</div>
          <div class="chips"><% for (const f of feats) { %><span class="pill"><%= featureLabel(f) %></span><% } %></div>
        <% } %>
        <% if (quote.message) { %>
          <hr><div class="mono muted" style="font-size:.62rem;margin-bottom:.4rem">IN THEIR WORDS</div>
          <p style="white-space:pre-wrap;font-size:.92rem"><%= quote.message %></p>
        <% } %>
      </div>

      <div class="panel">
        <h2>Our firm quote</h2>
        <% if (quote.quoted_at) { %>
          <p class="muted" style="font-size:.84rem">Sent <%= datetime(quote.quoted_at) %>
            <% if (quote.responded_at) { %> · customer <%= quote.status === "accepted" ? "accepted" : "declined" %> it <%= datetime(quote.responded_at) %><% } %></p>
          <% if (quote.response_note) { %><p class="notice warn">Their reason: “<%= quote.response_note %>”</p><% } %>
        <% } else { %>
          <p class="muted" style="font-size:.84rem">Not sent yet. The customer can accept or decline it from their portal once it is.</p>
        <% } %>
        <form method="post" action="/portal/admin/quotes/<%= quote.id %>/offer">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="quoted_amount">Figure (<%= quote.currency %>, leave blank if the note carries the pricing)</label>
            <input id="quoted_amount" name="quoted_amount" type="number" step="0.01" min="0"
                   value="<%= quote.quoted_amount != null ? quote.quoted_amount : '' %>"></div>
          <div class="field"><label for="quote_note">What it covers</label>
            <textarea id="quote_note" name="quote_note" rows="6" required
              placeholder="What is included, what is not, the stages, and when we can start."><%= quote.quote_note || '' %></textarea></div>
          <button class="btn" type="submit" style="width:100%;justify-content:center">
            <%= quote.quoted_at ? "Update and resend the quote" : "Send the quote" %></button>
          <p class="hint">Emails it to <%= quote.email %> and marks the quote “<%= QUOTE_STATUS.quoted.label %>”.</p>
        </form>
      </div>
    </div>

    <div>
      <div class="panel">
        <h3>Move it on</h3>
        <form method="post" action="/portal/admin/quotes/<%= quote.id %>/status" style="margin-bottom:1rem">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <% for (const [s, v] of Object.entries(QUOTE_STATUS)) { %>
                <option value="<%= s %>" <%= quote.status === s ? "selected" : "" %>><%= v.label %></option>
              <% } %>
            </select>
          </div>
          <button class="btn ghost" type="submit" style="width:100%;justify-content:center">Save status</button>
        </form>
        <hr>
        <% if (project) { %>
          <h3>Project</h3>
          <p><a href="/portal/admin/projects/<%= project.id %>"><%= project.ref %> — <%= project.title %></a></p>
        <% } else { %>
          <h3>Turn it into a project</h3>
          <form method="post" action="/portal/admin/quotes/<%= quote.id %>/convert">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="field"><label for="title">Project name</label>
              <input id="title" name="title" value="<%= (quote.company || quote.name) + ' — ' + serviceLabel(quote.service_type) %>"></div>
            <div class="field"><label for="budget">Agreed budget</label>
              <input id="budget" name="budget" type="number" step="0.01"
                     value="<%= quote.quoted_amount != null ? quote.quoted_amount : quote.estimate_min %>"></div>
            <button class="btn" type="submit" style="width:100%;justify-content:center">Open the project</button>
          </form>
          <p class="hint">If they have no account we create one and email them a link to set their own password.</p>
        <% } %>
      </div>
      <% if (customer) { %>
        <div class="panel">
          <h3>Existing customer</h3>
          <p><a href="/portal/admin/customers/<%= customer.id %>"><%= customer.name %></a></p>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include("../partials/foot") %>
