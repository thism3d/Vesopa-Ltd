<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<%
/* The project hub, admin side.
 *
 * This was eight stacked panels — settings, conversation, invoicing, files,
 * updates, charges, members, timeline — and the conversation was buried in the
 * middle of them. Whoever picked a project up had to read all eight and
 * reconstruct the order things happened in, which is the same complaint the
 * customer side had before it was rebuilt around one feed.
 *
 * So this is the customer hub's spine with the admin's powers folded back in
 * rather than bolted alongside: the conversation is the page, and everything
 * that acts on the project sits beside it in a disclosure that is closed until
 * it is wanted. Two differences from the customer view, both deliberate:
 * internal updates and hidden tasks are visible here, and every one of them is
 * labelled as such so nobody posts to the wrong audience by accident.
 */
const fmtDay = (d) => new Date(d).toLocaleDateString("en-GB",
  { weekday: "short", day: "numeric", month: "short", year: "numeric" });
const initials = (n) => String(n || "?").split(" ").map(w => w[0]).slice(0,2).join("").toUpperCase();
const isImg = (m) => /^image\//.test(m || "");
const STATUS = { enquiry:"info", scoping:"info", in_progress:"lime", review:"warn",
                 on_hold:"warn", live:"ok", complete:"ok", cancelled:"bad" };
const pendingCharges = charges.filter(c => c.status === "pending");
const pendingTotal = pendingCharges.reduce((s,c) => s + Number(c.amount||0), 0);
const nextDue = buckets.open.find(t => t.due_date);
const cal = calendar.month;
const prev = new Date(cal.getFullYear(), cal.getMonth() - 1, 1);
const next = new Date(cal.getFullYear(), cal.getMonth() + 1, 1);
const calBase = `/portal/admin/projects/${project.id}`;
%>

<div class="wrap">

  <!-- ---------- pinned: what this is, where it is ---------- -->
  <div class="hub-head panel">
    <div class="hub-head-top">
      <div class="grow">
        <span class="eyebrow"><a href="/portal/admin/projects" class="muted">Projects</a> · <%= project.ref %> ·
          <a href="/portal/admin/customers/<%= customer.id %>"><%= customer.name %></a><%
          if (customer.company) { %> · <%= customer.company %><% } %></span>
        <h1><%= project.title %></h1>
      </div>
      <span class="pill <%= STATUS[project.status] || '' %>"><%=
        PROJECT_STATUS[project.status] ? PROJECT_STATUS[project.status].label : project.status %></span>
      <a class="btn ghost small" href="/portal/projects/<%= project.id %>">See it as the customer</a>
    </div>

    <% if (project.description) { %>
      <p class="hub-brief"><%= project.description %></p>
    <% } %>

    <div class="hub-facts">
      <div class="progress-line" style="min-width:12rem;flex:1">
        <div class="bar" data-task-progress><i style="width:<%= project.progress_pct || 0 %>%"></i></div>
        <b data-task-progress-label><%= project.progress_pct || 0 %>%</b>
      </div>
      <span class="hub-fact"><small>Next up</small>
        <b><%= nextDue ? nextDue.title : (buckets.open.length ? buckets.open[0].title : "Nothing outstanding") %></b>
        <% if (nextDue && nextDue.due_date) { %><time datetime="<%= new Date(nextDue.due_date).toISOString() %>"></time><% } %>
      </span>
      <span class="hub-fact"><small>Open tasks</small><b><%= buckets.open.length %><%
        if (buckets.overdue) { %> <span class="pill bad"><%= buckets.overdue %> overdue</span><% } %></b></span>
      <% if (pendingTotal) { %>
        <span class="hub-fact"><small>Uninvoiced</small>
          <b><%= moneyRound(pendingTotal, project.currency) %></b></span>
      <% } %>
      <span class="hub-fact"><small>Team</small>
        <b class="hub-avatars">
          <% for (const m of members.slice(0,6)) { %><span class="avatar sm <%= m.side === 'vesopa' ? 'v' : '' %>"
             title="<%= m.name %> — <%= m.side === 'vesopa' ? 'Vesopa' : roleLabel(m.org_role) %>"><%= initials(m.name) %></span><% } %>
        </b>
      </span>
    </div>
  </div>

  <div class="hub">
    <!-- ================= the feed ================= -->
    <section class="panel hub-feed" aria-label="Project activity">
      <div class="panel-head">
        <h2>Activity</h2>
        <span class="spacer"></span>
        <span class="live" id="live-thread"></span>
        <span class="mono muted" style="font-size:.63rem"><%= timeline.reduce((n,d)=>n+d.entries.length,0) %> entries</span>
      </div>

      <div class="thread" id="thread" data-project="<%= project.id %>">
        <% if (!timeline.length) { %>
          <p class="muted" style="text-align:center;padding:2rem 0">
            Nothing here yet. Open the conversation — this is where every update, file and decision will live.
          </p>
        <% } %>

        <% for (const day of timeline) { %>
          <div class="day-rule"><span><%= fmtDay(day.date) %></span></div>

          <% for (const e of day.entries) { %>
            <% if (e.kind === "message") { %>
              <div class="msg <%= e.userId === user.id ? 'mine' : '' %> <%= e.authorRole === 'admin' ? 'vesopa' : '' %> <%= e.private ? 'private' : '' %>"
                   data-msg="<%= e.id %>">
                <div class="who"><%= initials(e.author) %></div>
                <div class="bubble">
                  <div class="meta">
                    <b><%= e.author || "Someone" %></b>
                    <% if (e.authorRole === "admin") { %><span class="pill lime">Vesopa</span><% } %>
                    <% if (e.private) { %><span class="pill warn">Private</span><% } %>
                    <time datetime="<%= new Date(e.at).toISOString() %>"></time>
                  </div>
                  <div class="body"><%= e.body %></div>

                  <% if (e.attachments && e.attachments.length) { %>
                    <div class="msg-files">
                      <% for (const f of e.attachments) { %>
                        <a class="file" href="/portal/files/<%= f.id %>"
                           data-preview="<%= f.id %>" data-name="<%= f.original_name %>" data-mime="<%= f.mime %>">
                          <span class="thumb">
                            <% if (isImg(f.mime)) { %><img src="/portal/files/<%= f.id %>" alt="<%= f.original_name %>" loading="lazy">
                            <% } else { %><%= (f.original_name.split(".").pop() || "file").toUpperCase() %><% } %>
                          </span>
                          <span class="meta"><b><%= f.original_name %></b><small><%= prettySize(f.size_bytes) %></small></span>
                        </a>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (e.invoice) { %>
                    <div class="inv-card">
                      <b><%= e.invoice.number %></b>
                      <span class="pill <%= e.invoice.status === 'paid' ? 'ok' : 'warn' %>"><%= e.invoice.status %></span>
                      <span class="spacer"></span>
                      <a class="btn ghost small" href="/portal/admin/invoices/<%= e.invoice.id %>">Open</a>
                    </div>
                  <% } %>
                </div>
              </div>

            <% } else if (e.kind === "update") { %>
              <div class="ev ev-update <%= e.internal ? 'is-internal' : '' %>">
                <span class="ev-dot" aria-hidden="true"></span>
                <div class="ev-body">
                  <div class="meta"><b><%= e.title %></b>
                    <% if (e.internal) { %><span class="pill warn">Internal</span>
                    <% } else { %><span class="pill lime">Update</span><% } %>
                    <time datetime="<%= new Date(e.at).toISOString() %>"></time>
                  </div>
                  <% if (e.body) { %><p><%= e.body %></p><% } %>
                  <% if (e.progress != null) { %>
                    <div class="progress-line" style="margin-top:.5rem">
                      <div class="bar thin"><i style="width:<%= e.progress %>%"></i></div><b><%= e.progress %>%</b>
                    </div>
                  <% } %>
                  <small class="muted"><%= e.author || "Vesopa" %></small>
                </div>
              </div>

            <% } else if (e.kind === "file") { %>
              <div class="ev ev-file">
                <span class="ev-dot" aria-hidden="true"></span>
                <div class="ev-body">
                  <div class="meta"><b><%= e.uploader || "Someone" %> added a file</b>
                    <time datetime="<%= new Date(e.at).toISOString() %>"></time></div>
                  <div class="msg-files">
                    <a class="file" href="/portal/files/<%= e.id %>"
                       data-preview="<%= e.id %>" data-name="<%= e.name %>" data-mime="<%= e.mime %>">
                      <span class="thumb">
                        <% if (isImg(e.mime)) { %><img src="/portal/files/<%= e.id %>" alt="<%= e.name %>" loading="lazy">
                        <% } else { %><%= (e.name.split(".").pop() || "file").toUpperCase() %><% } %>
                      </span>
                      <span class="meta"><b><%= e.name %></b><small><%= prettySize(e.size) %></small></span>
                    </a>
                  </div>
                </div>
              </div>

            <% } else if (e.kind === "task") { %>
              <div class="ev ev-task <%= e.event === 'done' ? 'is-done' : '' %>">
                <span class="ev-dot" aria-hidden="true"></span>
                <div class="ev-body">
                  <div class="meta">
                    <% if (e.group) { %>
                      <%# A batch, folded by lib/timeline.js — eight identical
                          rows is a wall, one row with the list is the fact. %>
                      <b><%= e.group.length %> tasks <%= e.event === "done" ? "completed" : "added" %></b>
                      <time datetime="<%= new Date(e.at).toISOString() %>"></time>
                    <% } else { %>
                      <b><%= e.event === "done" ? "Completed" : "Task added" %></b>
                      <span><%= e.title %></span>
                      <time datetime="<%= new Date(e.at).toISOString() %>"></time>
                    <% } %>
                  </div>
                  <% if (e.group) { %>
                    <ul class="ev-list">
                      <% for (const t of e.group) { %><li><%= t.title %></li><% } %>
                    </ul>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% } %>
        <% } %>
      </div>

      <p class="typing" id="typing"></p>

      <form class="composer" id="composer" method="post" action="/portal/projects/<%= project.id %>/messages">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row">
          <textarea name="body" rows="2" placeholder="Reply to the customer… (Enter sends, Shift+Enter for a new line)"></textarea>
          <button class="btn" type="submit">Send</button>
        </div>
        <div class="row">
          <select name="recipient_id" aria-label="Who sees this">
            <option value="">Everyone on this project</option>
            <% for (const mem of members) { if (mem.user_id === user.id) continue; %>
              <option value="<%= mem.user_id %>">Private to <%= mem.name %></option>
            <% } %>
          </select>
        </div>
      </form>

      <form class="composer-files" method="post" enctype="multipart/form-data"
            action="/portal/projects/<%= project.id %>/files">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="dropzone" id="dropzone">
          <input type="file" name="files" multiple hidden id="file-input">
          <b>Add images or files</b>
          <small>Drop them here, or choose. They appear in the conversation above.</small>
        </label>
        <div class="btn-row" id="file-go" hidden>
          <span class="mono muted" id="file-count"></span>
          <span class="spacer" style="flex:1"></span>
          <button class="btn small" type="submit">Upload</button>
        </div>
      </form>
    </section>

    <!-- ================= the side ================= -->
    <aside class="hub-side">

      <!-- ---------- board ---------- -->
      <section class="panel" aria-label="Tasks">
        <div class="panel-head">
          <h3>Board</h3>
          <span class="spacer"></span>
          <div class="seg" role="tablist">
            <button class="on" data-bucket="open" role="tab">Open <b><%= buckets.open.length %></b></button>
            <button data-bucket="done" role="tab">Done <b><%= buckets.done.length %></b></button>
            <button data-bucket="archived" role="tab">Archive <b><%= buckets.archived.length %></b></button>
          </div>
        </div>

        <% for (const key of ["open","done","archived"]) { %>
          <ul class="tasks bucket" data-bucket-list="<%= key %>" <%= key === "open" ? "" : "hidden" %>>
            <% if (!buckets[key].length) { %>
              <li class="t-empty">Nothing <%= key === "open" ? "outstanding" : key %>.</li>
            <% } %>
            <% for (const t of buckets[key]) { %>
              <li class="task <%= t.status === 'done' ? 'done' : '' %>" data-task-row="<%= t.id %>">
                <input type="checkbox" data-task="<%= t.id %>" <%= t.status === "done" ? "checked" : "" %>
                       <%= key === "archived" ? "disabled" : "" %> aria-label="Mark done">
                <div class="grow">
                  <b><%= t.title %><% if (!t.is_visible) { %> <span class="pill warn">Hidden</span><% } %></b>
                  <small>
                    <% if (t.due_date) { %>
                      <span class="<%= t.status !== 'done' && new Date(t.due_date) < new Date() ? 'overdue' : '' %>">
                        due <time datetime="<%= new Date(t.due_date).toISOString() %>"></time></span> ·
                    <% } %>
                    <%= t.assignee ? t.assignee : (t.creator ? "raised by " + t.creator : "unassigned") %>
                  </small>
                </div>
                <button class="task-arch" type="button" data-archive="<%= t.id %>"
                        data-restore="<%= key === 'archived' ? '1' : '0' %>"
                        title="<%= key === 'archived' ? 'Restore' : 'Archive' %>">
                  <%= key === "archived" ? "↺" : "×" %>
                </button>
              </li>
            <% } %>
          </ul>
        <% } %>

        <form class="task-new" id="task-new" method="post" action="/portal/projects/<%= project.id %>/tasks">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="title" placeholder="Add a task…" maxlength="200" required>
          <input name="due_date" type="date" aria-label="Due date">
          <button class="btn small" type="submit">Add</button>
        </form>
      </section>

      <!-- ---------- calendar ---------- -->
      <section class="panel" aria-label="Calendar">
        <div class="panel-head">
          <h3><%= cal.toLocaleDateString("en-GB",{month:"long",year:"numeric"}) %></h3>
          <span class="spacer"></span>
          <a class="btn ghost small" href="<%= calBase %>?y=<%= prev.getFullYear() %>&m=<%= prev.getMonth() %>#cal" aria-label="Previous month">‹</a>
          <a class="btn ghost small" href="<%= calBase %>#cal" aria-label="This month">Today</a>
          <a class="btn ghost small" href="<%= calBase %>?y=<%= next.getFullYear() %>&m=<%= next.getMonth() %>#cal" aria-label="Next month">›</a>
        </div>
        <div class="cal" id="cal">
          <% for (const d of ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]) { %>
            <span class="cal-h"><%= d %></span>
          <% } %>
          <% for (const c of calendar.cells) { %>
            <div class="cal-d <%= c.inMonth ? "" : "out" %> <%= c.today ? "today" : "" %> <%= c.tasks.length ? "has" : "" %>"
                 <%= c.tasks.length ? `title="${c.tasks.map(t=>t.title.replace(/"/g,"")).join(" · ")}"` : "" %>>
              <span><%= c.day %></span>
              <% if (c.tasks.length) { %>
                <i class="cal-dots" aria-hidden="true"><% for (const t of c.tasks.slice(0,3)) { %><b class="<%= t.status === 'done' ? 'ok' : (new Date(t.due_date) < new Date() ? 'bad' : '') %>"></b><% } %></i>
              <% } %>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ---------- the things only this side can do ----------
           Disclosures, closed by default. Each one was a permanently open
           panel and together they pushed the conversation off the screen; they
           are used a few times in a project's life, and the feed is used every
           day. -->

      <details class="panel act">
        <summary><h3>Post an update</h3><small>Publishes to the feed</small></summary>
        <form method="post" action="/portal/admin/projects/<%= project.id %>/updates">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="utitle">Headline</label>
            <input id="utitle" name="title" required placeholder="Design signed off"></div>
          <div class="field"><label for="ubody">Detail</label><textarea id="ubody" name="body" rows="3"></textarea></div>
          <div class="field"><label for="upct">Set progress to %</label>
            <input id="upct" name="progress_pct" type="number" min="0" max="100" placeholder="<%= project.progress_pct %>"></div>
          <label class="check"><input type="checkbox" name="email_customer" value="1" checked>
            <span>Email the customer</span></label>
          <label class="check"><input type="checkbox" name="is_internal" value="1">
            <span>Internal note<small>Not shown to the customer</small></span></label>
          <button class="btn" type="submit" style="width:100%;justify-content:center">Post it</button>
        </form>
      </details>

      <details class="panel act">
        <summary><h3>Send an invoice</h3><small>Into the conversation</small></summary>
        <p class="muted" style="font-size:.84rem;margin-bottom:.7rem">
          Raises it, emails it, and posts a payable card into the thread. Leave the picker
          on “new” to bill a single amount.
        </p>
        <form method="post" action="/portal/admin/projects/<%= project.id %>/send-invoice">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="invoice_id">Existing invoice</label>
            <select id="invoice_id" name="invoice_id">
              <option value="">Raise a new one</option>
              <% for (const i of invoices) { %>
                <option value="<%= i.id %>"><%= i.number %> — <%= money(i.total, i.currency) %> (<%= i.status %>)</option>
              <% } %>
            </select>
          </div>
          <div class="fields">
            <div class="field"><label for="amount">Amount (new)</label>
              <input id="amount" name="amount" type="number" step="0.01" placeholder="0.00"></div>
            <div class="field"><label for="due_days">Due in days</label>
              <input id="due_days" name="due_days" type="number" value="14"></div>
          </div>
          <div class="field"><label for="description">What it is for</label>
            <input id="description" name="description" placeholder="Stage two — build"></div>
          <div class="field"><label for="body">Message to send with it</label>
            <textarea name="body" id="body" rows="2" placeholder="Here is stage two, payable in the portal."></textarea></div>
          <button class="btn" type="submit" style="width:100%;justify-content:center">Raise, email and post it</button>
        </form>
      </details>

      <details class="panel act" <%= pendingTotal ? "open" : "" %>>
        <summary><h3>Charges</h3>
          <small><% if (pendingTotal) { %><%= moneyRound(pendingTotal, project.currency) %> uninvoiced<% } else { %>All invoiced<% } %></small>
        </summary>
        <ul class="tasks">
          <% for (const c of charges) { %>
            <li class="task">
              <div class="grow"><b><%= c.description %></b>
                <small><%= c.qty %> × <%= money(c.unit_price, c.currency) %> ·
                  <time datetime="<%= new Date(c.incurred_on).toISOString() %>"></time></small></div>
              <span class="strong-num"><%= money(c.amount, c.currency) %></span>
              <span class="pill <%= c.status === 'pending' ? 'warn' : c.status === 'invoiced' ? 'ok' : '' %>"><%= c.status %></span>
              <% if (c.status === "pending") { %>
                <form method="post" action="/portal/admin/charges/<%= c.id %>/void">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn danger small" type="submit">Void</button>
                </form>
              <% } %>
            </li>
          <% } %>
          <% if (!charges.length) { %><li class="t-empty">None logged.</li><% } %>
        </ul>
        <form method="post" action="/portal/admin/projects/<%= project.id %>/charges" style="margin-top:.7rem">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="cdesc">Add a charge</label>
            <input id="cdesc" name="description" required placeholder="Extra reporting screen"></div>
          <div class="fields">
            <div class="field"><label for="cqty">Qty</label><input id="cqty" name="qty" type="number" step="0.01" value="1"></div>
            <div class="field"><label for="cprice">Unit price</label>
              <input id="cprice" name="unit_price" type="number" step="0.01" required></div>
          </div>
          <button class="btn ghost" type="submit" style="width:100%;justify-content:center">Log the charge</button>
        </form>
        <% if (pendingTotal) { %>
          <form method="post" action="/portal/admin/customers/<%= customer.id %>/invoice-charges" style="margin-top:.6rem">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="send" value="1">
            <button class="btn" type="submit" style="width:100%;justify-content:center">Invoice all pending charges</button>
          </form>
        <% } %>
      </details>

      <details class="panel act">
        <summary><h3>On this project</h3><small><%= members.length %> people</small></summary>
        <ul class="tasks">
          <% for (const m of members) { %>
            <li class="task">
              <span class="avatar sm <%= m.side === 'vesopa' ? 'v' : '' %>"><%= initials(m.name) %></span>
              <div class="grow"><b><%= m.name %></b>
                <small><%= m.side === "vesopa" ? "Vesopa" : roleLabel(m.org_role) %><%= m.role_label ? " · " + m.role_label : "" %></small></div>
              <form method="post" action="/portal/admin/projects/<%= project.id %>/members/<%= m.user_id %>/remove">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn danger small" type="submit" aria-label="Remove <%= m.name %>">×</button>
              </form>
            </li>
          <% } %>
          <% if (!members.length) { %><li class="t-empty">Nobody assigned yet.</li><% } %>
        </ul>
        <form method="post" action="/portal/admin/projects/<%= project.id %>/members" style="margin-top:.7rem">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="user_id">Add someone</label>
            <select id="user_id" name="user_id">
              <optgroup label="Vesopa">
                <% for (const s of staff) { %><option value="<%= s.id %>"><%= s.name %></option><% } %>
              </optgroup>
              <% if (orgPeople.length) { %>
                <optgroup label="<%= customer.company || 'Customer' %>">
                  <% for (const p of orgPeople) { %><option value="<%= p.id %>"><%= p.name %> (<%= p.org_role %>)</option><% } %>
                </optgroup>
              <% } %>
            </select>
          </div>
          <div class="field"><label for="role_label">Their role here</label>
            <input id="role_label" name="role_label" placeholder="Lead developer"></div>
          <button class="btn ghost" type="submit" style="width:100%;justify-content:center">Add to project</button>
        </form>
      </details>

      <!-- ---------- money at a glance ---------- -->
      <% if (invoices.length || subs.length) { %>
        <section class="panel" aria-label="Billing">
          <div class="panel-head"><h3>Billing</h3><span class="spacer"></span>
            <a class="btn ghost small" href="/portal/admin/invoices">All invoices</a></div>
          <ul class="tasks">
            <% for (const i of invoices.slice(0,5)) { %>
              <li class="task">
                <div class="grow"><b><%= i.number %></b>
                  <small><%= money(i.total, i.currency) %> ·
                    <time datetime="<%= new Date(i.issue_date).toISOString() %>"></time></small></div>
                <span class="pill <%= i.status === 'paid' ? 'ok' : i.status === 'overdue' ? 'bad' : 'warn' %>"><%= i.status %></span>
                <a class="btn ghost small" href="/portal/admin/invoices/<%= i.id %>">Open</a>
              </li>
            <% } %>
            <% if (!invoices.length) { %><li class="t-empty">No invoices yet.</li><% } %>
          </ul>
          <% if (subs.length) { %>
            <div class="panel-head" style="margin-top:.9rem"><h3>Recurring</h3></div>
            <ul class="tasks">
              <% for (const s of subs) { %>
                <li class="task">
                  <div class="grow"><b><%= s.name %></b>
                    <small><%= s.interval_unit %> · next
                      <time datetime="<%= new Date(s.next_charge_date).toISOString() %>"></time></small></div>
                  <span class="strong-num"><%= money(s.amount, s.currency) %></span>
                </li>
              <% } %>
            </ul>
          <% } %>
        </section>
      <% } %>

      <!-- ---------- settings, last: changed rarely, read never ---------- -->
      <details class="panel act">
        <summary><h3>Project settings</h3><small>Status, dates, budget</small></summary>
        <form method="post" action="/portal/admin/projects/<%= project.id %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="title">Title</label><input id="title" name="title" value="<%= project.title %>"></div>
          <div class="fields">
            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status">
                <% for (const [k, v] of Object.entries(PROJECT_STATUS)) { %>
                  <option value="<%= k %>" <%= project.status === k ? "selected" : "" %>><%= v.label %></option>
                <% } %>
              </select>
            </div>
            <div class="field"><label for="progress_pct">Progress %</label>
              <input id="progress_pct" name="progress_pct" type="number" min="0" max="100" value="<%= project.progress_pct %>"></div>
            <div class="field"><label for="budget_amount">Budget</label>
              <input id="budget_amount" name="budget_amount" type="number" step="0.01" value="<%= project.budget_amount %>"></div>
          </div>
          <div class="fields">
            <div class="field"><label for="start_date">Start</label>
              <input id="start_date" name="start_date" type="date" value="<%= project.start_date || '' %>"></div>
            <div class="field"><label for="target_date">Target</label>
              <input id="target_date" name="target_date" type="date" value="<%= project.target_date || '' %>"></div>
          </div>
          <div class="field"><label for="description">Description</label>
            <textarea id="description" name="description" rows="3"><%= project.description || '' %></textarea></div>
          <button class="btn" type="submit" style="width:100%;justify-content:center">Save project</button>
        </form>
      </details>
    </aside>
  </div>
</div>

<%- include("../partials/foot") %>
