<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<div class="wrap">
  <div class="page-head">
    <div class="grow">
      <span class="eyebrow"><%= org ? org.name : (customer.company || "Customer") %></span>
      <h1><%= customer.name %></h1>
      <p><%= customer.email %><% if (customer.phone) { %> · <%= customer.phone %><% } %>
        · joined <time datetime="<%= new Date(customer.created_at).toISOString() %>"></time>
        <% if (customer.last_login_at) { %> · last seen <time datetime="<%= new Date(customer.last_login_at).toISOString() %>"></time><% } %>
      </p>
    </div>
    <div class="btn-row">
      <a class="btn ghost" href="/portal/admin/invoices/new?user_id=<%= customer.id %>">New invoice</a>
      <form method="post" action="/portal/admin/customers/<%= customer.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="<%= customer.status === 'active' ? 'suspended' : 'active' %>">
        <button class="btn <%= customer.status === 'active' ? 'danger' : 'ghost' %>" type="submit">
          <%= customer.status === "active" ? "Suspend" : "Reactivate" %>
        </button>
      </form>
    </div>
  </div>

  <div class="grid g4" style="margin-bottom:1rem">
    <div class="stat"><b><%= moneyRound(lifetime, currency) %></b><span>Lifetime paid</span></div>
    <div class="stat <%= outstanding ? 'warn' : '' %>"><b><%= moneyRound(outstanding, currency) %></b><span>Outstanding</span></div>
    <div class="stat plain"><b><%= projects.length %></b><span>Projects</span></div>
    <div class="stat plain"><b><%= charges.reduce((s,c)=>s+Number(c.amount||0),0).toFixed(0) %></b>
      <span>Pending charges (<%= currency %>)</span></div>
  </div>

  <div class="split">
    <div>
      <div class="panel">
        <h2>Projects</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Project</th><th>Status</th><th>Progress</th><th class="num">Budget</th></tr></thead>
          <tbody>
            <% if (!projects.length) { %><tr><td colspan="4" class="t-empty">None.</td></tr><% } %>
            <% for (const p of projects) { %>
              <tr><td><a href="/portal/admin/projects/<%= p.id %>"><%= p.title %></a>
                <div class="mono muted" style="font-size:.65rem"><%= p.ref %></div></td>
                <td><span class="pill info"><%= PROJECT_STATUS[p.status] ? PROJECT_STATUS[p.status].label : p.status %></span></td>
                <td style="min-width:7rem"><div class="bar"><i style="width:<%= p.progress_pct %>%"></i></div></td>
                <td class="num"><%= moneyRound(p.budget_amount, p.currency) %></td></tr>
            <% } %>
          </tbody>
        </table></div>
      </div>

      <div class="panel">
        <h2>Invoices</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Number</th><th>Issued</th><th>Status</th><th class="num">Total</th><th class="num">Outstanding</th></tr></thead>
          <tbody>
            <% if (!invoices.length) { %><tr><td colspan="5" class="t-empty">None.</td></tr><% } %>
            <% for (const i of invoices) { %>
              <tr><td><a href="/portal/admin/invoices/<%= i.id %>"><%= i.number %></a></td>
                <td><time datetime="<%= new Date(i.issue_date).toISOString() %>"></time></td>
                <td><span class="pill <%= i.status === 'paid' ? 'ok' : i.status === 'draft' ? '' : 'warn' %>"><%= STATUS_LABEL[i.status] || i.status %></span></td>
                <td class="num"><%= money(i.total, i.currency) %></td>
                <td class="num"><%= balanceOf(i) > 0 ? money(balanceOf(i), i.currency) : "—" %></td></tr>
            <% } %>
          </tbody>
        </table></div>
      </div>

      <div class="panel">
        <h2>Payments</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Invoice</th><th>When</th><th>How</th><th class="num">Amount</th></tr></thead>
          <tbody>
            <% if (!payments.length) { %><tr><td colspan="4" class="t-empty">None.</td></tr><% } %>
            <% for (const p of payments) { %>
              <tr><td><%= p.number %></td>
                <td><time datetime="<%= new Date(p.paid_at).toISOString() %>"></time></td>
                <td><%= p.method.replace("_"," ") %></td>
                <td class="num" style="color:var(--lime)"><%= money(p.amount, p.currency) %></td></tr>
            <% } %>
          </tbody>
        </table></div>
      </div>
    </div>

    <div>
      <% if (charges.length) { %>
        <div class="panel" style="border-left:3px solid var(--warn)">
          <h3>Pending charges</h3>
          <% for (const c of charges) { %>
            <div style="display:flex;gap:.5rem;padding:.4rem 0;border-bottom:1px solid var(--rule);font-size:.84rem">
              <span style="flex:1"><%= c.description %></span>
              <span class="strong-num"><%= money(c.amount, c.currency) %></span>
            </div>
          <% } %>
          <form method="post" action="/portal/admin/customers/<%= customer.id %>/invoice-charges" style="margin-top:.7rem">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="send" value="1">
            <button class="btn" type="submit" style="width:100%;justify-content:center">Invoice all of it</button>
          </form>
        </div>
      <% } %>

      <% if (subs.length) { %>
        <div class="panel">
          <h3>Recurring</h3>
          <% for (const s of subs) { %>
            <div style="padding:.45rem 0;border-bottom:1px solid var(--rule);font-size:.84rem">
              <div style="display:flex"><strong style="flex:1"><%= s.name %></strong>
                <span class="strong-num"><%= money(s.amount, s.currency) %></span></div>
              <div class="muted" style="font-size:.72rem"><%= s.interval_unit %> · next
                <time datetime="<%= new Date(s.next_charge_date).toISOString() %>"></time></div>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (org) { %>
        <div class="panel">
          <h3>Billing details</h3>
          <table style="font-size:.84rem">
            <tr><td class="muted">Company</td><td><%= org.name %></td></tr>
            <% if (org.vat_number) { %><tr><td class="muted">VAT</td><td class="mono"><%= org.vat_number %></td></tr><% } %>
            <% if (org.reg_number) { %><tr><td class="muted">Reg no.</td><td class="mono"><%= org.reg_number %></td></tr><% } %>
            <% if (org.billing_email) { %><tr><td class="muted">Invoices to</td><td><%= org.billing_email %></td></tr><% } %>
            <% if (org.address) { %><tr><td class="muted">Address</td><td><%= org.address %></td></tr><% } %>
          </table>
        </div>
      <% } %>

      <% if (colleagues.length) { %>
        <div class="panel">
          <h3>Their team</h3>
          <% for (const c of colleagues) { %>
            <div style="display:flex;gap:.5rem;padding:.4rem 0;border-bottom:1px solid var(--rule);font-size:.84rem">
              <div style="flex:1"><a href="/portal/admin/customers/<%= c.id %>"><%= c.name %></a>
                <div class="muted" style="font-size:.72rem"><%= c.email %></div></div>
              <span class="pill"><%= roleLabel(c.org_role) %></span>
            </div>
          <% } %>
        </div>
      <% } %>

      <div class="panel">
        <h3>Quotes</h3>
        <% if (!quotes.length) { %><p class="t-empty">None.</p><% } %>
        <% for (const qq of quotes) { %>
          <div style="display:flex;gap:.5rem;padding:.4rem 0;border-bottom:1px solid var(--rule);font-size:.84rem">
            <a href="/portal/admin/quotes/<%= qq.id %>" style="flex:1"><%= qq.ref %> — <%= qq.service_type %></a>
            <span class="pill"><%= qq.status %></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/foot") %>
