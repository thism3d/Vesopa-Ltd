<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<div class="wrap">
  <div class="page-head">
    <div class="grow"><span class="eyebrow">Everything anyone has asked us to price</span><h1>Quotes</h1></div>
    <div class="btn-row">
      <% for (const s of ["", "new", "reviewing", "quoted", "accepted", "declined"]) { %>
        <a class="btn <%= status === s ? '' : 'ghost' %> small" href="/portal/admin/quotes<%= s ? '?status=' + s : '' %>"><%= s ? QUOTE_STATUS[s].label : "All" %></a>
      <% } %>
    </div>
  </div>
  <div class="panel">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ref</th><th>Who</th><th>Work</th><th>Received</th><th>Status</th><th class="num">Estimate</th></tr></thead>
        <tbody>
          <% if (!quotes.length) { %><tr><td colspan="6" class="t-empty">Nothing here.</td></tr><% } %>
          <% for (const qq of quotes) { %>
            <tr>
              <td class="mono" style="font-size:.72rem"><a href="/portal/admin/quotes/<%= qq.id %>"><%= qq.ref %></a></td>
              <td><strong><%= qq.name %></strong>
                <div class="muted" style="font-size:.73rem"><%= qq.email %><% if (qq.company) { %> · <%= qq.company %><% } %></div></td>
              <td><%= serviceLabel(qq.service_type) %><div class="muted" style="font-size:.73rem"><%= tierLabel(qq.scope_tier) %> · <%= timelineLabel(qq.timeline) %></div></td>
              <td><time datetime="<%= new Date(qq.created_at).toISOString() %>"></time></td>
              <td><span class="pill <%= QUOTE_STATUS[qq.status] ? QUOTE_STATUS[qq.status].pill : '' %>"><%= QUOTE_STATUS[qq.status] ? QUOTE_STATUS[qq.status].label : qq.status %></span></td>
              <td class="num"><% if (qq.quoted_amount != null) { %><b><%= moneyRound(qq.quoted_amount, qq.currency) %></b><div class="muted" style="font-size:.7rem">quoted</div><% } else { %><%= moneyRound(qq.estimate_min, qq.currency) %> – <%= moneyRound(qq.estimate_max, qq.currency) %><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include("../partials/foot") %>
