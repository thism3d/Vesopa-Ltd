<%
/* The signed-in shell.
 *
 * This used to be one flat row of links — nine of them on the admin side —
 * which wrapped into a wall of text on a laptop and stacked into a nine-item
 * list above the content on a phone. Links are grouped now, and the whole
 * thing is a sidebar on a desk and an off-canvas drawer on anything narrower.
 *
 * Groups are the actual shape of the work: what we are building, what it
 * costs, and who is involved. */
const isAdmin = user && user.role === "admin";
const groups = isAdmin ? [
  [null,      [["/portal/admin", "Overview", "grid"]]],
  ["Work",    [["/portal/admin/projects", "Projects", "layers"],
               ["/portal/admin/quotes", "Quotes", "tag"],
               ["/portal/admin/enquiries", "Enquiries", "inbox"]]],
  ["Money",   [["/portal/admin/invoices", "Invoices", "receipt"],
               ["/portal/admin/subscriptions", "Recurring", "repeat"]]],
  ["People",  [["/portal/admin/customers", "Customers", "users"],
               ["/portal/admin/staff", "Staff", "badge"]]],
  ["System",  [["/portal/admin/mail", "Mail log", "mail"]]],
] : [
  [null,      [["/portal", "Overview", "grid"]]],
  ["Work",    [["/portal/projects", "Projects", "layers"],
               ["/portal/quotes", "Quotes", "tag"]]],
  ["Money",   [["/portal/invoices", "Billing", "receipt"]]],
  ["You",     [["/portal/team", "Team", "users"],
               ["/portal/account", "Account", "badge"]]],
];
const active = (href) =>
  (href === "/portal" || href === "/portal/admin") ? path === href : path.startsWith(href);
const ICON = {
  grid:   'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  layers: 'M12 2 2 7l10 5 10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  tag:    'M20.6 13.4 12 22l-9-9V3h10zM7.5 7.5h.01',
  inbox:  'M22 12h-6l-2 3h-4l-2-3H2M5.5 5h13l3.5 7v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z',
  receipt:'M4 2v20l3-2 3 2 3-2 3 2 3-2V2l-3 2-3-2-3 2-3-2zM8 8h8M8 12h8M8 16h5',
  repeat: 'M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3',
  users:  'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87',
  badge:  'M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8M20 21a8 8 0 1 0-16 0',
  mail:   'M4 4h16v16H4zM4 6l8 6 8-6',
};
%>
<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
  <button class="hamburger" id="nav-toggle" type="button"
          aria-label="Menu" aria-expanded="false" aria-controls="sidenav">
    <span></span><span></span><span></span>
  </button>

  <a class="brand" href="<%= isAdmin ? '/portal/admin' : '/portal' %>">
    <img src="/assets/logo.svg" alt="">
    <span>Vesopa <small><%= isAdmin ? "admin" : "portal" %></small></span>
  </a>

  <span class="spacer"></span>

  <span class="live" id="live" title="Live connection"><i></i><span class="lbl">connecting</span></span>

  <button class="btn ghost small" id="enable-notifications" hidden>Notifications</button>

  <div class="bell-wrap">
    <button class="bell" id="bell" aria-label="Notifications" title="Notifications">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      <% if (typeof unread !== "undefined" && unread > 0) { %><b><%= unread %></b><% } %>
    </button>
    <div class="drawer" id="drawer"></div>
  </div>

  <div class="clock" id="clock"></div>
</header>

<div class="shell">
  <!-- The sidebar and its scrim. On a desk this is simply a column; under
       1000px it slides in over the content and the scrim closes it. -->
  <div class="nav-scrim" id="nav-scrim" hidden></div>

  <nav class="sidenav" id="sidenav" aria-label="Portal">
    <% for (const [heading, links] of groups) { %>
      <% if (heading) { %><p class="nav-group"><%= heading %></p><% } %>
      <% for (const [href, label, icon] of links) { %>
        <a href="<%= href %>" class="<%= active(href) ? 'on' : '' %>"
           <%= active(href) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= ICON[icon] %>"/></svg>
          <span><%= label %></span>
        </a>
      <% } %>
    <% } %>

    <div class="nav-foot">
      <div class="nav-me">
        <span class="avatar" aria-hidden="true"><%= (user && user.name ? user.name : "?").slice(0,1).toUpperCase() %></span>
        <span class="nav-me-txt">
          <b><%= user && user.name ? user.name : "" %></b>
          <small><%= user && user.email ? user.email : "" %></small>
        </span>
      </div>
      <form method="post" action="/portal/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn ghost small" type="submit">Sign out</button>
      </form>
    </div>
  </nav>

  <!-- `content` is the column beside the sidebar; each view brings its own
       `.wrap` inside it for the max-width measure, which is why this does not
       open one here. -->
  <main class="content" id="main">
    <% if (typeof flash !== "undefined" && flash) { %>
      <div class="wrap" style="padding-bottom:0">
        <div class="notice <%= flash.kind === 'warn' ? 'warn' : flash.kind === 'bad' ? 'bad' : '' %>">
          <%= flash.message %>
        </div>
      </div>
    <% } %>
