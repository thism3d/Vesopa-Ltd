<%#
  Continue with Vesopa — the button every Vesopa product uses, worded to the
  letter (the owner's choice over "Login with Vesopa"), with the same white
  tile mark as cloud.vesopa.com (vesopa_hosting/views/partials/vesopa-button.ejs),
  so it reads the same on any background.

  Only drawn when Continue with Vesopa is configured (app.locals.vesopaSso);
  the caller checks. Options:
    href   where to start (default /portal/auth/vesopa/start)
    label  the words (default "Continue with Vesopa")
    rel    link rel (default "external"; the invite page passes "noreferrer"
           so the invitation link is not sent on to auth.vesopa.com)
%>
<%
  const vbHref = typeof href !== "undefined" && href ? href : "/portal/auth/vesopa/start";
  const vbLabel = typeof label !== "undefined" && label ? label : "Continue with Vesopa";
  const vbRel = typeof rel !== "undefined" && rel ? rel : "external";
%>
<a class="btn btn-vesopa" href="<%= vbHref %>" rel="<%= vbRel %>">
  <svg class="btn-vesopa-mark" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><rect width="20" height="20" rx="5" fill="#ffffff"/><g transform="translate(3 5) scale(0.14)"><path fill="#a5c715" d="M0,0 L22.7,0 L50.7,49 L77.3,0 L100,0 L62,70 L40,70 Z"/><path fill="#111111" d="M58.3,35 L81,35 L62,70 L40,70 L50.7,49 Z"/></g></svg>
  <span><%= vbLabel %></span>
</a>
