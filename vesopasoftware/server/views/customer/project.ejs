<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<% const isAdminView = false; const doneTasks = tasks.filter(t => t.status === "done").length; %>

<div class="wrap">
  <div class="page-head">
    <div class="grow">
      <span class="eyebrow"><%= project.ref %> · <%= project.service_type %></span>
      <h1><%= project.title %></h1>
      <p>
        <span class="pill <%= project.status === 'complete' ? 'ok' : project.status === 'on_hold' ? 'warn' : 'info' %>">
          <%= PROJECT_STATUS[project.status] ? PROJECT_STATUS[project.status].label : project.status %>
        </span>
        · started <time datetime="<%= new Date(project.created_at).toISOString() %>"></time>
        <% if (project.target_date) { %>
          · due <time datetime="<%= new Date(project.target_date).toISOString() %>"></time>
        <% } %>
      </p>
    </div>
    <div class="right">
      <div class="stat plain" style="padding:.7rem .9rem">
        <b><%= moneyRound(project.budget_amount, project.currency) %></b>
        <span>Agreed budget</span>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="progress-line">
      <div class="bar" data-progress="<%= project.id %>"><i style="width:<%= project.progress_pct %>%"></i></div>
      <b data-progress-label="<%= project.id %>"><%= project.progress_pct %>%</b>
    </div>
    <% if (project.description) { %>
      <p class="muted" style="margin-top:.8rem;font-size:.9rem;white-space:pre-wrap"><%= project.description %></p>
    <% } %>
  </div>

  <div class="split" style="margin-top:1rem">
    <div>
      <!-- conversation -->
      <div class="panel">
        <div class="panel-head">
          <h2>Conversation</h2>
          <span class="spacer"></span>
          <span class="live" id="live-thread"></span>
        </div>

        <div class="thread" id="thread" data-project="<%= project.id %>">
          <% for (const m of messages) { %>
            <% const mine = m.user_id === user.id; %>
            <div class="msg <%= mine ? 'mine' : '' %> <%= m.author_role === 'admin' ? 'vesopa' : '' %> <%= m.recipient_id ? 'private' : '' %>"
                 data-msg="<%= m.id %>">
              <div class="who"><%= (m.author || "?").split(" ").map(w => w[0]).slice(0,2).join("").toUpperCase() %></div>
              <div class="bubble">
                <div class="meta">
                  <b><%= m.author || "Someone" %></b>
                  <% if (m.author_role === "admin") { %><span class="pill lime">Vesopa</span><% } %>
                  <% if (m.recipient_id) { %><span class="pill warn">Private</span><% } %>
                  <time datetime="<%= new Date(m.created_at).toISOString() %>"></time>
                </div>
                <div class="body"><%= m.body %></div>
                <% if (m.invoice_id && m.invoice_number) { %>
                  <div class="inv-card">
                    <div>
                      <div class="mono muted" style="font-size:.62rem">INVOICE <%= m.invoice_number %></div>
                      <b><%= money(m.invoice_total, m.invoice_currency) %></b>
                    </div>
                    <span class="spacer"></span>
                    <span class="pill <%= m.invoice_status === 'paid' ? 'ok' : 'warn' %>">
                      <%= STATUS_LABEL[m.invoice_status] || m.invoice_status %>
                    </span>
                    <a class="btn small" href="/portal/invoices/<%= m.invoice_id %>">
                      <%= m.invoice_status === "paid" ? "View" : "View and pay" %>
                    </a>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <div class="typing" id="typing"></div>

        <% if (can("message.send")) { %>
          <form class="composer" id="composer" method="post" action="/portal/projects/<%= project.id %>/messages">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <textarea name="body" placeholder="Write to the team… (Enter sends, Shift+Enter for a new line)" required></textarea>
            <div class="row">
              <select name="recipient_id" style="max-width:16rem">
                <option value="">Everyone on this project</option>
                <% for (const mem of members) { if (mem.user_id === user.id) continue; %>
                  <option value="<%= mem.user_id %>">
                    Private to <%= mem.name %><%= mem.role === "admin" ? " (Vesopa)" : "" %>
                  </option>
                <% } %>
              </select>
              <span class="spacer" style="flex:1"></span>
              <button class="btn" type="submit">Send</button>
            </div>
          </form>
        <% } %>
      </div>

      <!-- files -->
      <div class="panel">
        <div class="panel-head">
          <h2>Files</h2>
          <span class="spacer"></span>
          <span class="pill"><%= files.length %></span>
        </div>

        <% if (files.length) { %>
          <div class="files" style="margin-bottom:1rem">
            <% for (const f of files) { %>
              <div class="file">
                <a class="thumb" href="/portal/files/<%= f.id %>" data-preview
                   data-id="<%= f.id %>" data-mime="<%= f.mime || '' %>" data-name="<%= f.original_name %>">
                  <% if ((f.mime || "").startsWith("image/")) { %>
                    <img src="/portal/files/<%= f.id %>" alt="<%= f.original_name %>" loading="lazy">
                  <% } else if (f.mime === "application/pdf") { %>
                    PDF
                  <% } else if (/zip/i.test(f.mime || "") || /\.zip$/i.test(f.original_name)) { %>
                    ZIP
                  <% } else { %>
                    FILE
                  <% } %>
                </a>
                <div class="meta">
                  <b title="<%= f.original_name %>"><%= f.original_name %></b>
                  <small>
                    <%= (f.size_bytes/1024).toFixed(0) %> KB ·
                    <time datetime="<%= new Date(f.created_at).toISOString() %>"></time>
                  </small>
                  <small class="muted"><%= f.uploader || "—" %><%= f.side === "vesopa" ? " · Vesopa" : "" %></small>
                  <% if (f.user_id === user.id) { %>
                    <form method="post" action="/portal/files/<%= f.id %>/delete" style="margin-top:.3rem">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn danger small" type="submit">Remove</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>

        <% if (can("message.send")) { %>
          <form method="post" action="/portal/projects/<%= project.id %>/files" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="file" name="files" multiple class="sr">
            <div class="dropzone" id="dropzone">
              Drop files here, or click to choose. Images, PDFs, documents, zips and video, up to 25 MB each.
            </div>
          </form>
        <% } %>
      </div>
    </div>

    <div>
      <!-- tasks -->
      <div class="panel">
        <div class="panel-head">
          <h3>Tasks</h3>
          <span class="spacer"></span>
          <span class="pill" data-task-progress-label><%= doneTasks %>/<%= tasks.length %></span>
        </div>
        <div class="bar thin" data-task-progress style="margin-bottom:.7rem">
          <i style="width:<%= tasks.length ? Math.round(doneTasks / tasks.length * 100) : 0 %>%"></i>
        </div>
        <% if (!tasks.length) { %>
          <p class="t-empty">No tasks yet.</p>
        <% } else { %>
          <ul class="tasks">
            <% for (const t of tasks) { %>
              <li class="task <%= t.status === 'done' ? 'done' : '' %>">
                <input type="checkbox" data-task="<%= t.id %>"
                       data-url="/portal/projects/<%= project.id %>/tasks/<%= t.id %>/status"
                       <%= t.status === "done" ? "checked" : "" %>
                       <%= can("message.send") ? "" : "disabled" %>>
                <div class="grow">
                  <b><%= t.title %></b>
                  <small>
                    <span class="pill <%= t.status === 'doing' ? 'info' : t.status === 'blocked' ? 'bad' : '' %>"><%= t.status %></span>
                    <% if (t.assignee) { %> · <%= t.assignee %><% } %>
                    <% if (t.due_date) { %> · due <time datetime="<%= new Date(t.due_date).toISOString() %>"></time><% } %>
                  </small>
                </div>
              </li>
            <% } %>
          </ul>
        <% } %>
      </div>

      <!-- who is on it -->
      <div class="panel">
        <h3>Who is on this</h3>
        <% if (!members.length) { %>
          <p class="t-empty">Nobody assigned yet.</p>
        <% } else { %>
          <% for (const m of members) { %>
            <div style="display:flex;gap:.6rem;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--rule)">
              <div class="who" style="width:2rem;height:2rem;border-radius:50%;background:var(--panel-2);
                   border:1px solid var(--rule-strong);display:grid;place-items:center;font-size:.62rem"
                   class="mono">
                <%= m.name.split(" ").map(w => w[0]).slice(0,2).join("").toUpperCase() %>
              </div>
              <div style="flex:1;min-width:0">
                <b style="font-size:.88rem;font-weight:600"><%= m.name %></b>
                <div class="muted" style="font-size:.72rem">
                  <%= m.role_label || m.job_title || (m.role === "admin" ? "Vesopa" : roleLabel(m.org_role)) %>
                </div>
              </div>
              <% if (m.side === "vesopa") { %><span class="pill lime">Vesopa</span><% } %>
            </div>
          <% } %>
          <p class="hint">Use the dropdown under the message box to write to one of them privately.</p>
        <% } %>
      </div>

      <!-- money on this project -->
      <% if (can("billing.view")) { %>
        <div class="panel">
          <h3>Money on this project</h3>
          <% if (charges.length) { %>
            <div class="mono muted" style="font-size:.62rem;margin-bottom:.4rem">PENDING CHARGES</div>
            <% for (const c of charges) { %>
              <div style="display:flex;gap:.5rem;font-size:.83rem;padding:.35rem 0;border-bottom:1px solid var(--rule)">
                <span style="flex:1"><%= c.description %></span>
                <span class="strong-num"><%= money(c.amount, c.currency) %></span>
              </div>
            <% } %>
          <% } %>
          <% if (invoices.length) { %>
            <div class="mono muted" style="font-size:.62rem;margin:.9rem 0 .4rem">INVOICES</div>
            <% for (const i of invoices) { %>
              <div style="display:flex;gap:.5rem;align-items:center;font-size:.83rem;padding:.35rem 0;border-bottom:1px solid var(--rule)">
                <a href="/portal/invoices/<%= i.id %>" style="flex:1;text-decoration:none"><%= i.number %></a>
                <span class="pill <%= i.status === 'paid' ? 'ok' : isOverdue(i) ? 'bad' : 'warn' %>">
                  <%= STATUS_LABEL[i.status] || i.status %>
                </span>
                <span class="strong-num"><%= money(i.total, i.currency) %></span>
              </div>
            <% } %>
          <% } %>
          <% if (!charges.length && !invoices.length) { %>
            <p class="t-empty">Nothing billed yet.</p>
          <% } %>
        </div>
      <% } %>

      <!-- timeline -->
      <div class="panel">
        <h3>Timeline</h3>
        <% if (!updates.length) { %>
          <p class="t-empty">Nothing posted yet.</p>
        <% } else { %>
          <ul class="timeline">
            <% updates.forEach((u, idx) => { %>
              <li class="<%= idx ? 'muted' : '' %>">
                <h4><%= u.title %></h4>
                <% if (u.body) { %><p><%= u.body %></p><% } %>
                <time datetime="<%= new Date(u.created_at).toISOString() %>"></time>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/foot") %>
