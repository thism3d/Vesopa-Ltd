<%- include("../partials/head") %>
<div class="auth">
  <div class="auth-card">
    <a class="brand" href="/"><img src="/assets/logo.svg" alt="">Vesopa <small>portal</small></a>
    <h1>Sign in</h1>
    <p>Your projects, their progress and every invoice, in one place.</p>
    <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
    <form method="post" action="/portal/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required
               value="<%= email %>" autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn" type="submit">Sign in</button>
    </form>
    <div class="auth-alt">
      <a href="/portal/forgot">Forgotten your password?</a>
      <a href="/portal/register">Create an account</a>
    </div>
  </div>
</div>
<%- include("../partials/foot") %>
