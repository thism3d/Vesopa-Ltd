<%- include("../partials/head") %>
<div class="auth">
  <div class="auth-card">
    <a class="brand" href="/"><img src="/assets/logo.svg" alt="">Vesopa <small>portal</small></a>
    <% const firstTime = typeof first !== "undefined" && first; %>
    <h1><%= firstTime ? "Set your password" : "Set a new password" %></h1>
    <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
    <% if (token) { %>
      <% if (firstTime) { %>
        <p>Your portal account<%= typeof email !== "undefined" && email ? " for " + email : "" %> is ready.
           Choose a password of at least eight characters, then sign in with it.</p>
      <% } else { %>
        <p>Choose something you will remember. Every other session will be signed out.</p>
      <% } %>
      <form method="post" action="/portal/reset/<%= token %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" autofocus>
        </div>
        <div class="field">
          <label for="password2">Repeat it</label>
          <input id="password2" name="password2" type="password" required minlength="8" autocomplete="new-password">
        </div>
        <button class="btn" type="submit">Save it</button>
      </form>
      <% if (firstTime && typeof vesopaSso !== "undefined" && vesopaSso) { %>
        <div class="auth-or"><span>or skip the password</span></div>
        <%- include("../partials/vesopa-button", { href: "/portal/auth/vesopa/start" + (typeof email !== "undefined" && email ? "?hint=" + encodeURIComponent(email) : "") }) %>
        <p class="hint vesopa-hint">Sign in with a Vesopa account for <%= typeof email !== "undefined" && email ? email : "this same address" %> instead. No account yet? You can make one there with an emailed code.</p>
      <% } %>
    <% } else { %>
      <p><a class="btn" href="/portal/forgot">Ask for a new link</a></p>
    <% } %>
  </div>
</div>
<%- include("../partials/foot-auth") %>
