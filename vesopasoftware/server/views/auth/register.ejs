<%- include("../partials/head") %>
<div class="auth">
  <div class="auth-card">
    <a class="brand" href="/"><img src="/assets/logo.svg" alt="">Vesopa <small>portal</small></a>
    <h1>Create an account</h1>
    <p>Track a build, talk to the people doing it, and settle invoices without an email chain.</p>
    <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
    <form method="post" action="/portal/register">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" required value="<%= form.name %>" autocomplete="name">
      </div>
      <div class="fields">
        <div class="field">
          <label for="company">Company <span class="muted">(optional)</span></label>
          <input id="company" name="company" value="<%= form.company %>" autocomplete="organization">
        </div>
        <div class="field">
          <label for="phone">Phone <span class="muted">(optional)</span></label>
          <input id="phone" name="phone" type="tel" value="<%= form.phone %>" autocomplete="tel">
        </div>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required value="<%= form.email %>" autocomplete="username">
      </div>
      <div class="fields">
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="new-password" minlength="8">
        </div>
        <div class="field">
          <label for="password2">Repeat it</label>
          <input id="password2" name="password2" type="password" required autocomplete="new-password" minlength="8">
        </div>
      </div>
      <p class="hint">At least 8 characters. A phrase you will remember beats a word with symbols in it.</p>
      <button class="btn" type="submit">Create account</button>
    </form>
    <div class="auth-alt">
      <span>Already have one?</span>
      <a href="/portal/login">Sign in</a>
    </div>
  </div>
</div>
<%- include("../partials/foot") %>
