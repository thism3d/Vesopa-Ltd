# vesopasoftware.com — portal configuration.
# Copy to .env and edit. .env is gitignored; this file is the documented shape.

PORT=5090
NODE_ENV=development
# Public origin, used in emails and payment return URLs.
BASE_URL=http://localhost:5090

# ---- database (MAMP's bundled MySQL 5.7) ----
# MAMP runs mysqld on 3306 with socket /tmp/mamp3306.sock and root/root by
# default. If MAMP's "Ports" pane is set to the alternate preset this becomes
# 8889 — check Preferences → Ports before assuming a connection failure is code.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=vesopa_portal
# Optional: connect over the MAMP socket instead of TCP.
# DB_SOCKET=/tmp/mamp3306.sock

# ---- sessions ----
# Any long random string. Changing it logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string-before-production
# 14 days.
SESSION_TTL_DAYS=14

# ---- mail ----
# mock  = nothing leaves the machine; every message is written to email_log
#         and printed to the console. Safe default.
# smtp  = real delivery through the credentials below.
MAIL_MODE=mock
MAIL_FROM="Vesopa Software <info@vesopasoftware.com>"
MAIL_ADMIN=info@vesopasoftware.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- payments ----
# mock = the pay button settles the invoice immediately, so the earnings
#        figures are exercisable before a real gateway exists.
# off  = no self-service payment; invoices are settled by an admin only.
PAYMENT_MODE=mock
CURRENCY=GBP
TAX_RATE=0

# ---- Vesopa AI (DeepSeek, Gemini as backup) ----
# Server-side only. The marketing page talks to /api/ai, which holds the keys.
# Leave both empty and the dock simply does not mount. DEEPSEEK_API_KEY is the
# "VesopaSoftware" key in the DeepSeek console. Every call is logged (counts and
# cost, never the words) to logs/ai-usage-YYYY-MM-DD.jsonl, and spending stops
# for the day at AI_DAILY_CAP_USD.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
AI_DAILY_CAP_USD=1

# Continue with Vesopa — sign in to the client area through auth.vesopa.com.
# Off (no button, /portal/auth/vesopa/* is a 404) until BOTH the id and the
# secret are set. The client is registered by
# vesopa_auth/schema/schema_026_vesopasoftware_portal_client.sql, and
# tool/deploy_client_area_vesopa_connect.py mints the secret and writes these
# on the live box. The redirect URI must match the registered one exactly;
# it defaults to BASE_URL + /portal/auth/vesopa/callback.
VESOPA_AUTH_CLIENT_ID=
VESOPA_AUTH_CLIENT_SECRET=
VESOPA_AUTH_ISSUER=https://auth.vesopa.com
# VESOPA_AUTH_REDIRECT_URI=https://vesopasoftware.com/portal/auth/vesopa/callback
